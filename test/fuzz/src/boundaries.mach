# every untrusted-input entry point the lane answers, by corpus directory name

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use fuzz.account;
use fuzz.certificate;
use fuzz.document;
use fuzz.order;
use fuzz.protocol;
use fuzz.renewal;
use fuzz.verdict;

pub def AnswerFn: fun(*u8, usize) verdict.Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val CAPACITY: usize = 32;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= CAPACITY) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun all(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "json", document.answer);
    i = put(out, i, "url", document.answer_url);
    i = put(out, i, "directory", protocol.answer_directory);
    i = put(out, i, "problem", protocol.answer_problem);
    i = put(out, i, "replay-nonce", protocol.answer_replay_nonce);
    i = put(out, i, "account", account.answer);
    i = put(out, i, "order", order.answer);
    i = put(out, i, "authorization", order.answer_authorization);
    i = put(out, i, "chain", certificate.answer_chain);
    i = put(out, i, "certificate", certificate.answer);
    i = put(out, i, "alternates", certificate.answer_alternates);
    i = put(out, i, "renewal-info", renewal.answer);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}
