# live acme conformance suite
#
# these tests drive a real acme authority. `test/live/harness/start.sh` runs
# pebble, its challenge test server, and a plain-http front end on loopback.
# tls termination belongs to mach-tls, so the harness terminates it and this
# suite speaks http/1.1 over a blocking socket. every acme byte, url, status,
# and header still comes from and returns to the real server.

use std.runtime;
use http.core.field;
use http.core.method;
use http.core.status;
use R: std.types.result;
use std.net.ip;
use std.net.tcp;
use IO: std.io.error;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.client;
use acme.problem;

val ACME_PORT:      u16 = 14001;
val MAX_BODY_BYTES: usize = 262144;
val MAX_FIELDS:     usize = 64;

fun length(text: *u8) usize {
    var i: usize = 0;
    for (text[i] != 0) { i = i + 1; }
    ret i;
}

fun copy(destination: *u8, source: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        destination[i] = source[i];
        i = i + 1;
    }
}

# a bounded response buffer plus the parsed status line and fields
pub rec Exchange {
    status:  u16;
    body:    view.View;
    fields:  field.Fields;
    items:   [64]field.Field;
    storage: [262144]u8;
    len:     usize;
}

rec Writer {
    data: *u8;
    cap:  usize;
    pos:  usize;
}

fun put(writer: *Writer, data: *u8, len: usize) bool {
    if (len > writer.cap - writer.pos) { ret false; }
    copy(?writer.data[writer.pos], data, len);
    writer.pos = writer.pos + len;
    ret true;
}

fun put_text(writer: *Writer, text: *u8) bool {
    ret put(writer, text, length(text));
}

fun put_number(writer: *Writer, value: usize) bool {
    var digits: [24]u8;
    var count: usize = 0;
    var remaining: usize = value;
    if (remaining == 0) {
        digits[0] = '0';
        count = 1;
    }
    for (remaining != 0) {
        digits[count] = ('0'::usize + remaining % 10)::u8;
        remaining = remaining / 10;
        count = count + 1;
    }
    var i: usize = 0;
    for (i < count) {
        if (!put(writer, ?digits[count - 1 - i], 1)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the authority's urls are https and name the harness front end, so the
# request line carries the exact path and the Host header the server echoes
fun split_url(url: view.View, host: *view.View, path: *view.View) bool {
    if (url.len < 9) { ret false; }
    var i: usize = 8;
    for (i < url.len && url.data[i] != '/') { i = i + 1; }
    @host = view.view(?url.data[8], i - 8);
    if (i == url.len) {
        @path = view.view("/", 1);
        ret true;
    }
    @path = view.view(?url.data[i], url.len - i);
    ret host.len != 0;
}

fun method_name(value: method.Method) *u8 {
    if (value.kind == method.GET) { ret "GET"; }
    if (value.kind == method.HEAD) { ret "HEAD"; }
    if (value.kind == method.POST) { ret "POST"; }
    ret nil;
}

fun digit_value(value: u8) bool { ret value >= '0' && value <= '9'; }

fun parse_status(data: *u8, len: usize, output: *u16) usize {
    if (len < 12 || data[0] != 'H' || data[1] != 'T' || data[2] != 'T' ||
        data[3] != 'P' || data[4] != '/') { ret 0; }
    var i: usize = 5;
    for (i < len && data[i] != ' ') { i = i + 1; }
    if (i + 4 > len) { ret 0; }
    i = i + 1;
    if (!digit_value(data[i]) || !digit_value(data[i + 1]) ||
        !digit_value(data[i + 2])) { ret 0; }
    @output = ((data[i] - '0')::u16) * 100 + ((data[i + 1] - '0')::u16) * 10 +
        (data[i + 2] - '0')::u16;
    var j: usize = i;
    for (j + 1 < len && !(data[j] == '\r' && data[j + 1] == '\n')) {
        j = j + 1;
    }
    if (j + 1 >= len) { ret 0; }
    ret j + 2;
}

fun trim(data: *u8, start: usize, finish: usize, output: *view.View) {
    var first: usize = start;
    var last: usize = finish;
    for (first < last && (data[first] == ' ' || data[first] == '\t')) {
        first = first + 1;
    }
    for (last > first && (data[last - 1] == ' ' || data[last - 1] == '\t')) {
        last = last - 1;
    }
    @output = view.view(?data[first], last - first);
}

fun parse_number(value: view.View) usize {
    var total: usize = 0;
    var i: usize = 0;
    for (i < value.len) {
        if (!digit_value(value.data[i])) { ret 0; }
        total = total * 10 + (value.data[i] - '0')::usize;
        i = i + 1;
    }
    ret total;
}

fun name_is(value: view.View, expected: *u8) bool {
    ret field.name_equal(value, view.view(expected, length(expected)));
}

# parses the header block into the exchange's own field storage and returns
# the offset of the body plus its declared length
fun parse_headers(exchange: *Exchange, start: usize, body_at: *usize,
    body_len: *usize, chunked: *bool) bool {
    var i: usize = start;
    var declared: usize = 0;
    var has_length: bool = false;
    @chunked = false;
    exchange.fields = field.init(?exchange.items[0], MAX_FIELDS,
        field.limits(MAX_FIELDS, 65536, 256, 8192));
    for (true) {
        if (i + 1 >= exchange.len) { ret false; }
        if (exchange.storage[i] == '\r' && exchange.storage[i + 1] == '\n') {
            @body_at = i + 2;
            if (@chunked) { ret true; }
            if (!has_length) { @body_len = 0; ret true; }
            @body_len = declared;
            ret true;
        }
        var colon: usize = i;
        for (colon < exchange.len && exchange.storage[colon] != ':' &&
            exchange.storage[colon] != '\r') { colon = colon + 1; }
        if (colon >= exchange.len || exchange.storage[colon] != ':') {
            ret false;
        }
        var finish: usize = colon;
        for (finish + 1 < exchange.len &&
            !(exchange.storage[finish] == '\r' &&
                exchange.storage[finish + 1] == '\n')) {
            finish = finish + 1;
        }
        if (finish + 1 >= exchange.len) { ret false; }
        if (exchange.fields.len >= MAX_FIELDS) { ret false; }
        var name: view.View;
        var value: view.View;
        trim(?exchange.storage[0], i, colon, ?name);
        trim(?exchange.storage[0], colon + 1, finish, ?value);
        exchange.items[exchange.fields.len] = field.Field{name: name,
            value: value, sensitive: false};
        exchange.fields.len = exchange.fields.len + 1;
        exchange.fields.bytes = exchange.fields.bytes + name.len + value.len;
        if (name_is(name, "content-length")) {
            declared = parse_number(value);
            has_length = true;
        }
        if (name_is(name, "transfer-encoding")) { @chunked = true; }
        i = finish + 2;
    }
    ret false;
}

fun hex_value(value: u8, output: *usize) bool {
    if (value >= '0' && value <= '9') { @output = (value - '0')::usize; ret true; }
    if (value >= 'a' && value <= 'f') {
        @output = (value - 'a')::usize + 10;
        ret true;
    }
    if (value >= 'A' && value <= 'F') {
        @output = (value - 'A')::usize + 10;
        ret true;
    }
    ret false;
}

# rewrites a chunked body in place so the exchange exposes one contiguous view
fun dechunk(exchange: *Exchange, body_at: usize, output: *usize) bool {
    var read: usize = body_at;
    var write: usize = body_at;
    for (true) {
        var size: usize = 0;
        var digits: usize = 0;
        var terminated: bool = false;
        for (read < exchange.len && !terminated) {
            var value: usize = 0;
            if (!hex_value(exchange.storage[read], ?value)) { ret false; }
            size = size * 16 + value;
            digits = digits + 1;
            read = read + 1;
            if (read + 1 < exchange.len && exchange.storage[read] == '\r' &&
                exchange.storage[read + 1] == '\n') { terminated = true; }
        }
        if (!terminated || digits == 0) { ret false; }
        read = read + 2;
        if (size == 0) {
            @output = write - body_at;
            ret true;
        }
        if (read + size + 2 > exchange.len) { ret false; }
        var i: usize = 0;
        for (i < size) {
            exchange.storage[write + i] = exchange.storage[read + i];
            i = i + 1;
        }
        write = write + size;
        read = read + size + 2;
    }
    ret false;
}

fun send_all(stream: *tcp.Stream, data: *u8, len: usize) bool {
    var sent: usize = 0;
    for (sent < len) {
        val written: R.Result[usize, IO.Error] = tcp.stream_write(stream,
            ?data[sent], len - sent);
        if (R.is_err[usize, IO.Error](written)) { ret false; }
        val count: usize = R.unwrap_ok[usize, IO.Error](written);
        if (count == 0) { ret false; }
        sent = sent + count;
    }
    ret true;
}

# executes one wire request against the harness and fills the exchange. the
# connection is not reused, so each acme request is independent.
pub fun execute(request: client.WireRequest, exchange: *Exchange) bool {
    if (problem.failed(request.error)) { ret false; }
    var host: view.View;
    var path: view.View;
    if (!split_url(request.url, ?host, ?path)) { ret false; }
    val name: *u8 = method_name(request.method);
    if (name == nil) { ret false; }
    var head: [8192]u8;
    var writer: Writer = Writer{data: ?head[0], cap: 8192, pos: 0};
    if (!put_text(?writer, name) || !put_text(?writer, " ") ||
        !put(?writer, path.data, path.len) ||
        !put_text(?writer, " HTTP/1.1\r\nHost: ") ||
        !put(?writer, host.data, host.len) ||
        !put_text(?writer,
            "\r\nUser-Agent: mach-acme-live/0.1\r\nConnection: close\r\n")) {
        ret false;
    }
    if (request.content_type.len != 0 &&
        (!put_text(?writer, "Content-Type: ") ||
        !put(?writer, request.content_type.data, request.content_type.len) ||
        !put_text(?writer, "\r\n"))) { ret false; }
    if (request.method.kind == method.POST &&
        (!put_text(?writer, "Content-Length: ") ||
        !put_number(?writer, request.body.len) ||
        !put_text(?writer, "\r\n"))) { ret false; }
    if (!put_text(?writer, "\r\n")) { ret false; }

    val connected: R.Result[tcp.Stream, IO.Error] = tcp.connect(
        ip.endpoint(127, 0, 0, 1, ACME_PORT));
    if (R.is_err[tcp.Stream, IO.Error](connected)) { ret false; }
    var stream: tcp.Stream = R.unwrap_ok[tcp.Stream, IO.Error](connected);
    tcp.stream_set_read_timeout(?stream, 30000);
    var ok: bool = send_all(?stream, ?head[0], writer.pos);
    if (ok && request.body.len != 0) {
        ok = send_all(?stream, request.body.data, request.body.len);
    }
    exchange.len = 0;
    for (ok) {
        val received: R.Result[usize, IO.Error] = tcp.stream_read(?stream,
            ?exchange.storage[exchange.len], MAX_BODY_BYTES - exchange.len);
        if (R.is_err[usize, IO.Error](received)) { ok = false; }
        or {
            val count: usize = R.unwrap_ok[usize, IO.Error](received);
            if (count == 0) { brk; }
            exchange.len = exchange.len + count;
            if (exchange.len == MAX_BODY_BYTES) { ok = false; }
        }
    }
    tcp.stream_close(?stream);
    if (!ok) { ret false; }
    val header_at: usize = parse_status(?exchange.storage[0], exchange.len,
        ?exchange.status);
    if (header_at == 0) { ret false; }
    var body_at: usize = 0;
    var body_len: usize = 0;
    var chunked: bool = false;
    if (!parse_headers(exchange, header_at, ?body_at, ?body_len, ?chunked)) {
        ret false;
    }
    if (chunked) {
        if (!dechunk(exchange, body_at, ?body_len)) { ret false; }
    } or {
        if (body_at + body_len > exchange.len) { ret false; }
    }
    exchange.body = view.view(nil, 0);
    if (body_len != 0) {
        exchange.body = view.view(?exchange.storage[body_at], body_len);
    }
    exchange.fields.valid = true;
    ret true;
}

fun retry_after(exchange: *Exchange) u64 {
    var i: usize = 0;
    for (i < exchange.fields.len) {
        if (name_is(exchange.items[i].name, "retry-after")) {
            ret parse_number(exchange.items[i].value)::u64;
        }
        i = i + 1;
    }
    ret 0;
}

pub fun response(exchange: *Exchange) client.Response {
    ret client.Response{status: exchange.status, fields: ?exchange.fields,
        body: exchange.body, retry_after_seconds: retry_after(exchange)};
}

test "live: the harness reaches a real acme directory over http/1.1" {
    var exchange: Exchange;
    val configured: client.Limits = client.limits_default();
    val discovery: client.WireRequest = client.discovery_request(
        view.view("https://127.0.0.1:14001/dir", 27), configured);
    if (problem.failed(discovery.error)) { ret 1; }
    if (!execute(discovery, ?exchange)) { ret 2; }
    if (exchange.status != status.OK || exchange.body.len == 0) { ret 3; }
    var scratch: [65536]u8;
    var text: [16384]u8;
    var caa: [8]view.View;
    var directory: client.Directory;
    val parsed: problem.Error = client.parse_directory(response(?exchange),
        configured, ?scratch[0], 65536,
        client.DirectoryStorage{data: ?text[0], capacity: 16384,
            caa_items: ?caa[0], caa_capacity: 8}, ?directory);
    if (problem.failed(parsed)) { ret 4; }
    if (directory.new_nonce_url.len == 0 ||
        directory.new_account_url.len == 0 ||
        directory.new_order_url.len == 0) { ret 5; }
    ret 0;
}
