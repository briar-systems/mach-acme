fun fixed_ok(outcome: err[A.Error]) bool {
    ret sel outcome.ok;
}

fun fs_ok(outcome: err[fs.FsError]) bool {
    ret sel outcome.ok;
}

fun file_exists(path: str) bool {
    val present: res[bool, IO.Error] = fs.exists(path);
    ret (sel present.ok) && present.ok;
}

fun equal(first: *u8, second: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (first[i] != second[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun filled(data: *u8, value: u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (data[i] != value) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun fill(data: *u8, value: u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        data[i] = value;
        i       = i + 1;
    }
}

fun copy(data: *u8, source: *u8, len: usize) {
    var i: usize = 0;
    for (i < len) {
        data[i] = source[i];
        i       = i + 1;
    }
}

fun length(text: *u8) usize {
    var len: usize = 0;
    for (text[len] != 0) { len = len + 1; }
    ret len;
}

fun deterministic_entropy(ctx: ptr, output: contracts.SecretBuffer) contracts.Error {
    if (output.data == nil || output.capacity < 32) { ret contracts.INVALID_INPUT; }
    var i: usize = 0;
    for (i < 32) {
        output.data[i] = i::u8;
        i              = i + 1;
    }
    ret contracts.OK;
}

rec ForeignEntropy {
    target: *u8;
}

fun foreign_entropy(ctx: ptr,
    output: contracts.SecretBuffer) contracts.Error {
    val value: *ForeignEntropy = ctx::*ForeignEntropy;
    if (output.data == nil || output.capacity < 32 || value.target == nil) {
        ret contracts.INVALID_INPUT;
    }
    var i: usize = 0;
    for (i < 32) {
        output.data[i] = i::u8;
        i              = i + 1;
    }
    value.target[0] = value.target[0] ^ 1;
    ret contracts.OK;
}

fun unavailable_entropy(ctx: ptr, output: contracts.SecretBuffer) contracts.Error {
    ret contracts.ENTROPY_UNAVAILABLE;
}

fun entropy_aliases_nothing(ctx: ptr, data: *u8, len: usize) bool {
    ret false;
}

fun entropy_mutates_foreign(ctx: ptr, data: *u8, len: usize) bool {
    val value: *ForeignEntropy = ctx::*ForeignEntropy;
    if (value.target != nil) {
        value.target[0] = value.target[0] ^ 1;
        value.target    = nil;
    }
    ret false;
}

fun entropy_aliases_no_secret(ctx: ptr, data: *^u8, len: usize) bool {
    ret false;
}

fun entropy_still_valid(ctx: ptr) bool {
    ret true;
}

fun entropy_invalid_after(ctx: ptr) bool {
    ret false;
}

rec SecretAliasProbe {
    private_queried: bool;
}

fun entropy_aliases_private(ctx: ptr, data: *^u8, len: usize) bool {
    val probe: *SecretAliasProbe = ctx::*SecretAliasProbe;
    if (len == 256) {
        probe.private_queried = true;
        ret true;
    }
    ret false;
}

rec HostileEntropy {
    owned:     *u8;
    owned_len: usize;
    mutate:    *u8;
}

fun hostile_entropy_aliases(ctx: ptr, data: *u8, len: usize) bool {
    val hostile: *HostileEntropy = ctx::*HostileEntropy;
    ret memory_range.overlap(data, len, hostile.owned, hostile.owned_len);
}

fun hostile_entropy_fill(ctx: ptr,
    output: contracts.SecretBuffer) contracts.Error {
    val hostile: *HostileEntropy = ctx::*HostileEntropy;
    if (output.data == nil || output.capacity < 32) {
        ret contracts.INVALID_INPUT;
    }
    var i: usize = 0;
    for (i < 32) {
        output.data[i] = i::u8;
        i              = i + 1;
    }
    if (hostile.mutate != nil) {
        hostile.mutate[0] = hostile.mutate[0] ^ 1;
    }
    ret contracts.OK;
}

fun set_private(output: *^u8) {
    val value: [32]u8 = [32]u8{
        0xc9, 0xaf, 0xa9, 0xd8, 0x45, 0xba, 0x75, 0x16,
        0x6b, 0x5c, 0x21, 0x57, 0x67, 0xb1, 0xd6, 0x93,
        0x4e, 0x50, 0xc3, 0xdb, 0x36, 0xe8, 0x9b, 0x12,
        0x7b, 0x8a, 0x62, 0x2b, 0x12, 0x0f, 0x67, 0x21
    };
    var i: usize = 0;
    for (i < 32) {
        output[i] = value[i];
        i         = i + 1;
    }
}

fun es_keys(public_key: *jose.PublicKey, private_key: *jose.PrivateKey,
    private_bytes: *^u8, public_bytes: *u8) bool {
    set_private(private_bytes);
    val secret:  contracts.SecretBytes = contracts.SecretBytes{data: private_bytes, len: 32};
    val derived: contracts.Operation   = p256.derive_public(secret,
        contracts.Buffer{data: public_bytes, capacity: 65});
    if (derived.error != contracts.OK) { ret false; }
    @public_key = jose.PublicKey{algorithm: jose.ES256,
        value: contracts.Bytes{data: public_bytes, len: 65}};
    @private_key = jose.PrivateKey{algorithm: jose.ES256,
        secret_owner: public_bytes::ptr, value: secret};
    ret true;
}

fun ed_keys(public_key: *jose.PublicKey, private_key: *jose.PrivateKey,
    private_bytes: *^u8, public_bytes: *u8) {
    val seed: [32]u8 = [32]u8{
        0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
        0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
        0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    };
    val encoded: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    var i: usize = 0;
    for (i < 32) {
        private_bytes[i] = seed[i];
        public_bytes[i]  = encoded[i];
        i                = i + 1;
    }
    @public_key = jose.PublicKey{algorithm: jose.EDDSA,
        value: contracts.Bytes{data: public_bytes, len: 32}};
    @private_key = jose.PrivateKey{algorithm: jose.EDDSA,
        secret_owner: public_bytes::ptr,
        value:        contracts.SecretBytes{data: private_bytes, len: 32}};
}

fun rsa_keys(public_key: *jose.PublicKey, private_key: *jose.PrivateKey,
    modulus: *u8, exponent: *u8, private_bytes: *^u8,
    decode_work: *u8) bool {
    val modulus_text: *u8 = "p_teNxO8by2eprJiu3ngRFferEuSKek_LmzyJCkogfOvJaUhm7J_SNN3xzaNNHpDvwsnw1sucOIckxzOySA-fqApVBCRo6R4zQ45x_hThuOcqKLMs4Pv4NngoOq-lbu4To76FfOFwgdrqqKPoOopivLyo-CmvmrcEvT21uBl_MKNeJw_LdqkVE6YyHmnBdESgcGSamwFKwBeF5UAZrr3mDD7HTNFR6OO5HBNokQdOWZ_U_PFoZGhrYp36JhvnNAewm1MDaItjskRlOWaE3mRmcscE855_ttHe_T_St-0LxH5Ik0Urtio0HY58zUT0MiZKVKluFQvlKo9fm_Nor5esQ";
    val private_text: *u8 = "eTcvHD0dE50cY23fSAUBQpkTfu6uBeKYAr8kMv0AQqF1qvknOaVZGMHt3zxVDVb2As8FXe6gfab1kyCNctT61hKzv_pHHfgMs8cUvTy5LfQIJZYLl7WGcW0Qr6Ai8CmcmlzSEOmbzhC6d5mWpqd3N2P9c3G2mBYyCtdVWh3TeoKHcutpJXAdfkWfc-aLeOuF46OMY-HdBYkL3uG77bgkdXbfgrhzDNMRWxRyUxOD_RRQ6UvzHy0Xb3KnN971VZFWydjrH_Hz-aj5T7Kmfu8h-dDMc_DonPEzhJ4SyO5vITdm_llR2MJJf8NhsXl4lQqKm1deNI2x04m6Kr6nzBaB";
    if (base64.decode(modulus_text, length(modulus_text), modulus, 256) != 256 ||
        base64.decode("AQAB", 4, exponent, 3) != 3 ||
        base64.decode(private_text, length(private_text), ?decode_work[1],
        255) != 255) { ret false; }
    decode_work[0] = 0;
    var i: usize = 0;
    for (i < 256) {
        private_bytes[i] = decode_work[i];
        decode_work[i]   = 0;
        i                = i + 1;
    }
    val rsa_public: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus:  contracts.Bytes{data: modulus, len: 256},
        exponent: contracts.Bytes{data: exponent, len: 3}
    };
    @public_key  = jose.PublicKey{algorithm: jose.PS256, rsa: rsa_public};
    @private_key = jose.PrivateKey{algorithm: jose.PS256,
        secret_owner:     modulus::ptr,
        rsa:              signature.RsaPrivateKey{modulus: rsa_public.modulus,
        public_exponent:  rsa_public.exponent,
        private_exponent: contracts.SecretBytes{data: private_bytes,
        len:              256}}};
    ret true;
}

fun empty_fields(fields: *field.Fields) {
    @fields = field.init(nil, 0, field.limits(0, 0, 0, 0));
}

fun response(code: u16, fields: *field.Fields, body: view.View) client.Response {
    ret client.Response{status: code, fields: fields, body: body,
        retry_after_seconds: 0};
}

fun awaiting(protocol: *client.Client, request: *client.SignedRequest) {
    request.state = client.REQUEST_EMPTY;
    client.begin_signed(protocol, request, client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false
    });
    request.wire_body = view.view("prepared", 8);
    request.state     = client.REQUEST_AWAITING;
}

rec AcceptContext {
    protocol: *client.Client;
    request:  *client.SignedRequest;
    fields:   *field.Fields;
    result:   *i64;
}

fun accept_worker(arg: *u8) {
    val context:  *AcceptContext  = arg::*AcceptContext;
    val decision: client.Decision = client.accept_signed_response(
        context.protocol, context.request,
        response(status.OK, context.fields, view.view(nil, 0)), nil, 0,
        client.ProblemStorage{data: nil, capacity: 0,
        subproblems: nil, subproblem_capacity: 0});
    if (decision.action == client.ACTION_COMPLETE) {
        atomic.store(context.result, 1);
    }
    or { atomic.store(context.result, -1); }
}

val HOSTILE_NORMAL:        u8 = 0;
val HOSTILE_OVERSIZED:     u8 = 1;
val HOSTILE_FOREIGN:       u8 = 2;
val HOSTILE_TAKE_REQUEST:  u8 = 3;
val HOSTILE_TAKE_CLIENT:   u8 = 4;
val HOSTILE_PUT_REQUEST:   u8 = 5;
val HOSTILE_CLEAR_REQUEST: u8 = 6;
val HOSTILE_PUT_FAIL:      u8 = 7;
val HOSTILE_COMMIT_FAIL:   u8 = 8;
val HOSTILE_RELEASE_FAIL:  u8 = 9;
val HOSTILE_REENTER:       u8 = 10;

rec HostilePool {
    mode:          u8;
    protocol:      *client.Client;
    request:       *client.SignedRequest;
    owned:         *u8;
    owned_len:     usize;
    secret_owner:  ptr;
    commit_count:  usize;
    release_count: usize;
    reentered:     bool;
}

fun hostile_ready(ctx: ptr) bool {
    ret ctx::*HostilePool != nil;
}

fun hostile_aliases(ctx: ptr, data: *u8, len: usize) bool {
    val hostile: *HostilePool = ctx::*HostilePool;
    ret memory_range.overlap(data, len, hostile.owned, hostile.owned_len);
}

fun hostile_reserve(ctx: ptr, output: *u8,
    capacity: usize) nonce.Reservation {
    val hostile: *HostilePool = ctx::*HostilePool;
    if (hostile.mode == HOSTILE_REENTER && hostile.protocol != nil) {
        hostile.reentered = client.release(hostile.protocol);
    }
    if (hostile.mode == HOSTILE_TAKE_REQUEST && hostile.request != nil) {
        hostile.request.state = client.REQUEST_EMPTY;
    }
    if (hostile.mode == HOSTILE_TAKE_CLIENT && hostile.protocol != nil) {
        hostile.protocol.nonces.reserve = nil;
    }
    if (hostile.mode == HOSTILE_OVERSIZED) {
        ret nonce.Reservation{error: problem.none(), found: true, token: 1,
            value: view.view(output, capacity + 1)};
    }
    if (hostile.mode == HOSTILE_FOREIGN) {
        ret nonce.Reservation{error: problem.none(), found: true, token: 1,
            value: view.view("foreign_nonce", 13)};
    }
    if (output == nil || capacity < 12) {
        ret nonce.Reservation{error: problem.local_code(problem.LIMIT,
            problem.OUTPUT_TOO_SMALL, "hostile test output is small"),
            found: false, token: 0, value: view.view(nil, 0)};
    }
    copy(output, "custom_nonce", 12);
    ret nonce.Reservation{error: problem.none(), found: true, token: 1,
        value: view.view(output, 12)};
}

fun hostile_commit(ctx: ptr, token: u64) problem.Error {
    val hostile: *HostilePool = ctx::*HostilePool;
    hostile.commit_count = hostile.commit_count + 1;
    if (token != 1) {
        ret problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "hostile test token is invalid");
    }
    if (hostile.mode == HOSTILE_COMMIT_FAIL) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "hostile commit failed");
    }
    ret problem.none();
}

fun hostile_release(ctx: ptr, token: u64) problem.Error {
    val hostile: *HostilePool = ctx::*HostilePool;
    hostile.release_count = hostile.release_count + 1;
    if (token != 1 || hostile.mode == HOSTILE_RELEASE_FAIL) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "hostile release failed");
    }
    ret problem.none();
}

fun hostile_owns_secret(ctx: ptr, owner: ptr) bool {
    val hostile: *HostilePool = ctx::*HostilePool;
    ret owner != nil && owner == hostile.secret_owner;
}

fun hostile_put(ctx: ptr, value: view.View) problem.Error {
    val hostile: *HostilePool = ctx::*HostilePool;
    if (hostile.mode == HOSTILE_PUT_REQUEST && hostile.request != nil) {
        hostile.request.state = client.REQUEST_EMPTY;
    }
    if (hostile.mode == HOSTILE_PUT_FAIL) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "hostile put failed");
    }
    ret problem.none();
}

fun hostile_clear(ctx: ptr) problem.Error {
    val hostile: *HostilePool = ctx::*HostilePool;
    if (hostile.mode == HOSTILE_CLEAR_REQUEST && hostile.request != nil) {
        hostile.request.state = client.REQUEST_EMPTY;
    }
    ret problem.none();
}

fun hostile_pool(context: *HostilePool) nonce.Pool {
    ret nonce.Pool{ctx: context::ptr, reserve: hostile_reserve,
        commit:          hostile_commit, release: hostile_release, put: hostile_put,
        clear:           hostile_clear, ready: hostile_ready, aliases: hostile_aliases,
        owns_secret:     hostile_owns_secret,
        max_nonce_bytes: 64, capacity: 4};
}

test "jose: rfc 7638 rsa jwk and sha-256 thumbprint are exact" {
    val modulus_text: *u8 = "0vx7agoebGcQSuuPiLJXZptN9nndrQmbXEps2aiAFbWhM78LhWx4cbbfAAtVT86zwu1RK7aPFFxuhDR1L6tSoc_BJECPebWKRXjBZCiFV4n3oknjhMstn64tZ_2W-5JsGY4Hc5n9yBXArwl93lqt7_RN5w6Cf0h4QyQ5v-65YGjQR0_FDW2QvzqY368QQMicAtaSqzs8KJZgnYb9c7d0zgdAZHzu6qMQvRL5hajrn1n91CbOpbISD08qNLyrdkt-bFTWhAI4vMQFh6WeZu0fM4lFd2NcRwr3XPksINHaQ-G_xBniIqbw0Ls1jF44-csFCur-kEgU8awapJzKnqDKgw";
    var modulus:      [256]u8;
    var exponent:     [3]u8;
    if (base64.decode(modulus_text, length(modulus_text), ?modulus[0], 256) != 256 ||
        base64.decode("AQAB", 4, ?exponent[0], 3) != 3) { ret 1; }
    val public_key: jose.PublicKey = jose.PublicKey{algorithm: jose.PS256,
        rsa:      signature.RsaPublicKey{
        modulus:  contracts.Bytes{data: ?modulus[0], len: 256},
        exponent: contracts.Bytes{data: ?exponent[0], len: 3}
    }};
    var jwk:     [512]u8;
    val encoded: jose.Operation = jose.key_encode_jwk(public_key,
        contracts.Buffer{data: ?jwk[0], capacity: 512});
    val prefix: *u8 = "{\"e\":\"AQAB\",\"kty\":\"RSA\",\"n\":\"";
    if (problem.failed(encoded.error) || encoded.written != 373 ||
        !equal(?jwk[0], prefix, length(prefix)) ||
        !equal(?jwk[length(prefix)], modulus_text, length(modulus_text)) ||
        jwk[encoded.written - 2] != '"' || jwk[encoded.written - 1] != '}') { ret 2; }
    var thumbprint: [43]u8;
    val thumb:      jose.Operation = jose.key_thumbprint(public_key,
        contracts.Buffer{data: ?thumbprint[0], capacity: 43});
    if (problem.failed(thumb.error) || thumb.written != 43 ||
        !equal(?thumbprint[0], "NzbLsXh8uDCcd-6MNwXF4W_7noWXFZAfHkxZsRGC9Xs", 43)) { ret 3; }
    ret 0;
}

test "jose: rfc 8555 protected fields are canonical and output is transactional" {
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0], ?public_bytes[0])) { ret 1; }
    val signer:    jose.Signer    = jose.signer(public_key);
    val protected: jose.Protected = jose.Protected{
        nonce:   view.view("Q_s3MWoqT05TrdkM2MTDcw", 22),
        url:     view.view("https://example.com/acme/chall/prV_B7yEyA4", 42),
        kid:     view.view("https://example.com/acme/acct/evOfKhNU60wg", 42),
        use_jwk: false, include_nonce: true
    };
    var work:   [2048]u8;
    var output: [512]u8;
    var forged: jose.Signer = signer;
    forged.algorithm = jose.PS256;
    fill(?output[0], 0xa5, 512);
    val rejected_signer: jose.Operation = jose.encode_jws(forged, private_key,
        jose.no_entropy(), protected, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (rejected_signer.error.code != problem.INVALID_INPUT ||
        !filled(?output[0], 0xa5, 512)) { ret 2; }
    fill(?output[0], 0xa5, 512);
    val too_small: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), protected, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 8});
    if (too_small.error.code != problem.OUTPUT_TOO_SMALL ||
        !filled(?output[0], 0xa5, 512)) { ret 3; }
    fill(?work[0], 0x6d, 2048);
    val overlap: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), protected, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 512},
        contracts.Buffer{data: ?work[0], capacity: 512});
    if (overlap.error.code != problem.INVALID_INPUT ||
        !filled(?work[0], 0x6d, 2048)) { ret 4; }
    fill(?output[0], 0xa5, 512);
    var invalid_nonce: jose.Protected = protected;
    invalid_nonce.nonce = view.view("bad+nonce", 9);
    val rejected_nonce: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), invalid_nonce, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (rejected_nonce.error.code != problem.INVALID_INPUT ||
        !filled(?output[0], 0xa5, 512)) { ret 5; }
    val encoded: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), protected, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    val expected: *u8 = "{\"protected\":\"eyJhbGciOiJFUzI1NiIsImtpZCI6Imh0dHBzOi8vZXhhbXBsZS5jb20vYWNtZS9hY2N0L2V2T2ZLaE5VNjB3ZyIsIm5vbmNlIjoiUV9zM01Xb3FUMDVUcmRrTTJNVERjdyIsInVybCI6Imh0dHBzOi8vZXhhbXBsZS5jb20vYWNtZS9jaGFsbC9wclZfQjd5RXlBNCJ9\",\"payload\":\"e30\",\"signature\":\"";
    if (problem.failed(encoded.error))                                            { ret 6; }
    if (encoded.written != length(expected) + 88)                                 { ret 7; }
    if (!equal(?output[0], expected, length(expected)))                           { ret 8; }
    if (output[encoded.written - 2] != '"' || output[encoded.written - 1] != '}') { ret 9; }
    var i: usize = length(expected);
    for (i < encoded.written - 2) {
        val byte: u8 = output[i];
        if (!((byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') ||
            (byte >= '0' && byte <= '9') || byte == '-' || byte == '_')) { ret 10; }
        i = i + 1;
    }
    val nested: jose.Protected = jose.Protected{
        nonce: view.view(nil, 0),
        url:   view.view("https://example.com/acme/key-change", 35),
        kid:   view.view(nil, 0), use_jwk: true, include_nonce: false
    };
    val nested_encoded: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), nested, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(nested_encoded.error) || nested_encoded.written == 0) { ret 11; }
    ret 0;
}

test "jose and json: hostile aliases and overflowing views fail before mutation" {
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }
    val signer:    jose.Signer    = jose.signer(public_key);
    val protected: jose.Protected = jose.Protected{
        nonce:   view.view("hostile_nonce", 13),
        url:     view.view("https://example.com/acme/order", 30),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false, include_nonce: true
    };
    var work:   [2048]u8;
    var output: [512]u8;
    fill(?work[0], 0x6d, 2048);
    fill(?output[0], 0xa5, 512);
    work[0] = '{';
    work[1] = '}';
    val payload_work: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), protected, view.view(?work[0], 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (payload_work.error.code != problem.INVALID_INPUT ||
        work[0] != '{' || work[1] != '}' || work[2] != 0x6d ||
        !filled(?output[0], 0xa5, 512)) { ret 2; }

    fill(?output[0], 0xa5, 512);
    output[0] = '{';
    output[1] = '}';
    val payload_output: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), protected, view.view(?output[0], 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (payload_output.error.code != problem.INVALID_INPUT ||
        output[0] != '{' || output[1] != '}' || output[2] != 0xa5) { ret 3; }

    var nonce_work: jose.Protected = protected;
    nonce_work.nonce = view.view(?work[32], 13);
    copy(?work[32], "hostile_nonce", 13);
    val protected_alias: jose.Operation = jose.encode_jws(signer, private_key,
        jose.no_entropy(), nonce_work, view.view("{}", 2),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (protected_alias.error.code != problem.INVALID_INPUT ||
        !equal(?work[32], "hostile_nonce", 13)) { ret 4; }

    val public_first: u8             = public_bytes[0];
    val key_output:   jose.Operation = jose.key_encode_jwk(public_key,
        contracts.Buffer{data: ?public_bytes[0], capacity: 65});
    val thumb_output: jose.Operation = jose.key_thumbprint(public_key,
        contracts.Buffer{data: ?public_bytes[1], capacity: 43});
    if (key_output.error.code != problem.INVALID_INPUT ||
        thumb_output.error.code != problem.INVALID_INPUT ||
        public_bytes[0] != public_first) { ret 5; }

    var message: [64]u8;
    fill(?message[0], 0x72, 64);
    val signing_alias: jose.Operation = jose.key_sign(private_key,
        jose.no_entropy(), contracts.Bytes{data: ?message[0], len: 32},
        contracts.Buffer{data: ?message[16], capacity: 48});
    if (signing_alias.error.code != problem.INVALID_INPUT ||
        !filled(?message[0], 0x72, 64)) { ret 6; }

    val near_end: *u8 = 0xfffffffffffffff0::*u8;
    fill(?output[0], 0xa5, 512);
    val overflowing: jose.Operation = jose.key_sign(private_key,
        jose.no_entropy(), contracts.Bytes{data: near_end, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 64});
    if (overflowing.error.code != problem.INVALID_INPUT ||
        !filled(?output[0], 0xa5, 512)) { ret 7; }

    var json_bytes:  [2]u8       = [2]u8{'{', '}'};
    val json_limits: json.Limits = json.Limits{max_bytes: 64,
        max_depth:           4, max_values: 8, max_key_bytes: 16,
        max_key_comparisons: 32};
    val json_alias: json.Document = json.parse(
        view.view(?json_bytes[0], 2), ?json_bytes[0], 2, json_limits);
    if (json_alias.valid || json_alias.error.code != problem.INVALID_INPUT ||
        json_bytes[0] != '{' || json_bytes[1] != '}') { ret 8; }
    val json_overflow: json.Document = json.parse(view.view(near_end, 32),
        ?work[0], 2048, json_limits);
    if (json_overflow.valid ||
        json_overflow.error.code != problem.INVALID_INPUT) { ret 9; }
    ret 0;
}

test "json: numeric grammar, key lookup, and duplicate work fail closed" {
    var scratch:    [8192]u8;
    val configured: json.Limits = json.Limits{max_bytes: 256,
        max_depth:           4, max_values: 16, max_key_bytes: 16,
        max_key_comparisons: 32};
    val leading:           *u8           = "{\"n\":01}";
    val positive_overflow: *u8           = "{\"n\":9223372036854775808}";
    val negative_overflow: *u8           = "{\"n\":-9223372036854775808}";
    val leading_result:    json.Document = json.parse(
        view.view(leading, length(leading)), ?scratch[0], 8192, configured);
    val positive_result: json.Document = json.parse(
        view.view(positive_overflow, length(positive_overflow)),
        ?scratch[0], 8192, configured);
    val negative_result: json.Document = json.parse(
        view.view(negative_overflow, length(negative_overflow)),
        ?scratch[0], 8192, configured);
    if (leading_result.valid || leading_result.error.code != problem.MALFORMED_JSON ||
        positive_result.valid || positive_result.error.kind != problem.LIMIT ||
        negative_result.valid || negative_result.error.kind != problem.LIMIT) {
        ret 1;
    }
    val valid_text: *u8           = "{\"n\":9223372036854775807,\"f\":1.5e+2}";
    val valid:      json.Document = json.parse(view.view(valid_text,
        length(valid_text)), ?scratch[0], 8192, configured);
    var root:   J.Value  = valid.root;
    val number: *J.Value = json.find(?root, "n");
    if (!valid.valid || number == nil || json.find(nil, "n") != nil ||
        json.find(number, "n") != nil || json.find(?root, nil) != nil) { ret 2; }

    var hostile: [32768]u8;
    var pos:     usize = 0;
    hostile[pos] = '{';
    pos          = pos + 1;
    val digits: *u8   = "0123456789abcdef";
    var i:      usize = 0;
    for (i < 4095) {
        if (i != 0) {
            hostile[pos] = ',';
            pos          = pos + 1;
        }
        hostile[pos]     = '"';
        hostile[pos + 1] = digits[(i >> 8) & 15];
        hostile[pos + 2] = digits[(i >> 4) & 15];
        hostile[pos + 3] = digits[i & 15];
        hostile[pos + 4] = '"';
        hostile[pos + 5] = ':';
        hostile[pos + 6] = '0';
        pos              = pos + 7;
        i                = i + 1;
    }
    hostile[pos] = '}';
    pos          = pos + 1;
    var large_scratch: [2097152]u8;
    val bounded:       json.Document = json.parse(view.view(?hostile[0], pos),
        ?large_scratch[0], 2097152, json.Limits{max_bytes: 32768,
        max_depth:           2, max_values: 4096, max_key_bytes: 3,
        max_key_comparisons: 64});
    if (bounded.valid || bounded.error.kind != problem.LIMIT ||
        bounded.error.code != problem.MALFORMED_JSON) { ret 3; }
    ret 0;
}

test "jose: rfc 8032 ed25519 account signing vector is exact" {
    var seed: [32]^u8 = [32]^u8{
        0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
        0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
        0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
        0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60
    };
    val public_key_bytes: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    val expected: [64]u8 = [64]u8{
        0xe5, 0x56, 0x43, 0x00, 0xc3, 0x60, 0xac, 0x72,
        0x90, 0x86, 0xe2, 0xcc, 0x80, 0x6e, 0x82, 0x8a,
        0x84, 0x87, 0x7f, 0x1e, 0xb8, 0xe5, 0xd9, 0x74,
        0xd8, 0x73, 0xe0, 0x65, 0x22, 0x49, 0x01, 0x55,
        0x5f, 0xb8, 0x82, 0x15, 0x90, 0xa3, 0x3b, 0xac,
        0xc6, 0x1e, 0x39, 0x70, 0x1c, 0xf9, 0xb4, 0x6b,
        0xd2, 0x5b, 0xf5, 0xf0, 0x59, 0x5b, 0xbe, 0x24,
        0x65, 0x51, 0x41, 0x43, 0x8e, 0x7a, 0x10, 0x0b
    };
    val public_key: jose.PublicKey = jose.PublicKey{algorithm: jose.EDDSA,
        value: contracts.Bytes{data: (?public_key_bytes[0]):~*u8, len: 32}};
    val private_key: jose.PrivateKey = jose.PrivateKey{algorithm: jose.EDDSA,
        secret_owner: ((?public_key_bytes[0]):~*u8)::ptr,
        value: contracts.SecretBytes{data: ?seed[0], len: 32}};
    var jwk:     [80]u8;
    val encoded: jose.Operation = jose.key_encode_jwk(public_key,
        contracts.Buffer{data: ?jwk[0], capacity: 80});
    val expected_jwk: *u8 =
        "{\"crv\":\"Ed25519\",\"kty\":\"OKP\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}";
    if (problem.failed(encoded.error) || encoded.written != 79 ||
        !equal(?jwk[0], expected_jwk, 79)) { ret 1; }
    var output: [64]u8;
    val signed: jose.Operation = jose.key_sign(private_key,
        jose.no_entropy(), contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?output[0], capacity: 64});
    if (problem.failed(signed.error) || signed.written != 64 ||
        !equal(?output[0], (?expected[0]):~*u8, 64)) { ret 2; }
    ret 0;
}

test "jose: openssl rsa-pss fixture uses bounded entropy and preserves failures" {
    val modulus_text:   *u8 = "p_teNxO8by2eprJiu3ngRFferEuSKek_LmzyJCkogfOvJaUhm7J_SNN3xzaNNHpDvwsnw1sucOIckxzOySA-fqApVBCRo6R4zQ45x_hThuOcqKLMs4Pv4NngoOq-lbu4To76FfOFwgdrqqKPoOopivLyo-CmvmrcEvT21uBl_MKNeJw_LdqkVE6YyHmnBdESgcGSamwFKwBeF5UAZrr3mDD7HTNFR6OO5HBNokQdOWZ_U_PFoZGhrYp36JhvnNAewm1MDaItjskRlOWaE3mRmcscE855_ttHe_T_St-0LxH5Ik0Urtio0HY58zUT0MiZKVKluFQvlKo9fm_Nor5esQ";
    val private_text:   *u8 = "eTcvHD0dE50cY23fSAUBQpkTfu6uBeKYAr8kMv0AQqF1qvknOaVZGMHt3zxVDVb2As8FXe6gfab1kyCNctT61hKzv_pHHfgMs8cUvTy5LfQIJZYLl7WGcW0Qr6Ai8CmcmlzSEOmbzhC6d5mWpqd3N2P9c3G2mBYyCtdVWh3TeoKHcutpJXAdfkWfc-aLeOuF46OMY-HdBYkL3uG77bgkdXbfgrhzDNMRWxRyUxOD_RRQ6UvzHy0Xb3KnN971VZFWydjrH_Hz-aj5T7Kmfu8h-dDMc_DonPEzhJ4SyO5vITdm_llR2MJJf8NhsXl4lQqKm1deNI2x04m6Kr6nzBaB";
    var modulus:        [256]u8;
    var exponent:       [3]u8;
    var private_public: [256]u8;
    var private_bytes:  [256]^u8;
    if (base64.decode(modulus_text, length(modulus_text), ?modulus[0], 256) != 256 ||
        base64.decode("AQAB", 4, ?exponent[0], 3) != 3 ||
        base64.decode(private_text, length(private_text), ?private_public[1], 255) != 255) {
        ret 1;
    }
    private_public[0] = 0;
    var i: usize = 0;
    for (i < 256) {
        private_bytes[i] = private_public[i];
        i                = i + 1;
    }
    fill(?private_public[0], 0, 256);
    val rsa_public: signature.RsaPublicKey = signature.RsaPublicKey{
        modulus:  contracts.Bytes{data: ?modulus[0], len: 256},
        exponent: contracts.Bytes{data: ?exponent[0], len: 3}
    };
    val rsa_private: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus:          contracts.Bytes{data: ?modulus[0], len: 256},
        public_exponent:  contracts.Bytes{data: ?exponent[0], len: 3},
        private_exponent: contracts.SecretBytes{data: ?private_bytes[0], len: 256}
    };
    val key: jose.PrivateKey = jose.PrivateKey{algorithm: jose.PS256,
        secret_owner: (?modulus[0])::ptr, rsa: rsa_private};
    var output:        [256]u8;
    var message_bytes: [32]u8;
    copy(?message_bytes[0], "mach-acme openssl rsa-pss vector", 32);
    val message: *u8            = ?message_bytes[0];
    val signed:  jose.Operation = jose.key_sign(key,
        jose.entropy_provider(nil, deterministic_entropy, entropy_aliases_nothing,
        entropy_aliases_no_secret, entropy_still_valid),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (problem.failed(signed.error)) { ret 20; }
    if (signed.written != 256)        { ret 21; }
    if (signature.verify_rsa_pss_sha256(rsa_public,
        contracts.Bytes{data: message, len: 32},
        contracts.Bytes{data: ?output[0], len: 256}) != contracts.OK) { ret 19; }
    var probe:         SecretAliasProbe;
    val owned_private: jose.Operation = jose.key_sign(key,
        jose.entropy_provider((?probe)::ptr, deterministic_entropy,
        entropy_aliases_nothing, entropy_aliases_private,
        entropy_still_valid), contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (owned_private.error.code != problem.INVALID_INPUT ||
        owned_private.written != 0 || !probe.private_queried) { ret 20; }
    fill(?output[0], 0xa5, 256);
    val unavailable: jose.Operation = jose.key_sign(key,
        jose.entropy_provider(nil, unavailable_entropy, entropy_aliases_nothing,
        entropy_aliases_no_secret, entropy_still_valid),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (unavailable.error.code != problem.ENTROPY_UNAVAILABLE || unavailable.written != 0 ||
        !filled(?output[0], 0xa5, 256)) { ret 3; }
    val missing: jose.Operation = jose.key_sign(key,
        jose.Entropy{ctx: nil, fill: nil, available: true},
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (missing.error.code != problem.ENTROPY_UNAVAILABLE || missing.written != 0 ||
        !filled(?output[0], 0xa5, 256)) { ret 4; }
    var hostile: HostileEntropy;
    hostile.owned     = message;
    hostile.owned_len = 32;
    val owned: jose.Operation = jose.key_sign(key,
        jose.entropy_provider((?hostile)::ptr, hostile_entropy_fill,
        hostile_entropy_aliases, entropy_aliases_no_secret,
        entropy_still_valid),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (owned.error.code != problem.INVALID_INPUT || owned.written != 0 ||
        !filled(?output[0], 0xa5, 256)) { ret 5; }
    hostile.owned     = nil;
    hostile.owned_len = 0;
    hostile.mutate    = message;
    val mutated: jose.Operation = jose.key_sign(key,
        jose.entropy_provider((?hostile)::ptr, hostile_entropy_fill,
        hostile_entropy_aliases, entropy_aliases_no_secret,
        entropy_still_valid),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (mutated.error.code != problem.INVALID_INPUT || mutated.written != 0 ||
        message[0] == 'm' || !filled(?output[0], 0xa5, 256)) { ret 6; }
    message[0] = 'm';
    val invalidated: jose.Operation = jose.key_sign(key,
        jose.entropy_provider(nil, deterministic_entropy,
        entropy_aliases_nothing, entropy_aliases_no_secret,
        entropy_invalid_after),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (invalidated.error.code != problem.INVALID_INPUT ||
        invalidated.written != 0 || !filled(?output[0], 0xa5, 256)) { ret 7; }
    val modulus_first: u8 = modulus[0];
    hostile.mutate = ?modulus[0];
    val key_mutated: jose.Operation = jose.key_sign(key,
        jose.entropy_provider((?hostile)::ptr, hostile_entropy_fill,
        hostile_entropy_aliases, entropy_aliases_no_secret,
        entropy_still_valid),
        contracts.Bytes{data: message, len: 32},
        contracts.Buffer{data: ?output[0], capacity: 256});
    if (key_mutated.error.code != problem.INVALID_INPUT ||
        key_mutated.written != 0 || modulus[0] == modulus_first ||
        !filled(?output[0], 0xa5, 256)) { ret 8; }
    modulus[0] = modulus_first;
    ret 0;
}

test "client: wire requests bind exact body and transport policy" {
    var configured: client.Limits = client.limits_default();
    configured.request_timeout_ns = 123456789;
    val directory_url: view.View          = view.view("https://example.com/acme/directory", 34);
    val discovery:     client.WireRequest = client.discovery_request(directory_url,
        configured);
    if (problem.failed(discovery.error) || discovery.method.kind != method.GET ||
        discovery.url.data != directory_url.data || discovery.url.len != 34 ||
        discovery.timeout_ns != configured.request_timeout_ns ||
        discovery.max_response_bytes != configured.max_response_bytes ||
        !discovery.replay_safe) { ret 1; }
    val fragment: *u8 = "https://example.com/acme/directory#fragment";
    if (client.discovery_request(view.view(fragment, length(fragment)),
        configured).error.code != problem.INVALID_INPUT) { ret 2; }
    val spaced: *u8 = "https://exa mple.com/acme/directory";
    if (client.discovery_request(view.view(spaced, length(spaced)),
        configured).error.code != problem.INVALID_INPUT) { ret 3; }
    val escaped: *u8 = "https://example.com/acme/%zz";
    if (client.discovery_request(view.view(escaped, length(escaped)),
        configured).error.code != problem.INVALID_INPUT) { ret 4; }

    var slots:         [1]nonce.Slot;
    var nonce_storage: [64]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1,
        ?nonce_storage[0], 64, 64))) { ret 5; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, configured))) { ret 6; }
    var directory: client.Directory;
    directory.new_nonce_url = view.view("https://example.com/acme/nonce", 30);
    val nonce_wire: client.WireRequest = client.nonce_request(?protocol, directory);
    if (problem.failed(nonce_wire.error) || nonce_wire.method.kind != method.HEAD ||
        nonce_wire.timeout_ns != configured.request_timeout_ns ||
        nonce_wire.max_response_bytes != configured.max_response_bytes ||
        !nonce_wire.replay_safe) { ret 7; }

    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?request, client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31), use_jwk: false
    })) ||
        problem.failed(pool.put(pool.ctx,
        view.view("wire_nonce", 10)))) { ret 8; }
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 9; }
    var work:   [2048]u8;
    var output: [512]u8;
    val signed: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    val wire: client.WireRequest = client.signed_wire(?protocol, ?request);
    if (problem.failed(signed.error) || problem.failed(wire.error) ||
        wire.method.kind != method.POST || wire.body.data != ?output[0] ||
        wire.body.len != signed.written || wire.timeout_ns != configured.request_timeout_ns ||
        wire.max_response_bytes != configured.max_response_bytes || wire.replay_safe) { ret 10; }

    var small_slots:         [1]nonce.Slot;
    var small_nonce_storage: [64]u8;
    var small_memory:        nonce.Memory;
    var small_configured:    client.Limits = configured;
    small_configured.max_request_bytes = 512;
    if (problem.failed(nonce.init_memory(?small_memory, ?small_slots[0], 1,
        ?small_nonce_storage[0], 64, 64))) { ret 11; }
    var small_pool:     nonce.Pool = nonce.pool(?small_memory);
    var small_protocol: client.Client;
    var small_request:  client.SignedRequest;
    if (problem.failed(client.init(?small_protocol, ?small_pool, small_configured)) ||
        problem.failed(small_pool.put(small_pool.ctx, view.view("small_nonce", 11))) ||
        problem.failed(client.begin_signed(?small_protocol, ?small_request,
        request.spec))) { ret 12; }
    fill(?output[0], 0xa5, 512);
    val limited: jose.Operation = client.prepare_signed(?small_protocol,
        ?small_request, jose.signer(public_key), private_key,
        jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 1});
    if (limited.error.code != problem.OUTPUT_TOO_SMALL || limited.written != 0 ||
        small_request.state != client.REQUEST_READY ||
        !filled(?output[0], 0xa5, 512) ||
        !problem.failed(client.signed_wire(?small_protocol,
        ?small_request).error)) { ret 13; }
    val resumed: jose.Operation = client.prepare_signed(?small_protocol,
        ?small_request, jose.signer(public_key), private_key,
        jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(resumed.error) ||
        small_request.state != client.REQUEST_AWAITING) { ret 14; }
    ret 0;
}

test "client: https scheme matching is ascii case insensitive" {
    val configured: client.Limits = client.limits_default();
    val mixed_url:  view.View     = view.view(
        "HtTpS://example.com/acme/directory", 34);
    if (problem.failed(client.discovery_request(mixed_url,
        configured).error)) { ret 1; }

    val body:   *u8 = "{\"newNonce\":\"HTTPS://a.example/nonce\",\"newAccount\":\"hTtPs://a.example/account\",\"newOrder\":\"HtTpS://a.example/order\"}";
    var fields: field.Fields;
    empty_fields(?fields);
    var scratch:   [8192]u8;
    var text:      [512]u8;
    var caa:       [1]view.View;
    var directory: client.Directory;
    val parsed:    problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(body, length(body))), configured,
        ?scratch[0], 8192, client.DirectoryStorage{data: ?text[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (problem.failed(parsed) || directory.new_nonce_url.len != 23 ||
        !equal(directory.new_nonce_url.data, "HTTPS://a.example/nonce", 23)) { ret 2; }

    var slots:         [1]nonce.Slot;
    var nonce_storage: [64]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1,
        ?nonce_storage[0], 64, 64))) { ret 3; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, configured)) ||
        problem.failed(client.nonce_request(?protocol, directory).error)) { ret 4; }
    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?request,
        client.SignedSpec{url: view.view("HTTPS://a.example/order", 23),
        payload: view.view("{}", 2),
        kid:     view.view("hTtPs://a.example/account", 25),
        use_jwk: false}))) { ret 5; }
    ret 0;
}

test "client: mutable state and parser aliases fail transactionally" {
    val configured: client.Limits = client.limits_default();
    var fields:     field.Fields;
    empty_fields(?fields);
    val body:      *u8 = "{\"newNonce\":\"https://a.example/nonce\",\"newAccount\":\"https://a.example/account\",\"newOrder\":\"https://a.example/order\"}";
    var shared:    [8192]u8;
    var caa:       [1]view.View;
    var directory: client.Directory;
    directory.new_nonce_url = view.view("sentinel", 8);
    fill(?shared[0], 0x5a, 8192);
    val scratch_storage: problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(body, length(body))), configured,
        ?shared[0], 8192, client.DirectoryStorage{data: ?shared[128], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (scratch_storage.code != problem.INVALID_DIRECTORY ||
        directory.new_nonce_url.len != 8 || !filled(?shared[0], 0x5a, 8192)) { ret 1; }

    var response_storage: [512]u8;
    fill(?response_storage[0], 0x6b, 512);
    copy(?response_storage[0], body, length(body));
    var scratch:      [8192]u8;
    val body_storage: problem.Error = client.parse_directory(
        response(status.OK, ?fields,
        view.view(?response_storage[0], length(body))), configured,
        ?scratch[0], 8192, client.DirectoryStorage{data: ?response_storage[0],
        capacity: 512, caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (body_storage.code != problem.INVALID_DIRECTORY ||
        !equal(?response_storage[0], body, length(body)) ||
        directory.new_nonce_url.len != 8) { ret 2; }

    var item:           [1]field.Field;
    var aliased_fields: field.Fields = field.init(?item[0], 1,
        field.limits(1, 128, 32, 64));
    fill(?response_storage[0], 'v', 512);
    if (field.append(?aliased_fields, field.Field{name: view.view("X-Test", 6),
        value: view.view(?response_storage[0], 8), sensitive: false}) !=
        field.ADD_OK) { ret 3; }
    val field_storage: problem.Error = client.parse_directory(
        response(status.OK, ?aliased_fields, view.view(body, length(body))),
        configured, ?scratch[0], 8192,
        client.DirectoryStorage{data: ?response_storage[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (field_storage.code != problem.INVALID_DIRECTORY ||
        !filled(?response_storage[0], 'v', 512) ||
        directory.new_nonce_url.len != 8) { ret 4; }

    val near_end: *u8           = 0xfffffffffffffff0::*u8;
    val overflow: problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(body, length(body))), configured,
        near_end, 32, client.DirectoryStorage{data: ?response_storage[0],
        capacity: 512, caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (overflow.code != problem.INVALID_DIRECTORY ||
        directory.new_nonce_url.len != 8) { ret 5; }

    var forged_fields: field.Fields;
    empty_fields(?forged_fields);
    forged_fields.items    = near_end::*field.Field;
    forged_fields.capacity = 2;
    val invalid_fields: problem.Error = client.parse_directory(
        response(status.BAD_GATEWAY, ?forged_fields, view.view(nil, 0)),
        configured, ?scratch[0], 8192,
        client.DirectoryStorage{data: ?response_storage[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (invalid_fields.code != problem.INVALID_INPUT ||
        directory.new_nonce_url.len != 8) { ret 6; }

    var slots:         [2]nonce.Slot;
    var nonce_storage: [128]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 2,
        ?nonce_storage[0], 128, 64))) { ret 7; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, configured))) { ret 8; }

    var colliding_client: client.Client;
    if (client.init(?colliding_client,
        (?colliding_client)::*nonce.Pool, configured).code !=
        problem.INVALID_INPUT) { ret 9; }

    var begin_alias: client.SignedRequest;
    begin_alias.state = client.REQUEST_EMPTY;
    copy(?begin_alias.retry_nonce[0], "https://a.example/order", 23);
    val rejected_begin: problem.Error = client.begin_signed(?protocol,
        ?begin_alias, client.SignedSpec{
        url:     view.view(?begin_alias.retry_nonce[0], 23),
        payload: view.view("{}", 2),
        kid:     view.view("https://a.example/account", 25), use_jwk: false
    });
    if (rejected_begin.code != problem.INVALID_INPUT ||
        !equal(?begin_alias.retry_nonce[0], "https://a.example/order", 23)) { ret 10; }

    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?request,
        client.SignedSpec{url: view.view("https://a.example/order", 23),
        payload: view.view("{}", 2),
        kid:     view.view("https://a.example/account", 25), use_jwk: false})) ||
        problem.failed(pool.put(pool.ctx, view.view("preserved_nonce", 15)))) { ret 11; }
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 12; }
    var work:             [2048]u8;
    val rejected_prepare: jose.Operation = client.prepare_signed(?protocol,
        ?request, jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: (?request)::*u8,
        capacity: $size_of(client.SignedRequest)});
    var nonce_output: [64]u8;
    val retained:     nonce.Taken = nonce.take(pool, ?nonce_output[0], 64);
    if (rejected_prepare.error.code != problem.INVALID_INPUT ||
        request.state != client.REQUEST_READY || problem.failed(retained.error) ||
        !retained.found || retained.value.len != 15 ||
        !equal(retained.value.data, "preserved_nonce", 15)) { ret 13; }

    awaiting(?protocol, ?request);
    copy(?request.retry_nonce[0], "response_nonce", 14);
    var response_item:   [1]field.Field;
    var response_fields: field.Fields = field.init(?response_item[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?response_fields, field.Field{
        name:  view.view("Replay-Nonce", 12),
        value: view.view(?request.retry_nonce[0], 14), sensitive: false
    }) !=
        field.ADD_OK) { ret 14; }
    val wire_before:       *u8             = request.wire_body.data;
    val rejected_response: client.Decision = client.accept_signed_response(
        ?protocol, ?request, response(status.OK, ?response_fields,
        view.view(nil, 0)), ?scratch[0], 8192,
        client.ProblemStorage{data: ?response_storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (rejected_response.cause.code != problem.INVALID_INPUT ||
        request.state != client.REQUEST_FAILED ||
        request.wire_body.data != nil || wire_before == nil) { ret 15; }

    awaiting(?protocol, ?request);
    fill(?shared[0], 0xb7, 8192);
    val problem_body:  *u8             = "{\"type\":7}";
    val problem_alias: client.Decision = client.accept_signed_response(
        ?protocol, ?request, response(status.BAD_REQUEST, ?fields,
        view.view(problem_body, length(problem_body))), ?shared[0], 8192,
        client.ProblemStorage{data: ?shared[128], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (problem_alias.cause.code != problem.INVALID_INPUT ||
        request.state != client.REQUEST_FAILED ||
        !filled(?shared[0], 0xb7, 8192)) { ret 16; }
    ret 0;
}

test "client: ownership generations reject foreign and stale request handles" {
    var slots:         [2]nonce.Slot;
    var nonce_storage: [128]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 2,
        ?nonce_storage[0], 128, 64))) { ret 1; }
    var pool:       nonce.Pool    = nonce.pool(?memory);
    var first:      client.Client;
    var second:     client.Client;
    val configured: client.Limits = client.limits_default();
    if (problem.failed(client.init(?first, ?pool, configured)) ||
        problem.failed(client.init(?second, ?pool, configured)) ||
        problem.failed(pool.put(pool.ctx, view.view("owner_nonce", 11)))) { ret 2; }
    val generation: u64 = first.generation;
    if (!problem.failed(client.init(?first, ?pool, configured)) ||
        first.generation != generation) { ret 3; }

    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?first, ?request, client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31), use_jwk: false
    }))) {
        ret 4;
    }
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 5; }
    var work:   [2048]u8;
    var output: [512]u8;
    val signed: jose.Operation = client.prepare_signed(?first, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(signed.error) ||
        !problem.failed(client.signed_wire(?second, ?request).error)) { ret 6; }

    if (!client.release(?first) ||
        !problem.failed(client.signed_wire(?first, ?request).error) ||
        problem.failed(client.init(?first, ?pool, configured)) ||
        first.generation != generation + 1 ||
        !problem.failed(client.signed_wire(?first, ?request).error)) { ret 7; }

    if (!client.release(?first) || !client.release(?second) ||
        problem.failed(nonce.release_memory(?memory)) || nonce.valid(?pool)) { ret 8; }
    var stale: client.Client;
    if (!problem.failed(client.init(?stale, ?pool, configured))) { ret 9; }
    ret 0;
}

test "client: lets encrypt staging directory fixture discovers bounded endpoints" {
    val body:   *u8 = "{\"FrDPtXot1mU\":\"https://community.letsencrypt.org/t/adding-random-entries-to-the-directory/33417\",\"keyChange\":\"https://acme-staging-v02.api.letsencrypt.org/acme/key-change\",\"meta\":{\"caaIdentities\":[\"letsencrypt.org\"],\"profiles\":{\"classic\":\"https://letsencrypt.org/docs/profiles#classic\"},\"termsOfService\":\"https://letsencrypt.org/documents/LE-SA-v1.8-July-06-2026.pdf\",\"website\":\"https://letsencrypt.org/docs/staging-environment/\"},\"newAccount\":\"https://acme-staging-v02.api.letsencrypt.org/acme/new-acct\",\"newNonce\":\"https://acme-staging-v02.api.letsencrypt.org/acme/new-nonce\",\"newOrder\":\"https://acme-staging-v02.api.letsencrypt.org/acme/new-order\",\"renewalInfo\":\"https://acme-staging-v02.api.letsencrypt.org/acme/renewal-info\",\"revokeCert\":\"https://acme-staging-v02.api.letsencrypt.org/acme/revoke-cert\"}";
    var fields: field.Fields;
    empty_fields(?fields);
    var scratch:   [16384]u8;
    var text:      [1024]u8;
    var caa:       [4]view.View;
    var directory: client.Directory;
    val result:    problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(body, length(body))),
        client.limits_default(), ?scratch[0], 16384,
        client.DirectoryStorage{data: ?text[0], capacity: 1024,
        caa_items: ?caa[0], caa_capacity: 4}, ?directory);
    if (problem.failed(result))               { ret 1; }
    if (directory.new_nonce_url.len != 59)    { ret 2; }
    if (directory.new_account_url.len != 58)  { ret 3; }
    if (directory.new_order_url.len != 59)    { ret 4; }
    if (directory.renewal_info_url.len != 62) { ret 5; }
    if (directory.revoke_cert_url.len != 61)  { ret 6; }
    if (directory.key_change_url.len != 60)   { ret 7; }
    if (directory.caa_identity_len != 1 ||
        !equal(directory.caa_identities[0].data, "letsencrypt.org", 15)) { ret 8; }
    if (directory.external_account_required) { ret 9; }
    ret 0;
}

test "client: hostile directory inputs preserve caller outputs" {
    val duplicate: *u8 = "{\"newNonce\":\"https://a.example/nonce\",\"newNonce\":\"https://b.example/nonce\",\"newAccount\":\"https://a.example/account\",\"newOrder\":\"https://a.example/order\"}";
    var fields:    field.Fields;
    empty_fields(?fields);
    var scratch: [8192]u8;
    var text:    [512]u8;
    var caa:     [2]view.View;
    fill(?text[0], 0x5a, 512);
    var directory: client.Directory;
    directory.new_nonce_url = view.view("sentinel", 8);
    val result: problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(duplicate, length(duplicate))),
        client.limits_default(), ?scratch[0], 8192,
        client.DirectoryStorage{data: ?text[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 2}, ?directory);
    if (result.code != problem.MALFORMED_JSON ||
        directory.new_nonce_url.len != 8 || !filled(?text[0], 0x5a, 512)) { ret 1; }
    val insecure:        *u8           = "{\"newNonce\":\"http://a.example/nonce\",\"newAccount\":\"https://a.example/account\",\"newOrder\":\"https://a.example/order\"}";
    val insecure_result: problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(insecure, length(insecure))),
        client.limits_default(), ?scratch[0], 8192,
        client.DirectoryStorage{data: ?text[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 2}, ?directory);
    if (insecure_result.code != problem.INVALID_DIRECTORY ||
        directory.new_nonce_url.len != 8 || !filled(?text[0], 0x5a, 512)) { ret 2; }
    val escaped_duplicate: *u8           = "{\"newNonce\":\"https://a.example/nonce\",\"new\\u004eonce\":\"https://b.example/nonce\",\"newAccount\":\"https://a.example/account\",\"newOrder\":\"https://a.example/order\"}";
    val escaped_result:    problem.Error = client.parse_directory(
        response(status.OK, ?fields, view.view(escaped_duplicate, length(escaped_duplicate))),
        client.limits_default(), ?scratch[0], 8192,
        client.DirectoryStorage{data: ?text[0], capacity: 512,
        caa_items: ?caa[0], caa_capacity: 2}, ?directory);
    if (escaped_result.code != problem.MALFORMED_JSON ||
        directory.new_nonce_url.len != 8 || !filled(?text[0], 0x5a, 512)) { ret 3; }
    ret 0;
}

test "client: directory response policy rejects and sanitizes hostile shapes" {
    var fields: field.Fields;
    empty_fields(?fields);
    var configured: client.Limits = client.limits_default();
    configured.max_response_bytes = 64;
    configured.max_problem_bytes  = 64;
    var scratch:   [256]u8;
    var text:      [256]u8;
    var caa:       [1]view.View;
    var directory: client.Directory;
    directory.new_nonce_url = view.view("sentinel", 8);

    val invalid_view: problem.Error = client.parse_directory(
        response(status.BAD_GATEWAY, ?fields, view.view(nil, 1)), configured,
        ?scratch[0], 256, client.DirectoryStorage{data: ?text[0], capacity: 256,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (invalid_view.kind != problem.PROTOCOL ||
        invalid_view.code != problem.INVALID_INPUT ||
        invalid_view.http.status != status.BAD_GATEWAY ||
        invalid_view.http.body.data != nil || invalid_view.http.body.len != 0 ||
        directory.new_nonce_url.len != 8) { ret 1; }

    val oversized: problem.Error = client.parse_directory(
        response(status.BAD_GATEWAY, ?fields, view.view("x", 65)), configured,
        ?scratch[0], 256, client.DirectoryStorage{data: ?text[0], capacity: 256,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (oversized.kind != problem.LIMIT ||
        oversized.code != problem.OUTPUT_TOO_SMALL ||
        oversized.http.status != status.BAD_GATEWAY ||
        oversized.http.body.data != nil || oversized.http.body.len != 0 ||
        directory.new_nonce_url.len != 8) { ret 2; }

    val invalid_fields: problem.Error = client.parse_directory(
        response(status.BAD_GATEWAY, nil, view.view("failure", 7)), configured,
        ?scratch[0], 256, client.DirectoryStorage{data: ?text[0], capacity: 256,
        caa_items: ?caa[0], caa_capacity: 1}, ?directory);
    if (invalid_fields.kind != problem.PROTOCOL ||
        invalid_fields.code != problem.INVALID_INPUT ||
        invalid_fields.http.status != status.BAD_GATEWAY ||
        invalid_fields.http.body.len != 7 ||
        directory.new_nonce_url.len != 8) { ret 3; }
    ret 0;
}

test "client: badNonce consumes stale state and retries with the fresh response nonce" {
    var slots:         [3]nonce.Slot;
    var nonce_storage: [192]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 3,
        ?nonce_storage[0], 192, 64))) { ret 1; }
    var pool:       nonce.Pool    = nonce.pool(?memory);
    var configured: client.Limits = client.limits_default();
    var protocol:   client.Client;
    if (problem.failed(client.init(?protocol, ?pool, configured)) ||
        problem.failed(pool.put(pool.ctx, view.view("stale_nonce", 11))) ||
        problem.failed(pool.put(pool.ctx, view.view("first_nonce", 11)))) { ret 2; }
    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?request, client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31), use_jwk: false
    }))) { ret 3; }
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0], ?public_bytes[0])) { ret 4; }
    var work:   [2048]u8;
    var output: [512]u8;
    val first:  jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(first.error) || request.state != client.REQUEST_AWAITING ||
        request.attempts != 1) { ret 5; }
    var response_items:  [1]field.Field;
    var response_fields: field.Fields = field.init(?response_items[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?response_fields, field.Field{
        name:      view.view("Replay-Nonce", 12), value: view.view("fresh_nonce", 11),
        sensitive: false
    }) != field.ADD_OK) { ret 6; }
    val body:            *u8             = "{\"type\":\"urn:ietf:params:acme:error:badNonce\",\"title\":\"bad nonce\",\"status\":400,\"detail\":\"retry with a fresh nonce\"}";
    var json_scratch:    [8192]u8;
    var problem_storage: [512]u8;
    val decision:        client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.BAD_REQUEST, ?response_fields,
        view.view(body, length(body))), ?json_scratch[0], 8192,
        client.ProblemStorage{data: ?problem_storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (decision.action != client.ACTION_RETRY_SIGNED ||
        decision.cause.code != problem.BAD_NONCE ||
        decision.cause.http.status != status.BAD_REQUEST ||
        request.state != client.REQUEST_RETRY || request.bad_nonce_retries != 1 ||
        !request.retry_nonce_ready || request.retry_nonce_len != 11 ||
        !equal(?request.retry_nonce[0], "fresh_nonce", 11)) { ret 7; }
    val retry: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(retry.error) || request.attempts != 2 ||
        request.state != client.REQUEST_AWAITING) { ret 8; }
    var nonce_output: [64]u8;
    val remaining:    nonce.Taken = nonce.take(pool, ?nonce_output[0], 64);
    if (problem.failed(remaining.error) || remaining.found) { ret 9; }
    ret 0;
}

test "client: interleaved badNonce recovery remains bound to each request" {
    var slots:         [4]nonce.Slot;
    var nonce_storage: [256]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 4,
        ?nonce_storage[0], 256, 64))) { ret 1; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 2; }
    var first:  client.SignedRequest;
    var second: client.SignedRequest;
    val spec:   client.SignedSpec = client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false
    };
    if (problem.failed(client.begin_signed(?protocol, ?first, spec)) ||
        problem.failed(client.begin_signed(?protocol, ?second, spec)) ||
        problem.failed(pool.put(pool.ctx, view.view("seed_a", 6)))) { ret 3; }

    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 4; }
    val signer:        jose.Signer = jose.signer(public_key);
    var first_work:    [2048]u8;
    var second_work:   [2048]u8;
    var first_output:  [512]u8;
    var second_output: [512]u8;
    if (problem.failed(client.prepare_signed(?protocol, ?first, signer,
        private_key, jose.no_entropy(),
        contracts.Buffer{data: ?first_work[0], capacity: 2048},
        contracts.Buffer{data: ?first_output[0], capacity: 512}).error) ||
        problem.failed(pool.put(pool.ctx, view.view("seed_b", 6))) ||
        problem.failed(client.prepare_signed(?protocol, ?second, signer,
        private_key, jose.no_entropy(),
        contracts.Buffer{data: ?second_work[0], capacity: 2048},
        contracts.Buffer{data: ?second_output[0], capacity: 512}).error)) { ret 5; }

    val body:   *u8          = "{\"type\":\"urn:ietf:params:acme:error:badNonce\",\"detail\":\"retry\"}";
    var item:   [1]field.Field;
    var fields: field.Fields = field.init(?item[0], 1,
        field.limits(1, 128, 32, 64));
    var scratch: [8192]u8;
    var storage: [512]u8;
    if (field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("fresh_a", 7), sensitive: false}) != field.ADD_OK) { ret 6; }
    val first_decision: client.Decision = client.accept_signed_response(?protocol,
        ?first, response(status.BAD_REQUEST, ?fields,
        view.view(body, length(body))), ?scratch[0], 8192,
        client.ProblemStorage{data: ?storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (first_decision.action != client.ACTION_RETRY_SIGNED ||
        first.state != client.REQUEST_RETRY || !first.retry_nonce_ready ||
        first.retry_nonce_len != 7 ||
        !equal(?first.retry_nonce[0], "fresh_a", 7)) { ret 7; }

    if (!field.reset(?fields) ||
        field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("fresh_b", 7), sensitive: false}) != field.ADD_OK) { ret 8; }
    val second_decision: client.Decision = client.accept_signed_response(?protocol,
        ?second, response(status.BAD_REQUEST, ?fields,
        view.view(body, length(body))), ?scratch[0], 8192,
        client.ProblemStorage{data: ?storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (second_decision.action != client.ACTION_RETRY_SIGNED ||
        second.state != client.REQUEST_RETRY || !second.retry_nonce_ready ||
        second.retry_nonce_len != 7 ||
        !equal(?second.retry_nonce[0], "fresh_b", 7) ||
        !first.retry_nonce_ready || first.retry_nonce_len != 7 ||
        !equal(?first.retry_nonce[0], "fresh_a", 7)) { ret 9; }

    var nonce_output: [64]u8;
    val shared_empty: nonce.Taken = nonce.take(pool, ?nonce_output[0], 64);
    if (problem.failed(shared_empty.error) || shared_empty.found) { ret 10; }
    val second_retry: jose.Operation = client.prepare_signed(?protocol, ?second,
        signer, private_key, jose.no_entropy(),
        contracts.Buffer{data: ?second_work[0], capacity: 2048},
        contracts.Buffer{data: ?second_output[0], capacity: 512});
    if (problem.failed(second_retry.error) ||
        second.state != client.REQUEST_AWAITING || second.retry_nonce_ready ||
        second.retry_nonce_len != 0 || !first.retry_nonce_ready ||
        !equal(?first.retry_nonce[0], "fresh_a", 7)) { ret 11; }

    fill(?first_output[0], 0xa5, 512);
    val failed_retry: jose.Operation = client.prepare_signed(?protocol, ?first,
        signer, private_key, jose.no_entropy(),
        contracts.Buffer{data: ?first_work[0], capacity: 2048},
        contracts.Buffer{data: ?first_output[0], capacity: 1});
    if (failed_retry.error.code != problem.OUTPUT_TOO_SMALL ||
        first.state != client.REQUEST_RETRY || !first.retry_nonce_ready ||
        first.retry_nonce_len != 7 ||
        !equal(?first.retry_nonce[0], "fresh_a", 7) ||
        !filled(?first_output[0], 0xa5, 512)) { ret 12; }
    val first_retry: jose.Operation = client.prepare_signed(?protocol, ?first,
        signer, private_key, jose.no_entropy(),
        contracts.Buffer{data: ?first_work[0], capacity: 2048},
        contracts.Buffer{data: ?first_output[0], capacity: 512});
    if (problem.failed(first_retry.error) ||
        first.state != client.REQUEST_AWAITING || first.retry_nonce_ready ||
        first.retry_nonce_len != 0 || first.attempts != 2 ||
        second.attempts != 2) { ret 13; }
    ret 0;
}

test "client: badNonce acquisition and retry exhaustion preserve protocol causes" {
    var slots:         [2]nonce.Slot;
    var nonce_storage: [128]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 2,
        ?nonce_storage[0], 128, 64))) { ret 1; }
    var pool:       nonce.Pool    = nonce.pool(?memory);
    var configured: client.Limits = client.limits_default();
    configured.max_bad_nonce_retries = 1;
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, configured)) ||
        problem.failed(pool.put(pool.ctx, view.view("stale_nonce", 11)))) { ret 2; }
    var request: client.SignedRequest;
    awaiting(?protocol, ?request);
    val body:  *u8 = "{\"type\":\"urn:ietf:params:acme:error:badNonce\",\"title\":\"bad nonce\",\"status\":400}";
    var empty: field.Fields;
    empty_fields(?empty);
    var scratch: [8192]u8;
    var storage: [512]u8;
    val acquire: client.Decision = client.accept_signed_response(?protocol, ?request,
        response(status.BAD_REQUEST, ?empty, view.view(body, length(body))),
        ?scratch[0], 8192, client.ProblemStorage{data: ?storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (acquire.action != client.ACTION_ACQUIRE_NONCE ||
        acquire.cause.code != problem.BAD_NONCE ||
        request.state != client.REQUEST_NEEDS_NONCE || request.bad_nonce_retries != 1) {
        ret 3;
    }
    var nonce_output: [64]u8;
    val stale:        nonce.Taken = nonce.take(pool, ?nonce_output[0], 64);
    if (problem.failed(stale.error) || stale.found) { ret 4; }
    var fresh_items:  [1]field.Field;
    var fresh_fields: field.Fields = field.init(?fresh_items[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?fresh_fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("head_nonce", 10), sensitive: false}) != field.ADD_OK) { ret 5; }
    val accepted: problem.Error = client.accept_nonce_response(?protocol, ?request,
        response(status.NO_CONTENT, ?fresh_fields, view.view(nil, 0)));
    if (problem.failed(accepted) || request.state != client.REQUEST_RETRY ||
        !request.retry_nonce_ready || request.retry_nonce_len != 10 ||
        !equal(?request.retry_nonce[0], "head_nonce", 10)) { ret 6; }

    awaiting(?protocol, ?request);
    request.bad_nonce_retries = 1;
    var limit_items:  [1]field.Field;
    var limit_fields: field.Fields = field.init(?limit_items[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?limit_fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("limit_nonce", 11), sensitive: false}) != field.ADD_OK) { ret 7; }
    val limited: client.Decision = client.accept_signed_response(?protocol, ?request,
        response(status.BAD_REQUEST, ?limit_fields, view.view(body, length(body))),
        ?scratch[0], 8192, client.ProblemStorage{data: ?storage[0], capacity: 512,
        subproblems: nil, subproblem_capacity: 0});
    if (limited.action != client.ACTION_FAILED || limited.cause.code != problem.RETRY_LIMIT ||
        limited.cause.http.status != status.BAD_REQUEST || limited.cause.problem.typ.len == 0 ||
        limited.cause.retryable || request.state != client.REQUEST_FAILED) { ret 8; }
    val remaining: nonce.Taken = nonce.take(pool, ?nonce_output[0], 64);
    if (problem.failed(remaining.error) || remaining.found ||
        request.retry_nonce_ready || request.retry_nonce_len != 0) { ret 9; }
    ret 0;
}

test "client: malformed acme problems retain their http cause transactionally" {
    var slots:         [1]nonce.Slot;
    var nonce_storage: [64]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1,
        ?nonce_storage[0], 64, 64))) { ret 1; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, client.limits_default()))) { ret 2; }
    var request: client.SignedRequest;
    awaiting(?protocol, ?request);
    var fields: field.Fields;
    empty_fields(?fields);
    var scratch: [4096]u8;
    var storage: [64]u8;
    fill(?storage[0], 0xb7, 64);
    val body:     *u8             = "{\"type\":7,\"detail\":\"wrong type\"}";
    val decision: client.Decision = client.accept_signed_response(?protocol, ?request,
        response(status.BAD_REQUEST, ?fields, view.view(body, length(body))),
        ?scratch[0], 4096, client.ProblemStorage{data: ?storage[0], capacity: 64,
        subproblems: nil, subproblem_capacity: 0});
    if (decision.action != client.ACTION_FAILED ||
        decision.cause.code != problem.MALFORMED_JSON ||
        decision.cause.http.status != status.BAD_REQUEST ||
        decision.cause.http.body.len != length(body) ||
        !filled(?storage[0], 0xb7, 64)) { ret 3; }
    awaiting(?protocol, ?request);
    val valid:     *u8             = "{\"type\":\"urn:ietf:params:acme:error:rejectedIdentifier\",\"detail\":\"policy\"}";
    val too_small: client.Decision = client.accept_signed_response(?protocol, ?request,
        response(status.BAD_REQUEST, ?fields, view.view(valid, length(valid))),
        ?scratch[0], 4096, client.ProblemStorage{data: ?storage[0], capacity: 1,
        subproblems: nil, subproblem_capacity: 0});
    if (too_small.action != client.ACTION_FAILED ||
        too_small.cause.code != problem.OUTPUT_TOO_SMALL ||
        too_small.cause.http.status != status.BAD_REQUEST ||
        !filled(?storage[0], 0xb7, 64)) { ret 4; }

    awaiting(?protocol, ?request);
    val compound:         *u8             = "{\"type\":\"urn:ietf:params:acme:error:rejectedIdentifier\",\"detail\":\"order failed\",\"subproblems\":[{\"type\":\"urn:ietf:params:acme:error:dns\",\"detail\":\"dns failed\",\"identifier\":{\"type\":\"dns\",\"value\":\"bad.example\"}}]}";
    var compound_storage: [512]u8;
    var subproblems:      [2]problem.Subproblem;
    val structured:       client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.BAD_REQUEST, ?fields,
        view.view(compound, length(compound))), ?scratch[0], 4096,
        client.ProblemStorage{data: ?compound_storage[0], capacity: 512,
        subproblems: ?subproblems[0], subproblem_capacity: 2});
    if (structured.action != client.ACTION_FAILED ||
        structured.cause.code != problem.ACME_PROBLEM ||
        structured.cause.problem.subproblem_len != 1 ||
        structured.cause.problem.subproblems != ?subproblems[0] ||
        !equal(subproblems[0].identifier.typ.data, "dns", 3) ||
        !equal(subproblems[0].identifier.value.data, "bad.example", 11) ||
        !equal(subproblems[0].detail.data, "dns failed", 10)) { ret 5; }
    ret 0;
}

test "client: invalid and excess response nonces are ignored" {
    var slots:         [1]nonce.Slot;
    var nonce_storage: [64]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1,
        ?nonce_storage[0], 64, 64))) { ret 1; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool, client.limits_default())) ||
        problem.failed(pool.put(pool.ctx, view.view("existing_nonce", 14)))) { ret 2; }
    var items:  [2]field.Field;
    var fields: field.Fields = field.init(?items[0], 2,
        field.limits(2, 256, 32, 64));
    if (field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("bad+nonce", 9), sensitive: false}) != field.ADD_OK) { ret 3; }
    var request: client.SignedRequest;
    awaiting(?protocol, ?request);
    var scratch: [256]u8;
    var storage: [256]u8;
    val invalid: client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.OK, ?fields, view.view(nil, 0)),
        ?scratch[0], 256,
        client.ProblemStorage{data: ?storage[0], capacity: 256,
        subproblems: nil, subproblem_capacity: 0});
    if (invalid.action != client.ACTION_COMPLETE ||
        request.state != client.REQUEST_COMPLETE) { ret 4; }

    if (!field.reset(?fields) ||
        field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("fresh_nonce", 11), sensitive: false}) != field.ADD_OK) { ret 5; }
    awaiting(?protocol, ?request);
    val full: client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.OK, ?fields, view.view(nil, 0)),
        ?scratch[0], 256,
        client.ProblemStorage{data: ?storage[0], capacity: 256,
        subproblems: nil, subproblem_capacity: 0});
    if (full.action != client.ACTION_COMPLETE ||
        request.state != client.REQUEST_COMPLETE) { ret 6; }
    var output:   [64]u8;
    val retained: nonce.Taken = nonce.take(pool, ?output[0], 64);
    if (problem.failed(retained.error) || !retained.found || retained.value.len != 14 ||
        !equal(retained.value.data, "existing_nonce", 14)) { ret 7; }

    if (!field.reset(?fields) ||
        field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("first_nonce", 11), sensitive: false}) != field.ADD_OK ||
        field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("second_nonce", 12), sensitive: false}) != field.ADD_OK) { ret 8; }
    awaiting(?protocol, ?request);
    val multiple: client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.OK, ?fields, view.view(nil, 0)),
        ?scratch[0], 256,
        client.ProblemStorage{data: ?storage[0], capacity: 256,
        subproblems: nil, subproblem_capacity: 0});
    if (multiple.action != client.ACTION_COMPLETE ||
        request.state != client.REQUEST_COMPLETE ||
        nonce.take(pool, ?output[0], 64).found) { ret 9; }
    ret 0;
}

test "client: nonce callbacks preserve immutable descriptors and exact state" {
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }
    val spec: client.SignedSpec = client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false
    };
    var work:   [2048]u8;
    var output: [512]u8;

    var context:  HostilePool;
    var supplied: nonce.Pool = hostile_pool(?context);
    var protocol: client.Client;
    var request:  client.SignedRequest;
    if (problem.failed(client.init(?protocol, ?supplied,
        client.limits_default()))) { ret 2; }
    supplied.reserve = nil;
    supplied.ready   = nil;
    if (problem.failed(client.begin_signed(?protocol, ?request, spec))) { ret 3; }
    val first: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(first.error) || request.state != client.REQUEST_AWAITING ||
        protocol.nonces.reserve::usize == 0 ||
        protocol.nonces.ready::usize == 0) {
        ret 4;
    }

    var item:   [1]field.Field;
    var fields: field.Fields = field.init(?item[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("response_nonce", 14), sensitive: false}) !=
        field.ADD_OK) { ret 5; }
    context.mode    = HOSTILE_PUT_REQUEST;
    context.request = ?request;
    val wire_before:  view.View       = request.wire_body;
    val put_mutation: client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.OK, ?fields, view.view(nil, 0)), nil, 0,
        client.ProblemStorage{data: nil, capacity: 0,
        subproblems: nil, subproblem_capacity: 0});
    if (put_mutation.action != client.ACTION_FAILED ||
        put_mutation.cause.code != problem.INVALID_STATE ||
        request.state != client.REQUEST_FAILED ||
        request.wire_body.data != nil || wire_before.data == nil) { ret 6; }

    context.mode    = HOSTILE_OVERSIZED;
    context.request = nil;
    if (problem.failed(client.begin_signed(?protocol, ?request, spec))) { ret 7; }
    fill(?output[0], 0xa5, 512);
    val oversized: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (oversized.error.code != problem.INVALID_STATE ||
        request.state != client.REQUEST_FAILED || !filled(?output[0], 0xa5, 512)) {
        ret 8;
    }
    context.mode = HOSTILE_FOREIGN;
    if (problem.failed(client.begin_signed(?protocol, ?request, spec))) { ret 9; }
    val foreign: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (foreign.error.code != problem.INVALID_STATE ||
        request.state != client.REQUEST_FAILED || !filled(?output[0], 0xa5, 512)) {
        ret 10;
    }
    context.mode    = HOSTILE_TAKE_REQUEST;
    context.request = ?request;
    if (problem.failed(client.begin_signed(?protocol, ?request, spec))) { ret 11; }
    val request_mutation: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (request_mutation.error.code != problem.INVALID_STATE ||
        request.state != client.REQUEST_FAILED || !filled(?output[0], 0xa5, 512)) {
        ret 12;
    }

    context.mode    = HOSTILE_NORMAL;
    context.request = nil;
    if (problem.failed(client.begin_signed(?protocol, ?request, spec)) ||
        problem.failed(client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error)) { ret 13; }
    context.mode    = HOSTILE_CLEAR_REQUEST;
    context.request = ?request;
    val bad_nonce: *u8 =
        "{\"type\":\"urn:ietf:params:acme:error:badNonce\",\"detail\":\"retry\"}";
    var scratch:        [4096]u8;
    var storage:        [256]u8;
    val clear_mutation: client.Decision = client.accept_signed_response(?protocol,
        ?request, response(status.BAD_REQUEST, ?fields,
        view.view(bad_nonce, length(bad_nonce))), ?scratch[0], 4096,
        client.ProblemStorage{data: ?storage[0], capacity: 256,
        subproblems: nil, subproblem_capacity: 0});
    if (clear_mutation.action != client.ACTION_FAILED ||
        clear_mutation.cause.code != problem.INVALID_STATE ||
        request.state != client.REQUEST_FAILED || request.wire_body.data != nil) {
        ret 14;
    }

    var client_context: HostilePool;
    var client_pool:    nonce.Pool = hostile_pool(?client_context);
    var mutated_client: client.Client;
    var client_request: client.SignedRequest;
    if (problem.failed(client.init(?mutated_client, ?client_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?mutated_client, ?client_request, spec))) {
        ret 15;
    }
    client_context.mode     = HOSTILE_TAKE_CLIENT;
    client_context.protocol = ?mutated_client;
    val client_mutation: jose.Operation = client.prepare_signed(?mutated_client,
        ?client_request, jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (client_mutation.error.code != problem.INVALID_STATE ||
        mutated_client.nonces.reserve::usize != 0 ||
        client_request.state != client.REQUEST_FAILED) { ret 16; }
    ret 0;
}

test "client: nonce provider ownership is disjoint at every callback boundary" {
    var context:  HostilePool;
    var pool:     nonce.Pool = hostile_pool(?context);
    var protocol: client.Client;
    context.owned     = (?protocol)::*u8;
    context.owned_len = $size_of(client.Client);
    if (client.init(?protocol, ?pool, client.limits_default()).code !=
        problem.INVALID_STATE) { ret 1; }

    context.owned     = nil;
    context.owned_len = 0;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 2; }
    var request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?request,
        client.SignedSpec{url: view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false}))) { ret 3; }
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 4; }
    var work:   [2048]u8;
    var output: [512]u8;
    context.owned     = ?work[0];
    context.owned_len = 2048;
    fill(?output[0], 0xa5, 512);
    val rejected: jose.Operation = client.prepare_signed(?protocol, ?request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (rejected.error.code != problem.INVALID_INPUT || rejected.written != 0 ||
        request.state != client.REQUEST_READY || !filled(?output[0], 0xa5, 512)) {
        ret 5;
    }
    ret 0;
}

test "client: provider transactions fail closed before wire publication" {
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }
    val spec: client.SignedSpec = client.SignedSpec{
        url:     view.view("https://example.com/acme/order", 30),
        payload: view.view("{}", 2),
        kid:     view.view("https://example.com/acme/acct/1", 31),
        use_jwk: false
    };
    var work:   [2048]u8;
    var output: [512]u8;

    var reentrant_context: HostilePool;
    reentrant_context.mode = HOSTILE_REENTER;
    var reentrant_pool:    nonce.Pool = hostile_pool(?reentrant_context);
    var reentrant_client:  client.Client;
    var reentrant_request: client.SignedRequest;
    if (problem.failed(client.init(?reentrant_client, ?reentrant_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?reentrant_client,
        ?reentrant_request, spec))) { ret 2; }
    reentrant_context.protocol = ?reentrant_client;
    val reentrant: jose.Operation = client.prepare_signed(?reentrant_client,
        ?reentrant_request, jose.signer(public_key), private_key,
        jose.no_entropy(), contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(reentrant.error) || reentrant_context.reentered ||
        !reentrant_client.initialized ||
        atomic.load(?reentrant_client.callback_owner) != 0 ||
        reentrant_request.state != client.REQUEST_AWAITING ||
        reentrant_context.commit_count != 1) { ret 3; }

    var commit_context: HostilePool;
    commit_context.mode = HOSTILE_COMMIT_FAIL;
    var commit_pool:    nonce.Pool = hostile_pool(?commit_context);
    var commit_client:  client.Client;
    var commit_request: client.SignedRequest;
    if (problem.failed(client.init(?commit_client, ?commit_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?commit_client, ?commit_request,
        spec))) { ret 4; }
    fill(?output[0], 0xa5, 512);
    val commit_failed: jose.Operation = client.prepare_signed(?commit_client,
        ?commit_request, jose.signer(public_key), private_key,
        jose.no_entropy(), contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (commit_failed.error.code != problem.INVALID_STATE ||
        commit_failed.written != 0 || commit_context.commit_count != 1 ||
        commit_request.state != client.REQUEST_FAILED ||
        commit_request.wire_body.data != nil || output[0] != 0) { ret 5; }

    var release_context: HostilePool;
    release_context.mode = HOSTILE_RELEASE_FAIL;
    var release_pool:    nonce.Pool = hostile_pool(?release_context);
    var release_client:  client.Client;
    var release_request: client.SignedRequest;
    if (problem.failed(client.init(?release_client, ?release_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?release_client, ?release_request,
        spec))) { ret 6; }
    fill(?output[0], 0xa5, 512);
    val release_failed: jose.Operation = client.prepare_signed(?release_client,
        ?release_request, jose.signer(public_key), private_key,
        jose.no_entropy(), contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 1});
    if (release_failed.error.code != problem.INVALID_STATE ||
        release_failed.written != 0 || release_context.release_count != 1 ||
        release_request.state != client.REQUEST_FAILED ||
        release_request.wire_body.data != nil || output[0] != 0) {
        ret 7;
    }

    var secret_context: HostilePool;
    secret_context.secret_owner = private_key.secret_owner;
    var secret_pool:    nonce.Pool = hostile_pool(?secret_context);
    var secret_client:  client.Client;
    var secret_request: client.SignedRequest;
    if (problem.failed(client.init(?secret_client, ?secret_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?secret_client, ?secret_request,
        spec))) { ret 8; }
    fill(?output[0], 0xa5, 512);
    val secret_owned: jose.Operation = client.prepare_signed(?secret_client,
        ?secret_request, jose.signer(public_key), private_key,
        jose.no_entropy(), contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (secret_owned.error.code != problem.INVALID_INPUT ||
        secret_owned.written != 0 || secret_request.state != client.REQUEST_READY ||
        secret_context.commit_count != 0 || secret_context.release_count != 0 ||
        !filled(?output[0], 0xa5, 512)) { ret 9; }

    var response_context: HostilePool;
    var response_pool:    nonce.Pool = hostile_pool(?response_context);
    var response_client:  client.Client;
    var response_request: client.SignedRequest;
    if (problem.failed(client.init(?response_client, ?response_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?response_client, ?response_request,
        spec)) ||
        problem.failed(client.prepare_signed(?response_client,
        ?response_request, jose.signer(public_key), private_key,
        jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error)) { ret 10; }
    var item:   [1]field.Field;
    var fields: field.Fields = field.init(?item[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?fields, field.Field{name: view.view("Replay-Nonce", 12),
        value: view.view("response_nonce", 14), sensitive: false}) !=
        field.ADD_OK) { ret 11; }
    response_context.mode = HOSTILE_PUT_FAIL;
    val response_failed: client.Decision = client.accept_signed_response(
        ?response_client, ?response_request,
        response(status.OK, ?fields, view.view(nil, 0)), nil, 0,
        client.ProblemStorage{data: nil, capacity: 0,
        subproblems: nil, subproblem_capacity: 0});
    if (response_failed.action != client.ACTION_FAILED ||
        response_failed.cause.code != problem.INVALID_STATE ||
        response_request.state != client.REQUEST_FAILED ||
        response_request.wire_body.data != nil) { ret 12; }

    var payload:          [2]u8             = [2]u8{'{', '}'};
    var mutation_context: HostilePool;
    var mutation_pool:    nonce.Pool        = hostile_pool(?mutation_context);
    var mutation_client:  client.Client;
    var mutation_request: client.SignedRequest;
    val mutation_spec:    client.SignedSpec = client.SignedSpec{url: spec.url,
        payload: view.view(?payload[0], 2), kid: spec.kid, use_jwk: false};
    if (problem.failed(client.init(?mutation_client, ?mutation_pool,
        client.limits_default())) ||
        problem.failed(client.begin_signed(?mutation_client, ?mutation_request,
        mutation_spec)) ||
        problem.failed(client.prepare_signed(?mutation_client,
        ?mutation_request, jose.signer(public_key), private_key,
        jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error)) { ret 13; }
    payload[0] = '[';
    var empty: field.Fields;
    empty_fields(?empty);
    val changed: client.Decision = client.accept_signed_response(
        ?mutation_client, ?mutation_request,
        response(status.OK, ?empty, view.view(nil, 0)), nil, 0,
        client.ProblemStorage{data: nil, capacity: 0,
        subproblems: nil, subproblem_capacity: 0});
    if (changed.action != client.ACTION_FAILED ||
        changed.cause.code != problem.INVALID_STATE ||
        mutation_request.state != client.REQUEST_FAILED ||
        mutation_request.wire_body.data != nil) { ret 14; }
    ret 0;
}

test "client: callback boundaries serialize concurrent requests" {
    var slots:         [4]nonce.Slot;
    var nonce_storage: [256]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 4,
        ?nonce_storage[0], 256, 64))) { ret 1; }
    var pool:     nonce.Pool = nonce.pool(?memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 2; }
    var first:  client.SignedRequest;
    var second: client.SignedRequest;
    awaiting(?protocol, ?first);
    awaiting(?protocol, ?second);
    var first_item:   [1]field.Field;
    var second_item:  [1]field.Field;
    var first_fields: field.Fields = field.init(?first_item[0], 1,
        field.limits(1, 128, 32, 64));
    var second_fields: field.Fields = field.init(?second_item[0], 1,
        field.limits(1, 128, 32, 64));
    if (field.append(?first_fields, field.Field{
        name:  view.view("Replay-Nonce", 12),
        value: view.view("concurrent_one", 14), sensitive: false
    }) !=
        field.ADD_OK ||
        field.append(?second_fields, field.Field{
        name:  view.view("Replay-Nonce", 12),
        value: view.view("concurrent_two", 14), sensitive: false
    }) !=
        field.ADD_OK) { ret 3; }
    var first_result:  i64           = 0;
    var second_result: i64           = 0;
    var first_context: AcceptContext = AcceptContext{protocol: ?protocol,
        request: ?first, fields: ?first_fields, result: ?first_result};
    var second_context: AcceptContext = AcceptContext{protocol: ?protocol,
        request: ?second, fields: ?second_fields, result: ?second_result};
    var first_thread:  thread.Thread;
    var second_thread: thread.Thread;
    thread.spawn_with(accept_worker, (?first_context)::*u8, ?first_thread);
    if (first_thread.tid < 0) { ret 4; }
    thread.spawn_with(accept_worker, (?second_context)::*u8, ?second_thread);
    if (second_thread.tid < 0) {
        thread.join(?first_thread);
        ret 5;
    }
    thread.join(?first_thread);
    thread.join(?second_thread);
    if (atomic.load(?first_result) != 1)            { ret 6; }
    if (atomic.load(?second_result) != 1)           { ret 8; }
    if (first.state != client.REQUEST_COMPLETE)     { ret 9; }
    if (second.state != client.REQUEST_COMPLETE)    { ret 10; }
    if (atomic.load(?protocol.callback_owner) != 0) { ret 11; }
    var output: [64]u8;
    val newest: nonce.Taken = nonce.take(pool, ?output[0], 64);
    val older:  nonce.Taken = nonce.take(pool, ?output[0], 64);
    if (problem.failed(newest.error) || !newest.found ||
        problem.failed(older.error) || !older.found ||
        nonce.take(pool, ?output[0], 64).found) { ret 7; }
    ret 0;
}

test "client: signed url payload and kid are immutably bound" {
    var slots:         [1]nonce.Slot;
    var nonce_storage: [64]u8;
    var memory:        nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1,
        ?nonce_storage[0], 64, 64))) { ret 1; }
    var pool: nonce.Pool = nonce.pool(?memory);
    if (problem.failed(pool.put(pool.ctx, view.view("binding_nonce", 13)))) {
        ret 2;
    }
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 3; }
    var url:     [30]u8;
    var payload: [2]u8;
    var kid:     [31]u8;
    copy(?url[0], "https://example.com/acme/order", 30);
    copy(?payload[0], "{}", 2);
    copy(?kid[0], "https://example.com/acme/acct/1", 31);
    val spec: client.SignedSpec = client.SignedSpec{
        url: view.view(?url[0], 30), payload: view.view(?payload[0], 2),
        kid: view.view(?kid[0], 31), use_jwk: false
    };
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 4; }
    var work:   [2048]u8;
    var output: [512]u8;

    var url_request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?url_request, spec))) {
        ret 5;
    }
    url[8] = 'f';
    fill(?output[0], 0xa5, 512);
    if (client.prepare_signed(?protocol, ?url_request, jose.signer(public_key),
        private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_STATE || !filled(?output[0], 0xa5, 512)) { ret 6; }
    url[8] = 'e';

    var payload_request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?payload_request, spec))) {
        ret 7;
    }
    payload[0] = '[';
    if (client.prepare_signed(?protocol, ?payload_request,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_STATE || !filled(?output[0], 0xa5, 512)) { ret 8; }
    payload[0] = '{';

    var kid_request: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?kid_request, spec))) {
        ret 9;
    }
    kid[8] = 'f';
    if (client.prepare_signed(?protocol, ?kid_request, jose.signer(public_key),
        private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_STATE || !filled(?output[0], 0xa5, 512)) { ret 10; }
    kid[8] = 'e';

    var prepared: client.SignedRequest;
    if (problem.failed(client.begin_signed(?protocol, ?prepared, spec)) ||
        problem.failed(client.prepare_signed(?protocol, ?prepared,
        jose.signer(public_key), private_key, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error)) { ret 11; }
    url[8] = 'f';
    if (!problem.failed(client.signed_wire(?protocol, ?prepared).error)) { ret 12; }
    url[8]     = 'e';
    payload[0] = '[';
    if (!problem.failed(client.signed_wire(?protocol, ?prepared).error)) { ret 13; }
    payload[0] = '{';
    kid[8]     = 'f';
    if (!problem.failed(client.signed_wire(?protocol, ?prepared).error)) { ret 14; }
    kid[8] = 'e';
    var other_secret:  [32]^u8;
    var other_public:  [65]u8;
    var other_key:     jose.PublicKey;
    var other_private: jose.PrivateKey;
    if (!es_keys(?other_key, ?other_private, ?other_secret[0],
        ?other_public[0])) { ret 15; }
    other_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?other_secret[0], len: 32},
        contracts.Buffer{data: ?other_public[0], capacity: 65}).error !=
        contracts.OK) { ret 16; }
    other_key.value     = contracts.Bytes{data: ?other_public[0], len: 65};
    other_private.value = contracts.SecretBytes{data: ?other_secret[0], len: 32};
    var bound_request: client.SignedRequest;
    if (problem.failed(client.begin_signed_bound(?protocol, ?bound_request,
        spec, jose.signer(public_key)))) { ret 17; }
    fill(?output[0], 0xa5, 512);
    if (client.prepare_signed(?protocol, ?bound_request, jose.signer(other_key),
        other_private, jose.no_entropy(),
        contracts.Buffer{data: ?work[0], capacity: 2048},
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_STATE || !filled(?output[0], 0xa5, 512)) { ret 18; }
    ret 0;
}

test "nonce: hostile values, duplicates, and small outputs are transactional" {
    var slots:   [1]nonce.Slot;
    var storage: [16]u8;
    var memory:  nonce.Memory;
    if (problem.failed(nonce.init_memory(?memory, ?slots[0], 1, ?storage[0], 16, 16))) {
        ret 1;
    }
    val pool: nonce.Pool = nonce.pool(?memory);
    if (pool.put(pool.ctx, view.view("bad+nonce", 9)).code != problem.INVALID_INPUT ||
        problem.failed(pool.put(pool.ctx, view.view("valid_nonce", 11))) ||
        pool.put(pool.ctx, view.view("valid_nonce", 11)).code != problem.DUPLICATE_NONCE) {
        ret 2;
    }
    var output: [16]u8;
    fill(?output[0], 0xcc, 16);
    val small: nonce.Taken = nonce.take(pool, ?output[0], 4);
    if (small.error.code != problem.OUTPUT_TOO_SMALL || small.found ||
        !filled(?output[0], 0xcc, 16)) { ret 3; }
    val taken: nonce.Taken = nonce.take(pool, ?output[0], 16);
    if (problem.failed(taken.error) || !taken.found || taken.value.len != 11) { ret 4; }
    val exhausted: nonce.Taken = nonce.take(pool, ?output[0], 16);
    if (problem.failed(exhausted.error) || exhausted.found) { ret 5; }
    ret 0;
}

rec AccountStore {
    anchor:                  u8;
    gate:                    storage.Gate;
    current:                 account.Credentials;
    pending:                 account.Credentials;
    manager:                 *storage.Manager;
    token:                   u64;
    found:                   bool;
    transaction_active:      bool;
    pending_ready:           bool;
    ready:                   bool;
    commit_unknown:          bool;
    reenter:                 bool;
    reentry_rejected:        bool;
    load_calls:              i64;
    load_active:             i64;
    load_overlap:            i64;
    owned:                   *u8;
    owned_len:               usize;
    mutate:                  *u8;
    mutate_on_begin:         *u8;
    loaded_snapshot:         *storage.Snapshot;
    mutate_snapshot:         bool;
    snapshot_mutation_armed: bool;
    reuse_token:             bool;
    abort_status:            storage.Status;
    begin_status:            storage.Status;
    mutate_manager:          bool;
    mutate_output:           *u8;
    load_status:             storage.Status;
    persistent:              bool;
    path:                    *u8;
}

fun disk_u64_write(data: *u8, offset: usize, value: u64) {
    var i: usize = 0;
    for (i < 8) {
        data[offset + i] = (value >> (i::u64 * 8))::u8;
        i                = i + 1;
    }
}

fun disk_u64_read(data: *u8, offset: usize) u64 {
    var value: u64   = 0;
    var i:     usize = 0;
    for (i < 8) {
        value = value | ((data[offset + i]::u64) << (i::u64 * 8));
        i     = i + 1;
    }
    ret value;
}

fun disk_checksum(data: *u8, len: usize) u64 {
    var result: u64   = 0xcbf29ce484222325;
    var i:      usize = 0;
    for (i < len) {
        result = (result ^ data[i]::u64) * 0x100000001b3;
        i      = i + 1;
    }
    ret result;
}

fun account_store_persist(value: *AccountStore) bool {
    if (!value.persistent) { ret true; }
    var record: [48]u8;
    copy(?record[0], "MACACME1", 8);
    record[8] = 0;
    if (value.found)              { record[8] = record[8] | 1; }
    if (value.transaction_active) { record[8] = record[8] | 2; }
    if (value.pending_ready)      { record[8] = record[8] | 4; }
    disk_u64_write(?record[0], 16, value.token);
    var current_generation: u64 = 0;
    var pending_generation: u64 = 0;
    if (value.found)         { current_generation = value.current.generation; }
    if (value.pending_ready) { pending_generation = value.pending.generation; }
    disk_u64_write(?record[0], 24, current_generation);
    disk_u64_write(?record[0], 32, pending_generation);
    disk_u64_write(?record[0], 40, disk_checksum(?record[0], 40));
    var allocator_bytes: [4096]u8;
    var allocator_state: fixed.FixedState;
    var allocator:       A.Allocator;
    if (!fixed_ok(fixed.make(?allocator, ?allocator_state,
        ?allocator_bytes[0], 4096))) { ret false; }
    ret fs_ok(fs.replace_bytes_atomic(?allocator, value.path,
        ?record[0], 48, 384, 448));
}

fun account_store_reload(value: *AccountStore) bool {
    if (!value.persistent || !file_exists(value.path)) { ret true; }
    val opened: res[fs.File, IO.Error] = fs.open(value.path);
    if (sel opened.err) { ret false; }
    var file:     fs.File = opened.ok;
    var record:   [49]u8;
    var position: usize   = 0;
    var valid:    bool    = true;
    for (position < 48 && valid) {
        val read: res[usize, IO.Error] = fs.read(file,
            ?record[position], 48 - position);
        if (sel read.err) { valid = false; }
        if (sel read.ok) {
            val count: usize = read.ok;
            if (count == 0) { valid = false; }
            or              { position = position + count; }
        }
    }
    if (valid) {
        val extra: res[usize, IO.Error] = fs.read(file, ?record[48], 1);
        valid = (sel extra.ok) &&
            extra.ok == 0;
    }
    fs.close(?file);
    if (!valid || position != 48 || !equal(?record[0], "MACACME1", 8) ||
        disk_u64_read(?record[0], 40) != disk_checksum(?record[0], 40) ||
        (record[8] & ~7) != 0) { ret false; }
    val found:              bool = (record[8] & 1) != 0;
    val active:             bool = (record[8] & 2) != 0;
    val pending:            bool = (record[8] & 4) != 0;
    val current_generation: u64  = disk_u64_read(?record[0], 24);
    val pending_generation: u64  = disk_u64_read(?record[0], 32);
    if ((found && value.current.generation != current_generation) ||
        (!found && current_generation != 0) ||
        (pending && value.pending.generation != pending_generation) ||
        (!pending && pending_generation != 0) || (pending && !active)) {
        ret false;
    }
    value.token              = disk_u64_read(?record[0], 16);
    value.found              = found;
    value.transaction_active = active;
    value.pending_ready      = pending;
    ret true;
}

fun account_store_ready(ctx: ptr) bool {
    val value: *AccountStore = ctx::*AccountStore;
    if (value.mutate_output != nil) {
        value.mutate_output[0] = value.mutate_output[0] ^ 1;
        value.mutate_output    = nil;
    }
    if (value.mutate_manager && value.manager != nil) {
        value.manager.gate.last_token = value.manager.gate.last_token + 1;
        value.mutate_manager          = false;
    }
    ret value.ready;
}

fun account_store_aliases(ctx: ptr, data: *u8, len: usize) bool {
    val value: *AccountStore = ctx::*AccountStore;
    if (value.mutate_snapshot && value.snapshot_mutation_armed &&
        value.loaded_snapshot != nil) {
        value.loaded_snapshot.has_pending = !value.loaded_snapshot.has_pending;
        value.mutate_snapshot             = false;
        value.snapshot_mutation_armed     = false;
    }
    ret memory_range.overlap(data, len, value::*u8, $size_of(AccountStore)) ||
        memory_range.overlap(data, len, value.owned, value.owned_len) ||
        (value.found && account.credentials_overlap(value.current, data, len)) ||
        (value.pending_ready &&
        account.credentials_overlap(value.pending, data, len));
}

fun account_store_owns_secret(ctx: ptr, owner: ptr) bool {
    val value: *AccountStore = ctx::*AccountStore;
    ret (value.found && owner == value.current.secret_owner) ||
        (value.pending_ready && owner == value.pending.secret_owner);
}

fun account_store_begin(ctx: ptr, url: view.View,
    generation: u64) storage.BeginResult {
    val value: *AccountStore = ctx::*AccountStore;
    if (value.reenter && value.manager != nil) {
        var nested: storage.Snapshot;
        val result: problem.Error = storage.recover(value.manager, url, ?nested);
        value.reentry_rejected = result.code == problem.INVALID_INPUT &&
            atomic.load(?value.load_calls) == 0;
    }
    if (!value.ready || value.transaction_active ||
        (generation == 0 && value.found) ||
        (generation != 0 && (!value.found ||
        generation != value.current.generation))) {
        ret storage.BeginResult{status: storage.CONFLICT};
    }
    if (!value.reuse_token || value.token == 0) {
        value.token = value.token + 1;
    }
    value.transaction_active = true;
    if (value.mutate_on_begin != nil) {
        value.mutate_on_begin[0] = value.mutate_on_begin[0] ^ 1;
    }
    var result_status: storage.Status = storage.SUCCESS;
    if (value.begin_status != 0)       { result_status = value.begin_status; }
    if (!account_store_persist(value)) { result_status = storage.FAILED; }
    ret storage.BeginResult{status: result_status,
        transaction: storage.Transaction{owner: ctx, token: value.token,
        generation:  generation}};
}

fun account_store_stage(ctx: ptr, transaction: storage.Transaction,
    replacement: account.Credentials) storage.Status {
    val value: *AccountStore = ctx::*AccountStore;
    if (transaction.owner != ctx || transaction.token != value.token ||
        !value.transaction_active ||
        (transaction.generation == 0 && value.found) ||
        (transaction.generation != 0 && (!value.found ||
        transaction.generation != value.current.generation)) ||
        value.pending_ready) { ret storage.CONFLICT; }
    value.pending       = replacement;
    value.pending_ready = true;
    if (value.mutate != nil) {
        value.mutate[0] = value.mutate[0] ^ 1;
    }
    if (!account_store_persist(value)) { ret storage.UNKNOWN; }
    ret storage.SUCCESS;
}

fun account_store_commit(ctx: ptr,
    transaction: storage.Transaction) storage.Status {
    val value: *AccountStore = ctx::*AccountStore;
    if (transaction.owner != ctx || transaction.token != value.token ||
        !value.transaction_active || !value.pending_ready) {
        ret storage.CONFLICT;
    }
    if (value.commit_unknown) { ret storage.UNKNOWN; }
    value.current            = value.pending;
    value.found              = true;
    value.pending_ready      = false;
    value.transaction_active = false;
    if (!account_store_persist(value)) { ret storage.UNKNOWN; }
    ret storage.SUCCESS;
}

fun account_store_abort(ctx: ptr,
    transaction: storage.Transaction) storage.Status {
    val value: *AccountStore = ctx::*AccountStore;
    if (transaction.owner != ctx || transaction.token != value.token ||
        !value.transaction_active) { ret storage.CONFLICT; }
    if (value.abort_status != 0 && value.abort_status != storage.SUCCESS) {
        ret value.abort_status;
    }
    value.pending_ready      = false;
    value.transaction_active = false;
    if (!account_store_persist(value)) { ret storage.UNKNOWN; }
    ret storage.SUCCESS;
}

fun account_store_load(ctx: ptr, url: view.View,
    output: *storage.Snapshot) storage.Status {
    val value: *AccountStore = ctx::*AccountStore;
    atomic.fetch_add(?value.load_calls, 1);
    if (atomic.fetch_add(?value.load_active, 1) != 0) {
        atomic.store(?value.load_overlap, 1);
    }
    var spin: usize = 0;
    for (spin < 10000) {
        atomic.load(?value.load_active);
        spin = spin + 1;
    }
    var result: storage.Snapshot;
    if (!account_store_reload(value)) {
        result.status = storage.FAILED;
        @output       = result;
        atomic.fetch_sub(?value.load_active, 1);
        ret storage.FAILED;
    }
    if (value.load_status != 0) {
        result.status = value.load_status;
        @output       = result;
        atomic.fetch_sub(?value.load_active, 1);
        ret value.load_status;
    }
    value.loaded_snapshot = output;
    if (value.mutate_snapshot) { value.snapshot_mutation_armed = true; }
    if (!value.found) {
        result.status      = storage.NOT_FOUND;
        result.has_pending = value.pending_ready;
        if (value.pending_ready) {
            result.pending     = value.pending;
            result.transaction = storage.Transaction{owner: ctx,
                token: value.token, generation: 0};
        }
        @output = result;
    }
    or {
        result.status      = storage.SUCCESS;
        result.current     = value.current;
        result.has_pending = value.pending_ready;
        if (value.pending_ready) {
            result.pending     = value.pending;
            result.transaction = storage.Transaction{owner: ctx,
                token: value.token, generation: value.current.generation};
        }
        @output = result;
    }
    atomic.fetch_sub(?value.load_active, 1);
    ret result.status;
}

fun account_store(value: *AccountStore) storage.Store {
    ret storage.Store{ctx: value::ptr, context_anchor: ?value.anchor,
        context_size:     $size_of(AccountStore), gate: ?value.gate,
        ready:            account_store_ready,
        aliases:          account_store_aliases, owns_secret: account_store_owns_secret,
        begin:            account_store_begin, stage: account_store_stage,
        commit:           account_store_commit, abort: account_store_abort,
        load:             account_store_load, stage_certificate: nil,
        load_certificate: nil};
}

fun credentials(key: jose.PublicKey, owner: ptr,
    generation: u64) account.Credentials {
    ret account.Credentials{account: account.Account{
        url:                     view.view("https://example.com/acme/acct/1", 31),
        status:                  account.VALID, contacts: nil, contact_len: 0,
        orders_url:              view.view("https://example.com/acme/acct/1/orders", 38),
        terms_of_service_agreed: true
    }, signer: jose.signer(key),
        secret_owner: owner, generation: generation};
}

rec RecoverContext {
    manager:  *storage.Manager;
    url:      view.View;
    snapshot: *storage.Snapshot;
    result:   *i64;
}

fun recover_worker(arg: *u8) {
    val context: *RecoverContext = arg::*RecoverContext;
    if (!problem.failed(storage.recover(context.manager, context.url,
        context.snapshot))) {
        atomic.store(context.result, 1);
    }
    or { atomic.store(context.result, -1); }
}

test "account: lifecycle payloads are exact and reject aliases" {
    var contacts: [2]view.View = [2]view.View{
        view.view("mailto:one@example.com", 22),
        view.view("mailto:two@example.com", 22)
    };
    var output: [512]u8;
    val create: account.Operation = account.encode(account.CREATE,
        account.Request{contacts: ?contacts[0], contact_len: 2,
        terms_of_service_agreed:  true, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    val expected: *u8 = "{\"contact\":[\"mailto:one@example.com\",\"mailto:two@example.com\"],\"termsOfServiceAgreed\":true}";
    if (problem.failed(create.error))                 { ret 10; }
    if (create.written != length(expected))           { ret 11; }
    if (!equal(?output[0], expected, create.written)) { ret 12; }
    val lookup: account.Operation = account.encode(account.LOOKUP,
        account.Request{contacts: nil, contact_len: 0,
        terms_of_service_agreed:  false, only_return_existing: true,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(lookup.error))                            { ret 30 + lookup.error.code::i32; }
    if (lookup.written != 27)                                    { ret 21; }
    if (!equal(?output[0], "{\"onlyReturnExisting\":true}", 27)) { ret 22; }
    var slots:        [1]nonce.Slot;
    var nonce_bytes:  [64]u8;
    var nonce_memory: nonce.Memory;
    if (problem.failed(nonce.init_memory(?nonce_memory, ?slots[0], 1,
        ?nonce_bytes[0], 64, 64))) { ret 23; }
    var pool:     nonce.Pool = nonce.pool(?nonce_memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 21; }
    val public_bytes: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    val signer: jose.Signer = jose.signer(jose.PublicKey{
        algorithm: jose.EDDSA,
        value:     contracts.Bytes{data: (?public_bytes[0]):~*u8, len: 32}
    });
    var lookup_state: client.SignedRequest;
    output[0] = output[0] ^ 1;
    if (account.begin(?protocol, ?lookup_state, account.LOOKUP,
        view.view("https://example.com/acme/new-account", 36),
        view.view(nil, 0), view.view(?output[0], lookup.written), lookup,
        signer).code != problem.INVALID_INPUT) { ret 23; }
    output[0] = output[0] ^ 1;
    if (problem.failed(account.begin(?protocol, ?lookup_state, account.LOOKUP,
        view.view("https://example.com/acme/new-account", 36),
        view.view(nil, 0), view.view(?output[0], lookup.written), lookup,
        signer)) ||
        !lookup_state.spec.use_jwk) { ret 22; }
    val empty_contacts: account.Operation = account.encode(account.UPDATE_CONTACT,
        account.Request{contacts: nil, contact_len: 0,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(empty_contacts.error) || empty_contacts.written != 14 ||
        !equal(?output[0], "{\"contact\":[]}", 14)) { ret 3; }
    var update_state: client.SignedRequest;
    if (problem.failed(account.begin(?protocol, ?update_state,
        account.UPDATE_CONTACT,
        view.view("https://example.com/acme/acct/1", 31),
        view.view("https://example.com/acme/acct/1", 31),
        view.view(?output[0], empty_contacts.written), empty_contacts,
        signer)) ||
        update_state.spec.use_jwk) { ret 4; }
    val terms: account.Operation = account.encode(account.AGREE_TERMS,
        account.Request{contacts: nil, contact_len: 0,
        terms_of_service_agreed:  true, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(terms.error) || terms.written != 29 ||
        !equal(?output[0], "{\"termsOfServiceAgreed\":true}", 29)) { ret 5; }
    val deactivate: account.Operation = account.encode(account.DEACTIVATE,
        account.Request{contacts: nil, contact_len: 0,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (problem.failed(deactivate.error))                       { ret 61; }
    if (deactivate.written != 24)                               { ret 62; }
    if (!equal(?output[0], "{\"status\":\"deactivated\"}", 24)) { ret 63; }
    fill(?output[0], 0xa5, 512);
    val invalid_binding: *u8 =
        "{\"protected\":\"aa\",\"payload\":\"aa\",\"signature\":\"aa\"}";
    if (external_account.encoded_valid(view.view(invalid_binding,
        length(invalid_binding)))) { ret 7; }
    val aliased: account.Operation = account.encode(account.UPDATE_CONTACT,
        account.Request{contacts: (?output[0])::*view.View, contact_len: 1,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (aliased.error.code != problem.INVALID_INPUT ||
        !filled(?output[0], 0xa5, 512)) { ret 8; }
    var invalid_contacts: [1]view.View;
    invalid_contacts[0] = view.view("mailto:a@example.com,b@example.com", 34);
    if (account.encode(account.CREATE, account.Request{
        contacts:                 ?invalid_contacts[0], contact_len: 1,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()
    },
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT) { ret 9; }
    invalid_contacts[0] = view.view("mailto:a@example.com?subject=x", 30);
    if (account.encode(account.CREATE, account.Request{
        contacts:                 ?invalid_contacts[0], contact_len: 1,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()
    },
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT) { ret 13; }
    val malformed_percent: *u8    = "https://example.com/%zz";
    val malformed_quote:   *u8    = "https://example.com/a\"b";
    val misplaced_bracket: *u8    = "https://example.com/a[b]";
    val mailto_path:       *u8    = "mailto:a@example.com/path";
    val mailto_dot:        *u8    = "mailto:.a@example.com";
    var invalid_values:    [5]*u8 = [5]*u8{malformed_percent,
        malformed_quote, misplaced_bracket, mailto_path, mailto_dot};
    var invalid_index: usize = 0;
    for (invalid_index < 5) {
        invalid_contacts[0] = view.view(invalid_values[invalid_index],
            length(invalid_values[invalid_index]));
        if (account.encode(account.CREATE, account.Request{
            contacts:                 ?invalid_contacts[0], contact_len: 1,
            terms_of_service_agreed:  false, only_return_existing: false,
            external_account_binding: external_account.none()
        },
            contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
            problem.INVALID_INPUT) { ret 14 + invalid_index::i32; }
        invalid_index = invalid_index + 1;
    }
    ret 0;
}

test "account: public contact bounds encode without a hidden ceiling" {
    var text: [4096]u8;
    copy(?text[0], "https:", 6);
    var i: usize = 6;
    for (i < 4096) {
        text[i] = 'a';
        i       = i + 1;
    }
    var contacts: [64]view.View;
    i = 0;
    for (i < 64) {
        contacts[i] = view.view(?text[0], 4096);
        i           = i + 1;
    }
    var output:  [270000]u8;
    val encoded: account.Operation = account.encode(account.CREATE,
        account.Request{contacts: ?contacts[0], contact_len: 64,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 270000});
    if (problem.failed(encoded.error) || encoded.written != 262349) { ret 1; }
    fill(?output[0], 0xa5, 128);
    val small: account.Operation = account.encode(account.CREATE,
        account.Request{contacts: ?contacts[0], contact_len: 64,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: external_account.none()},
        contracts.Buffer{data: ?output[0], capacity: 128});
    if (small.error.kind != problem.LIMIT ||
        small.error.code != problem.OUTPUT_TOO_SMALL ||
        !filled(?output[0], 0xa5, 128)) { ret 2; }
    ret 0;
}

test "account: response decoding is bounded and transactional" {
    val body:     *u8            = "{\"status\":\"valid\",\"contact\":[\"mailto:one@example.com\"],\"orders\":\"https://example.com/acme/acct/1/orders\",\"termsOfServiceAgreed\":true}";
    var fields:   field.Fields   = field.init(nil, 0, field.limits(0, 0, 0, 0));
    var scratch:  [8192]u8;
    var text:     [256]u8;
    var contacts: [2]view.View;
    var result:   account.Account;
    val limits:   account.Limits = account.Limits{max_response_bytes: 2048,
        max_json_scratch:   8192, max_json_depth: 4, max_json_values: 32,
        max_json_key_bytes: 64, max_json_key_comparisons: 64,
        max_url_bytes:      256, max_contacts: 2, max_contact_bytes: 64,
        response_fields:    field.limits(0, 0, 0, 0)};
    val parsed: problem.Error = account.parse(account.UPDATE_CONTACT,
        response(status.OK, ?fields,
        view.view(body, length(body))),
        view.view("https://example.com/acme/acct/1", 31), limits,
        ?scratch[0], 8192, account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result);
    if (problem.failed(parsed) || result.status != account.VALID ||
        result.contact_len != 1 || result.orders_url.len != 38 ||
        !result.terms_of_service_agreed) { ret 1; }
    fill(?text[0], 0x6b, 256);
    val invalid: *u8 = "{\"status\":\"valid\",\"contact\":[\"not-a-uri\"],\"orders\":\"https://example.com/orders\"}";
    if (account.parse(account.UPDATE_CONTACT, response(status.OK, ?fields,
        view.view(invalid, length(invalid))),
        view.view("https://example.com/acme/acct/1", 31), limits,
        ?scratch[0], 8192, account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result).code !=
        problem.MALFORMED_JSON || !filled(?text[0], 0x6b, 256)) { ret 2; }
    var location_item:  [1]field.Field;
    var created_fields: field.Fields = field.init(?location_item[0], 1,
        field.limits(1, 128, 16, 96));
    if (field.append(?created_fields, field.Field{
        name:      view.view("Location", 8),
        value:     view.view("https://example.com/acme/acct/2", 31),
        sensitive: false
    }) != field.ADD_OK) { ret 3; }
    var created_limits: account.Limits = limits;
    created_limits.response_fields = field.limits(1, 128, 16, 96);
    if (problem.failed(account.parse(account.CREATE,
        response(status.CREATED, ?created_fields,
        view.view(body, length(body))), view.view(nil, 0), created_limits,
        ?scratch[0], 8192, account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result)) ||
        result.url.len != 31 ||
        !equal(result.url.data, "https://example.com/acme/acct/2", 31) ||
        result.url.data != ?text[0]) { ret 4; }
    if (problem.failed(account.parse(account.LOOKUP,
        response(status.OK, ?created_fields, view.view(body, length(body))),
        view.view(nil, 0), created_limits, ?scratch[0], 8192,
        account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result)) ||
        result.url.len != 31 || result.url.data != ?text[0]) { ret 5; }
    val deactivated_body: *u8 =
        "{\"status\":\"deactivated\",\"orders\":\"https://example.com/orders\"}";
    if (account.parse(account.CREATE,
        response(status.CREATED, ?created_fields,
        view.view(deactivated_body, length(deactivated_body))),
        view.view(nil, 0), created_limits, ?scratch[0], 8192,
        account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result).code !=
        problem.MALFORMED_JSON) { ret 6; }
    if (account.parse(account.DEACTIVATE,
        response(status.OK, ?created_fields, view.view(body, length(body))),
        view.view("https://example.com/acme/acct/1", 31), created_limits,
        ?scratch[0], 8192, account.Storage{data: ?text[0], capacity: 256,
        contacts: ?contacts[0], contact_capacity: 2}, ?result).code !=
        problem.MALFORMED_JSON) { ret 7; }
    ret 0;
}

test "external account: configured mac algorithms and ownership are exact" {
    val public_bytes: [32]u8 = [32]u8{
        0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
        0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
        0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
        0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a
    };
    val key: jose.PublicKey = jose.PublicKey{algorithm: jose.EDDSA,
        value: contracts.Bytes{data: (?public_bytes[0]):~*u8, len: 32}};
    var secret: [16]^u8;
    var i:      usize = 0;
    for (i < 16) {
        secret[i] = i::u8;
        i         = i + 1;
    }
    var work:    [4096]u8;
    var output:  [1024]u8;
    val binding: external_account.Binding = external_account.Binding{
        algorithm:    external_account.HS256, key_id: view.view("kid-1", 5),
        mac_key:      contracts.SecretBytes{data: ?secret[0], len: 16},
        secret_owner: ?secret[0]
    };
    val encoded: external_account.Operation = external_account.encode(binding,
        key, view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024});
    val hs256_expected: *u8 = "{\"protected\":\"eyJhbGciOiJIUzI1NiIsImtpZCI6ImtpZC0xIiwidXJsIjoiaHR0cHM6Ly9leGFtcGxlLmNvbS9hY21lL25ldy1hY2NvdW50In0\",\"payload\":\"eyJjcnYiOiJFZDI1NTE5Iiwia3R5IjoiT0tQIiwieCI6IjExcVlBWUt4Q3JmVlNfN1R5V1FIT2c3aGN2UGFwaU1scndJYWFQY0hVUm8ifQ\",\"signature\":\"sTN2AnSwQmuEYv2yoCFD6xV3EkRSD3yezg-UOOS1S3Y\"}";
    if (problem.failed(encoded.error) || encoded.written != 292 ||
        !equal(?output[0], hs256_expected, 292)) { ret 1; }
    var hs384: external_account.Binding = binding;
    hs384.algorithm = external_account.HS384;
    val longer: external_account.Operation = external_account.encode(hs384,
        key, view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024});
    val hs384_expected: *u8 = "{\"protected\":\"eyJhbGciOiJIUzM4NCIsImtpZCI6ImtpZC0xIiwidXJsIjoiaHR0cHM6Ly9leGFtcGxlLmNvbS9hY21lL25ldy1hY2NvdW50In0\",\"payload\":\"eyJjcnYiOiJFZDI1NTE5Iiwia3R5IjoiT0tQIiwieCI6IjExcVlBWUt4Q3JmVlNfN1R5V1FIT2c3aGN2UGFwaU1scndJYWFQY0hVUm8ifQ\",\"signature\":\"FA1oLuxR8H5C4R22A3rq-LFx8Z-6lqk7c8n0wlDLS4q3O42Z0dMLs505blnQRsd_\"}";
    if (problem.failed(longer.error) || longer.written != 313 ||
        !equal(?output[0], hs384_expected, 313)) {
        ret 2;
    }
    var invalid: external_account.Binding = binding;
    invalid.secret_owner = nil;
    fill(?output[0], 0xa5, 1024);
    if (external_account.encode(invalid, key,
        view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024}).error.code !=
        problem.INVALID_INPUT || !filled(?output[0], 0xa5, 1024)) { ret 3; }
    var other_secret: [16]^u8;
    invalid              = binding;
    invalid.secret_owner = ?other_secret[0];
    if (external_account.encode(invalid, key,
        view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024}).error.code !=
        problem.INVALID_INPUT) { ret 5; }
    invalid             = binding;
    invalid.mac_key.len = external_account.MAX_MAC_KEY_BYTES + 1;
    if (external_account.encode(invalid, key,
        view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024}).error.code !=
        problem.INVALID_INPUT) { ret 6; }
    if (external_account.encode(binding, key,
        view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 1840},
        contracts.Buffer{data: ?output[0], capacity: 1024}).error.code !=
        problem.OUTPUT_TOO_SMALL || !filled(?output[0], 0xa5, 1024)) { ret 4; }
    val bound: external_account.Operation = external_account.encode(binding,
        key, view.view("https://example.com/acme/new-account", 36),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 1024});
    var account_output: [2048]u8;
    val create:         account.Operation = account.encode(account.CREATE,
        account.Request{contacts: nil, contact_len: 0,
        terms_of_service_agreed:  false, only_return_existing: false,
        external_account_binding: bound},
        contracts.Buffer{data: ?account_output[0], capacity: 2048});
    if (problem.failed(bound.error))              { ret 71; }
    if (!external_account.operation_valid(bound)) { ret 73; }
    if (problem.failed(create.error))             { ret 72; }
    var slots:        [1]nonce.Slot;
    var nonce_bytes:  [64]u8;
    var nonce_memory: nonce.Memory;
    if (problem.failed(nonce.init_memory(?nonce_memory, ?slots[0], 1,
        ?nonce_bytes[0], 64, 64))) { ret 8; }
    var pool:     nonce.Pool = nonce.pool(?nonce_memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 9; }
    var wrong_public: [32]u8;
    copy(?wrong_public[0], ?public_bytes[0], 32);
    wrong_public[0] = wrong_public[0] ^ 1;
    val wrong_signer: jose.Signer = jose.signer(jose.PublicKey{
        algorithm: jose.EDDSA,
        value:     contracts.Bytes{data: ?wrong_public[0], len: 32}
    });
    var request: client.SignedRequest;
    if (account.begin(?protocol, ?request, account.CREATE,
        view.view("https://example.com/acme/new-account", 36),
        view.view(nil, 0), create.payload, create, wrong_signer).code !=
        problem.INVALID_INPUT) { ret 10; }
    account_output[0] = account_output[0] ^ 1;
    if (account.begin(?protocol, ?request, account.CREATE,
        view.view("https://example.com/acme/new-account", 36),
        view.view(nil, 0), create.payload, create,
        jose.signer(key)).code != problem.INVALID_INPUT) { ret 11; }
    account_output[0] = account_output[0] ^ 1;
    if (problem.failed(account.begin(?protocol, ?request, account.CREATE,
        view.view("https://example.com/acme/new-account", 36),
        view.view(nil, 0), create.payload, create, jose.signer(key))) ||
        !request.signer_bound) { ret 12; }
    ret 0;
}

test "storage: replacement is durable across unknown commit and reentrancy" {
    var old_secret:  [32]^u8;
    var old_public:  [65]u8;
    var old_key:     jose.PublicKey;
    var old_private: jose.PrivateKey;
    var new_secret:  [32]^u8;
    var new_public:  [65]u8;
    var new_key:     jose.PublicKey;
    var new_private: jose.PrivateKey;
    if (!es_keys(?old_key, ?old_private, ?old_secret[0], ?old_public[0]) ||
        !es_keys(?new_key, ?new_private, ?new_secret[0], ?new_public[0])) { ret 1; }
    new_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 2; }
    new_key.value = contracts.Bytes{data: ?new_public[0], len: 65};
    var initial_provider: AccountStore;
    initial_provider.ready          = true;
    initial_provider.commit_unknown = true;
    var initial_manager: storage.Manager;
    if (problem.failed(storage.init_manager(?initial_manager,
        account_store(?initial_provider)))) { ret 20; }
    val initial: account.Credentials = credentials(old_key,
        old_private.secret_owner, 1);
    val initial_save: storage.Write = storage.begin_save(?initial_manager,
        0, initial);
    if (problem.failed(initial_save.error) ||
        storage.commit_write(?initial_manager, initial_save).code !=
        problem.STORAGE_UNKNOWN) { ret 21; }
    var initial_recovery: storage.Snapshot;
    initial_recovery.status = 99;
    if (storage.recover(?initial_manager,
        view.view("https://example.com/acme/acct/2", 31),
        ?initial_recovery).code != problem.INVALID_STATE ||
        initial_recovery.status != 99) { ret 25; }
    if (problem.failed(storage.recover(?initial_manager, initial.account.url,
        ?initial_recovery)) || initial_recovery.status != storage.NOT_FOUND ||
        !initial_recovery.has_pending ||
        initial_recovery.pending.generation != 1) { ret 22; }
    initial_provider.commit_unknown = false;
    if (problem.failed(storage.commit_write(?initial_manager, initial_save)) ||
        !initial_provider.found) { ret 23; }
    var deactivated: account.Credentials = initial;
    deactivated.account.status = account.DEACTIVATED;
    val metadata_save: storage.Write = storage.begin_save(?initial_manager,
        1, deactivated);
    if (problem.failed(metadata_save.error) ||
        problem.failed(storage.commit_write(?initial_manager, metadata_save)) ||
        initial_provider.current.account.status != account.DEACTIVATED ||
        initial_provider.current.generation != 1) { ret 24; }
    var provider: AccountStore;
    provider.current        = credentials(old_key, old_private.secret_owner, 1);
    provider.found          = true;
    provider.ready          = true;
    provider.reenter        = true;
    provider.commit_unknown = true;
    var manager: storage.Manager;
    provider.owned     = (?manager)::*u8;
    provider.owned_len = $size_of(storage.Manager);
    if (storage.init_manager(?manager, account_store(?provider)).code !=
        problem.INVALID_INPUT) { ret 3; }
    provider.owned     = nil;
    provider.owned_len = 0;
    if (problem.failed(storage.init_manager(?manager,
        account_store(?provider)))) { ret 4; }
    provider.manager = ?manager;
    val next: account.Credentials = credentials(new_key,
        new_private.secret_owner, 2);
    provider.mutate = ?new_public[0];
    val mutated: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (!problem.failed(mutated.error) || provider.pending_ready) { ret 5; }
    provider.mutate = nil;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 6; }
    val replacement: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (problem.failed(replacement.error) || !replacement.prepared ||
        !provider.reentry_rejected ||
        atomic.load(?provider.load_calls) != 0) { ret 7; }
    if (problem.failed(storage.bind_replace(?manager, replacement)) ||
        storage.commit_write(?manager, replacement).code !=
        problem.STORAGE_UNKNOWN) { ret 8; }
    var recovered: storage.Snapshot;
    recovered.status   = 99;
    provider.owned     = (?recovered)::*u8;
    provider.owned_len = $size_of(storage.Snapshot);
    if (storage.recover(?manager, provider.current.account.url,
        ?recovered).code != problem.INVALID_INPUT ||
        recovered.status != 99) { ret 9; }
    provider.owned     = nil;
    provider.owned_len = 0;
    if (problem.failed(storage.recover(?manager, provider.current.account.url,
        ?recovered)) || !recovered.has_pending ||
        recovered.pending.generation != 2) { ret 10; }
    provider.commit_unknown = false;
    if (problem.failed(storage.commit_write(?manager, replacement)) ||
        provider.current.generation != 2 || provider.pending_ready) { ret 11; }
    var first_snapshot:  storage.Snapshot;
    var second_snapshot: storage.Snapshot;
    var first_result:    i64            = 0;
    var second_result:   i64            = 0;
    var first_context:   RecoverContext = RecoverContext{manager: ?manager,
        url:    provider.current.account.url, snapshot: ?first_snapshot,
        result: ?first_result};
    var second_context: RecoverContext = RecoverContext{manager: ?manager,
        url:    provider.current.account.url, snapshot: ?second_snapshot,
        result: ?second_result};
    var first_thread:  thread.Thread;
    var second_thread: thread.Thread;
    thread.spawn_with(recover_worker, (?first_context)::*u8, ?first_thread);
    if (first_thread.tid < 0) { ret 12; }
    thread.spawn_with(recover_worker, (?second_context)::*u8, ?second_thread);
    if (second_thread.tid < 0) {
        thread.join(?first_thread);
        ret 13;
    }
    thread.join(?first_thread);
    thread.join(?second_thread);
    if (atomic.load(?first_result) != 1 || atomic.load(?second_result) != 1 ||
        atomic.load(?provider.load_overlap) != 0 ||
        atomic.load(?provider.load_active) != 0 ||
        atomic.load(?manager.gate.callback_owner) != 0) { ret 14; }
    ret 0;
}

test "storage: hostile transactions and recovery stay exactly bound" {
    var old_secret:  [32]^u8;
    var old_public:  [65]u8;
    var old_key:     jose.PublicKey;
    var old_private: jose.PrivateKey;
    var new_secret:  [32]^u8;
    var new_public:  [65]u8;
    var new_key:     jose.PublicKey;
    var new_private: jose.PrivateKey;
    if (!es_keys(?old_key, ?old_private, ?old_secret[0], ?old_public[0]) ||
        !es_keys(?new_key, ?new_private, ?new_secret[0], ?new_public[0])) {
        ret 1;
    }
    new_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 2; }
    new_key.value = contracts.Bytes{data: ?new_public[0], len: 65};
    var provider: AccountStore;
    provider.current = credentials(old_key, old_private.secret_owner, 1);
    provider.found   = true;
    provider.ready   = true;
    var manager: storage.Manager;
    if (problem.failed(storage.init_manager(?manager,
        account_store(?provider)))) { ret 3; }
    var next: account.Credentials = credentials(new_key,
        new_private.secret_owner, 2);

    provider.mutate_on_begin = ?new_public[0];
    val cleaned: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (!problem.failed(cleaned.error) || provider.transaction_active ||
        provider.pending_ready) { ret 4; }
    provider.mutate_on_begin = nil;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 5; }

    provider.begin_status = storage.FAILED;
    val malformed_begin: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (!problem.failed(malformed_begin.error) || provider.transaction_active ||
        provider.pending_ready) { ret 17; }
    provider.begin_status = 0;

    provider.abort_status    = storage.FAILED;
    provider.mutate_on_begin = ?new_public[0];
    val uncertain: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (uncertain.state != storage.WRITE_UNCERTAIN ||
        uncertain.error.code != problem.STORAGE_FAILED ||
        !provider.transaction_active) { ret 6; }
    provider.mutate_on_begin = nil;
    provider.abort_status    = storage.SUCCESS;
    if (problem.failed(storage.abort_write(?manager, uncertain)) ||
        provider.transaction_active) { ret 7; }
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 8; }

    provider.token        = 1;
    provider.reuse_token  = true;
    provider.abort_status = storage.FAILED;
    val reused: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (reused.state != storage.WRITE_UNCERTAIN ||
        reused.transaction.token != 1 || !provider.transaction_active) { ret 9; }
    provider.abort_status = storage.SUCCESS;
    if (problem.failed(storage.abort_write(?manager, reused)) ||
        provider.transaction_active) { ret 18; }
    provider.reuse_token = false;
    provider.token       = manager.gate.last_token;
    val staged: storage.Write = storage.begin_replace(?manager,
        provider.current, next);
    if (problem.failed(staged.error) || !provider.pending_ready) { ret 10; }
    var forged: storage.Write = staged;
    forged.transaction.token = forged.transaction.token + 1;
    if (!problem.failed(storage.commit_write(?manager, forged)) ||
        !provider.pending_ready) { ret 11; }

    var snapshot: storage.Snapshot;
    snapshot.status          = 99;
    provider.mutate_snapshot = true;
    if (storage.recover(?manager, provider.current.account.url,
        ?snapshot).code != problem.INVALID_STATE || snapshot.status != 99 ||
        !provider.pending_ready) { ret 12; }
    if (problem.failed(storage.recover(?manager, provider.current.account.url,
        ?snapshot)) || !snapshot.has_pending) { ret 13; }
    val resumed: storage.Write = storage.resume(snapshot);
    if (problem.failed(resumed.error) ||
        problem.failed(storage.abort_write(?manager, resumed)) ||
        provider.pending_ready || provider.transaction_active) { ret 14; }
    if (storage.range_disjoint(?manager, (?provider)::*u8,
        $size_of(AccountStore)).code != problem.INVALID_INPUT) { ret 15; }

    var mutating_provider: AccountStore;
    mutating_provider.ready          = true;
    mutating_provider.mutate_manager = true;
    var mutating_manager: storage.Manager;
    mutating_provider.manager = ?mutating_manager;
    if (storage.init_manager(?mutating_manager,
        account_store(?mutating_provider)).code != problem.INVALID_INPUT ||
        mutating_manager.initialized) { ret 16; }
    ret 0;
}

test "storage: shared gates consume exact writes and preserve outputs" {
    var old_secret:  [32]^u8;
    var old_public:  [65]u8;
    var old_key:     jose.PublicKey;
    var old_private: jose.PrivateKey;
    var new_secret:  [32]^u8;
    var new_public:  [65]u8;
    var new_key:     jose.PublicKey;
    var new_private: jose.PrivateKey;
    if (!es_keys(?old_key, ?old_private, ?old_secret[0], ?old_public[0]) ||
        !es_keys(?new_key, ?new_private, ?new_secret[0], ?new_public[0])) {
        ret 1;
    }
    new_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 2; }
    new_key.value = contracts.Bytes{data: ?new_public[0], len: 65};
    var provider: AccountStore;
    provider.current = credentials(old_key, old_private.secret_owner, 1);
    provider.found   = true;
    provider.ready   = true;
    var first:  storage.Manager;
    var second: storage.Manager;
    if (problem.failed(storage.init_manager(?first, account_store(?provider))) ||
        problem.failed(storage.init_manager(?second,
        account_store(?provider)))) { ret 3; }
    var copied:   storage.Manager = first;
    var snapshot: storage.Snapshot;
    snapshot.status = 77;
    if (storage.recover(?copied, provider.current.account.url,
        ?snapshot).code != problem.INVALID_INPUT || snapshot.status != 77) {
        ret 4;
    }
    val next: account.Credentials = credentials(new_key,
        new_private.secret_owner, 2);
    val staged: storage.Write = storage.begin_replace(?first,
        provider.current, next);
    if (problem.failed(staged.error) ||
        !problem.failed(storage.begin_replace(?second,
        provider.current, next).error) ||
        storage.commit_write(?first, staged).code != problem.STORAGE_CONFLICT) {
        ret 5;
    }
    provider.load_status = storage.FAILED;
    if (storage.check_write(?second, staged).code != problem.STORAGE_FAILED) {
        ret 6;
    }
    provider.load_status = storage.UNKNOWN;
    if (storage.check_write(?second, staged).code != problem.STORAGE_UNKNOWN) {
        ret 7;
    }
    provider.load_status = storage.CONFLICT;
    if (storage.check_write(?second, staged).code != problem.STORAGE_CONFLICT) {
        ret 8;
    }
    provider.load_status   = 0;
    provider.mutate_output = (?snapshot)::*u8;
    if (storage.recover(?second, provider.current.account.url,
        ?snapshot).code != problem.INVALID_INPUT || snapshot.status != 77) {
        ret 9;
    }
    var overlapping: account.Credentials = next;
    overlapping.secret_owner = (?first)::ptr;
    if (!problem.failed(storage.begin_replace(?second, provider.current,
        overlapping).error)) { ret 10; }
    if (problem.failed(storage.bind_replace(?second, staged)) ||
        storage.bind_replace(?first, staged).code != problem.STORAGE_CONFLICT ||
        problem.failed(storage.abort_write(?first, staged)) ||
        provider.pending_ready) { ret 11; }
    ret 0;
}

test "storage: persistent provider survives restart and rejects torn state" {
    val path: *u8 = "/tmp/mach-acme-storage-conformance.bin";
    fs.remove_file(path);
    var old_secret:  [32]^u8;
    var old_public:  [65]u8;
    var old_key:     jose.PublicKey;
    var old_private: jose.PrivateKey;
    var new_secret:  [32]^u8;
    var new_public:  [65]u8;
    var new_key:     jose.PublicKey;
    var new_private: jose.PrivateKey;
    if (!es_keys(?old_key, ?old_private, ?old_secret[0], ?old_public[0]) ||
        !es_keys(?new_key, ?new_private, ?new_secret[0], ?new_public[0])) {
        ret 1;
    }
    new_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 2; }
    new_key.value = contracts.Bytes{data: ?new_public[0], len: 65};
    val current: account.Credentials = credentials(old_key,
        old_private.secret_owner, 1);
    val next: account.Credentials = credentials(new_key,
        new_private.secret_owner, 2);
    var first_provider: AccountStore;
    first_provider.current    = current;
    first_provider.pending    = next;
    first_provider.found      = true;
    first_provider.ready      = true;
    first_provider.persistent = true;
    first_provider.path       = path;
    var first_manager: storage.Manager;
    if (problem.failed(storage.init_manager(?first_manager,
        account_store(?first_provider)))) { ret 3; }
    val first_write: storage.Write = storage.begin_replace(?first_manager,
        current, next);
    if (problem.failed(first_write.error) || first_write.transaction.token == 0 ||
        !file_exists(path)) { ret 4; }
    var restarted: AccountStore;
    restarted.current    = current;
    restarted.pending    = next;
    restarted.ready      = true;
    restarted.persistent = true;
    restarted.path       = path;
    if (!account_store_reload(?restarted)) { ret 5; }
    var restarted_manager: storage.Manager;
    if (problem.failed(storage.init_manager(?restarted_manager,
        account_store(?restarted)))) { ret 6; }
    var recovered: storage.Snapshot;
    if (problem.failed(storage.recover(?restarted_manager,
        current.account.url, ?recovered)) || !recovered.has_pending ||
        recovered.transaction.token != first_write.transaction.token) { ret 7; }
    val resumed: storage.Write = storage.resume(recovered);
    if (problem.failed(storage.abort_write(?restarted_manager, resumed))) {
        ret 8;
    }
    val second_write: storage.Write = storage.begin_replace(?restarted_manager,
        current, next);
    if (problem.failed(second_write.error) ||
        second_write.transaction.token <= first_write.transaction.token) {
        ret 9;
    }
    var torn: [12]u8;
    copy(?torn[0], "MACACME1", 8);
    if (!fs_ok(fs.write_bytes(path, ?torn[0], 12, 384))) { ret 10; }
    recovered.status = 91;
    if (storage.recover(?restarted_manager, current.account.url,
        ?recovered).code != problem.STORAGE_FAILED ||
        recovered.status != 91) { ret 11; }
    fs.remove_file(path);
    ret 0;
}

test "key change: interruption retains a recoverable nested rollover" {
    var old_secret:  [32]^u8;
    var old_public:  [65]u8;
    var old_key:     jose.PublicKey;
    var old_private: jose.PrivateKey;
    var new_secret:  [32]^u8;
    var new_public:  [65]u8;
    var new_key:     jose.PublicKey;
    var new_private: jose.PrivateKey;
    if (!es_keys(?old_key, ?old_private, ?old_secret[0], ?old_public[0]) ||
        !es_keys(?new_key, ?new_private, ?new_secret[0], ?new_public[0])) { ret 1; }
    new_secret[0] = 0xc8;
    if (p256.derive_public(contracts.SecretBytes{data: ?new_secret[0], len: 32},
        contracts.Buffer{data: ?new_public[0], capacity: 65}).error !=
        contracts.OK) { ret 2; }
    new_key.value     = contracts.Bytes{data: ?new_public[0], len: 65};
    new_private.value = contracts.SecretBytes{data: ?new_secret[0], len: 32};
    var provider: AccountStore;
    provider.current = credentials(old_key, old_private.secret_owner, 1);
    provider.found   = true;
    provider.ready   = true;
    var manager: storage.Manager;
    if (problem.failed(storage.init_manager(?manager,
        account_store(?provider)))) { ret 3; }
    val next: account.Credentials = credentials(new_key,
        new_private.secret_owner, 2);
    var work:      [4096]u8;
    var output:    [2048]u8;
    var unchanged: account.Credentials = provider.current;
    unchanged.generation = 2;
    if (!problem.failed(key_change.prepare(?manager, provider.current,
        unchanged, old_private, jose.no_entropy(),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048}).error) ||
        provider.transaction_active) { ret 16; }
    if (!problem.failed(key_change.prepare(?manager, provider.current, next,
        new_private, jose.no_entropy(),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: (?provider)::*u8,
        capacity: $size_of(AccountStore)}).error) ||
        provider.transaction_active) { ret 17; }
    val stale_prepared: key_change.Prepared = key_change.prepare(?manager,
        provider.current, next, new_private, jose.no_entropy(),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (problem.failed(stale_prepared.error) ||
        stale_prepared.nested_jws.len == 0 ||
        !provider.pending_ready) { ret 4; }
    var slots:        [1]nonce.Slot;
    var nonce_bytes:  [64]u8;
    var nonce_memory: nonce.Memory;
    if (problem.failed(nonce.init_memory(?nonce_memory, ?slots[0], 1,
        ?nonce_bytes[0], 64, 64))) { ret 5; }
    var pool:     nonce.Pool = nonce.pool(?nonce_memory);
    var protocol: client.Client;
    if (problem.failed(client.init(?protocol, ?pool,
        client.limits_default()))) { ret 6; }
    var request: client.SignedRequest;
    output[0] = output[0] ^ 1;
    if (key_change.begin_outer(?manager, ?protocol, ?request, provider.current,
        view.view("https://example.com/acme/key-change", 35),
        stale_prepared).code !=
        problem.INVALID_INPUT) { ret 14; }
    output[0]     = output[0] ^ 1;
    new_public[1] = new_public[1] ^ 1;
    if (key_change.begin_outer(?manager, ?protocol, ?request, provider.current,
        view.view("https://example.com/acme/key-change", 35),
        stale_prepared).code !=
        problem.INVALID_INPUT) { ret 18; }
    new_public[1] = new_public[1] ^ 1;
    if (problem.failed(storage.abort_write(?manager,
        stale_prepared.replacement)) ||
        key_change.begin_outer(?manager, ?protocol, ?request,
        provider.current,
        view.view("https://example.com/acme/key-change", 35),
        stale_prepared).code != problem.STORAGE_CONFLICT) { ret 19; }
    val prepared: key_change.Prepared = key_change.prepare(?manager,
        provider.current, next, new_private, jose.no_entropy(),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (problem.failed(prepared.error)) { ret 20; }
    if (problem.failed(key_change.begin_outer(?manager, ?protocol, ?request,
        provider.current,
        view.view("https://example.com/acme/key-change", 35), prepared)) ||
        request.spec.use_jwk || request.spec.payload.data != ?output[0] ||
        request.spec.kid.len != 31) { ret 7; }
    if (key_change.begin_outer(?manager, ?protocol, ?request,
        provider.current,
        view.view("https://example.com/acme/key-change", 35),
        prepared).code != problem.STORAGE_CONFLICT) { ret 21; }
    if (key_change.finish(?manager, prepared, key_change.AMBIGUOUS).code !=
        problem.STORAGE_UNKNOWN || !provider.pending_ready) { ret 8; }
    var restarted_manager: storage.Manager;
    if (problem.failed(storage.init_manager(?restarted_manager,
        account_store(?provider)))) { ret 15; }
    var recovered: storage.Snapshot;
    if (problem.failed(storage.recover(?restarted_manager,
        provider.current.account.url,
        ?recovered)) || !recovered.has_pending) { ret 9; }
    if (problem.failed(key_change.resolve(?restarted_manager, recovered,
        true)) || provider.current.generation != 2) { ret 10; }
    var metadata: storage.Snapshot = recovered;
    metadata.current                = provider.current;
    metadata.pending                = provider.current;
    metadata.pending.account.status = account.DEACTIVATED;
    metadata.transaction.generation = provider.current.generation;
    if (key_change.resolve(?restarted_manager, metadata,
        true).code != problem.INVALID_INPUT) { ret 22; }

    var ed_secret:  [32]^u8;
    var ed_public:  [32]u8;
    var ed_key:     jose.PublicKey;
    var ed_private: jose.PrivateKey;
    ed_keys(?ed_key, ?ed_private, ?ed_secret[0], ?ed_public[0]);
    val ed_next: account.Credentials = credentials(ed_key,
        ed_private.secret_owner, 3);
    val ed_prepared: key_change.Prepared = key_change.prepare(?restarted_manager,
        provider.current, ed_next, ed_private, jose.no_entropy(),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (problem.failed(ed_prepared.error) ||
        problem.failed(key_change.finish(?restarted_manager, ed_prepared,
        key_change.REJECTED)) || provider.pending_ready) { ret 11; }

    var hostile_alias: ForeignEntropy = ForeignEntropy{
        target: ?output[2047]
    };
    val alias_attack: key_change.Prepared = key_change.prepare(
        ?restarted_manager, provider.current, ed_next, ed_private,
        jose.entropy_provider((?hostile_alias)::ptr, foreign_entropy,
        entropy_mutates_foreign, entropy_aliases_no_secret,
        entropy_still_valid),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (!problem.failed(alias_attack.error) || provider.transaction_active ||
        provider.pending_ready) { ret 23; }

    var rsa_secret:   [256]^u8;
    var rsa_public:   [256]u8;
    var rsa_exponent: [3]u8;
    var rsa_decode:   [256]u8;
    var rsa_key:      jose.PublicKey;
    var rsa_private:  jose.PrivateKey;
    if (!rsa_keys(?rsa_key, ?rsa_private, ?rsa_public[0],
        ?rsa_exponent[0], ?rsa_secret[0], ?rsa_decode[0])) { ret 12; }
    val rsa_next: account.Credentials = credentials(rsa_key,
        rsa_private.secret_owner, 3);
    var hostile_fill:      ForeignEntropy      = ForeignEntropy{target: ?rsa_public[0]};
    val credential_attack: key_change.Prepared = key_change.prepare(
        ?restarted_manager, provider.current, rsa_next, rsa_private,
        jose.entropy_provider((?hostile_fill)::ptr, foreign_entropy,
        entropy_aliases_nothing, entropy_aliases_no_secret,
        entropy_still_valid),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (!problem.failed(credential_attack.error) ||
        provider.transaction_active || provider.pending_ready) { ret 24; }
    rsa_public[0] = rsa_public[0] ^ 1;
    val rsa_prepared: key_change.Prepared = key_change.prepare(?restarted_manager,
        provider.current, rsa_next, rsa_private,
        jose.entropy_provider(nil, deterministic_entropy,
        entropy_aliases_nothing, entropy_aliases_no_secret,
        entropy_still_valid),
        view.view("https://example.com/acme/key-change", 35),
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 2048});
    if (problem.failed(rsa_prepared.error) ||
        problem.failed(key_change.finish(?restarted_manager, rsa_prepared,
        key_change.REJECTED)) || provider.pending_ready) { ret 13; }
    ret 0;
}

fun order_limits() order.Limits {
    var configured: order.Limits = order.limits_default();
    configured.max_response_bytes = 65536;
    configured.max_json_scratch   = 32768;
    ret configured;
}

test "order: multi-identifier, partial failure, and expiry decode transactionally" {
    var fields: field.Fields;
    empty_fields(?fields);
    val body:           *u8           = "{\"status\":\"invalid\",\"expires\":\"2026-01-01T00:00:00Z\",\"identifiers\":[{\"type\":\"dns\",\"value\":\"a.example\"},{\"type\":\"dns\",\"value\":\"b.example\"}],\"authorizations\":[\"https://example.com/authz/1\",\"https://example.com/authz/2\"],\"finalize\":\"https://example.com/finalize/1\",\"error\":{\"type\":\"urn:ietf:params:acme:error:unauthorized\",\"detail\":\"one identifier failed\",\"status\":403}}";
    var scratch:        [32768]u8;
    var text:           [4096]u8;
    var names:          [4]identifier.Identifier;
    var authorizations: [4]view.View;
    val storage:        order.Storage = order.Storage{data: ?text[0], capacity: 4096,
        identifiers:    ?names[0], identifier_capacity: 4,
        authorizations: ?authorizations[0], authorization_capacity: 4};
    val known:  view.View = view.view("https://example.com/order/1", 27);
    var parsed: order.Order;
    if (problem.failed(order.parse(response(status.OK, ?fields,
        view.view(body, length(body))), known,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed))) { ret 1; }
    # a failed order retains the authority's structured cause per identifier
    if (parsed.status != order.INVALID || parsed.identifier_len != 2 ||
        parsed.authorization_len != 2 || parsed.expires.len != 20 ||
        parsed.certificate_url.len != 0 ||
        parsed.failure.status != 403 || parsed.failure.typ.len == 0 ||
        parsed.failure.detail.len == 0) { ret 2; }
    if (!identifier.same(parsed.identifiers[0],
        identifier.Identifier{kind: identifier.DNS,
        value: view.view("a.example", 9)}) ||
        !identifier.same(parsed.identifiers[1],
        identifier.Identifier{kind: identifier.DNS,
        value: view.view("b.example", 9)})) { ret 3; }

    # a valid order must name its certificate, and a non-valid one must not
    val mismatched: *u8 = "{\"status\":\"valid\",\"identifiers\":[{\"type\":\"dns\",\"value\":\"a.example\"}],\"authorizations\":[\"https://example.com/authz/1\"],\"finalize\":\"https://example.com/finalize/1\"}";
    if (order.parse(response(status.OK, ?fields,
        view.view(mismatched, length(mismatched))), known,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed).code != problem.MALFORMED_JSON) { ret 4; }

    # capacity failure leaves the caller's order record untouched
    var guarded: order.Order;
    fill((?guarded)::*u8, 0xa5, $size_of(order.Order));
    val small: order.Storage = order.Storage{data: ?text[0], capacity: 8,
        identifiers:    ?names[0], identifier_capacity: 4,
        authorizations: ?authorizations[0], authorization_capacity: 4};
    if (order.parse(response(status.OK, ?fields,
        view.view(body, length(body))), known,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        small, ?guarded).code != problem.OUTPUT_TOO_SMALL ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Order))) { ret 5; }
    var narrow: order.Storage = storage;
    narrow.identifier_capacity = 1;
    if (order.parse(response(status.OK, ?fields,
        view.view(body, length(body))), known,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        narrow, ?guarded).code != problem.OUTPUT_TOO_SMALL ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Order))) { ret 6; }

    # a policy that forbids wildcards rejects an order the authority echoes
    val wild:   *u8               = "{\"status\":\"pending\",\"identifiers\":[{\"type\":\"dns\",\"value\":\"*.a.example\"}],\"authorizations\":[\"https://example.com/authz/1\"],\"finalize\":\"https://example.com/finalize/1\"}";
    var strict: identifier.Policy = identifier.policy_default();
    strict.allow_wildcard = false;
    if (order.parse(response(status.OK, ?fields,
        view.view(wild, length(wild))), known, strict, order_limits(),
        ?scratch[0], 32768, storage, ?guarded).code !=
        problem.MALFORMED_JSON ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Order))) { ret 7; }
    if (problem.failed(order.parse(response(status.OK, ?fields,
        view.view(wild, length(wild))), known,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed))) { ret 8; }

    # a poll response with no known order url cannot name a resource
    if (order.parse(response(status.OK, ?fields,
        view.view(body, length(body))), view.view(nil, 0),
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?guarded).code != problem.INVALID_INPUT) { ret 9; }

    # scratch that aliases output storage fails before anything is written
    if (order.parse(response(status.OK, ?fields,
        view.view(body, length(body))), known,
        identifier.policy_default(), order_limits(), ?text[0], 4096,
        storage, ?guarded).code != problem.INVALID_INPUT ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Order))) { ret 10; }
    ret 0;
}

test "order: authorization expiry, wildcard, and challenge decoding are bounded" {
    var fields: field.Fields;
    empty_fields(?fields);
    var scratch:    [32768]u8;
    var text:       [4096]u8;
    var challenges: [8]challenge.Challenge;
    val storage:    order.AuthorizationStorage = order.AuthorizationStorage{
        data:               ?text[0], capacity: 4096, challenges: ?challenges[0],
        challenge_capacity: 8
    };
    val url:      view.View = view.view("https://example.com/authz/1", 27);
    val wildcard: *u8       = "{\"status\":\"pending\",\"wildcard\":true,\"expires\":\"2026-01-01T00:00:00Z\",\"identifier\":{\"type\":\"dns\",\"value\":\"a.example\"},\"challenges\":[{\"type\":\"dns-01\",\"url\":\"https://example.com/chall/1\",\"token\":\"tok-1\",\"status\":\"pending\"}]}";
    var parsed:   order.Authorization;
    if (problem.failed(order.parse_authorization(response(status.OK, ?fields,
        view.view(wildcard, length(wildcard))), url,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed))) { ret 1; }
    if (!parsed.wildcard || parsed.status != order.AUTH_PENDING ||
        parsed.challenge_len != 1 || parsed.expires.len != 20 ||
        parsed.challenges[0].typ != challenge.DNS_01 ||
        parsed.challenges[0].status != challenge.PENDING) { ret 2; }
    # rfc 8555 admits only dns-01 for a wildcard authorization
    if (!order.challenge_admissible(parsed, challenge.DNS_01) ||
        order.challenge_admissible(parsed, challenge.HTTP_01) ||
        order.select_challenge(parsed, challenge.HTTP_01) != nil) { ret 3; }

    # an expired authorization decodes to its own terminal status
    val expired: *u8 = "{\"status\":\"expired\",\"identifier\":{\"type\":\"dns\",\"value\":\"a.example\"},\"challenges\":[{\"type\":\"http-01\",\"url\":\"https://example.com/chall/1\",\"token\":\"tok-1\",\"status\":\"invalid\",\"error\":{\"type\":\"urn:ietf:params:acme:error:connection\",\"detail\":\"no answer\",\"status\":400}}]}";
    if (problem.failed(order.parse_authorization(response(status.OK, ?fields,
        view.view(expired, length(expired))), url,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed))) { ret 4; }
    if (parsed.status != order.AUTH_EXPIRED || parsed.wildcard ||
        parsed.challenges[0].status != challenge.INVALID ||
        parsed.challenges[0].failure.status != 400 ||
        parsed.challenges[0].failure.typ.len == 0) { ret 5; }

    # a hostile token and an unknown status both fail closed
    var guarded: order.Authorization;
    fill((?guarded)::*u8, 0xa5, $size_of(order.Authorization));
    val hostile: *u8 = "{\"status\":\"pending\",\"identifier\":{\"type\":\"dns\",\"value\":\"a.example\"},\"challenges\":[{\"type\":\"http-01\",\"url\":\"https://example.com/chall/1\",\"token\":\"tok 1\",\"status\":\"pending\"}]}";
    if (order.parse_authorization(response(status.OK, ?fields,
        view.view(hostile, length(hostile))), url,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?guarded).code != problem.MALFORMED_JSON ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Authorization))) {
        ret 6;
    }
    val unknown: *u8 = "{\"status\":\"surprising\",\"identifier\":{\"type\":\"dns\",\"value\":\"a.example\"},\"challenges\":[{\"type\":\"http-01\",\"url\":\"https://example.com/chall/1\",\"token\":\"tok-1\",\"status\":\"pending\"}]}";
    if (order.parse_authorization(response(status.OK, ?fields,
        view.view(unknown, length(unknown))), url,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?guarded).code != problem.MALFORMED_JSON ||
        !filled((?guarded)::*u8, 0xa5, $size_of(order.Authorization))) {
        ret 7;
    }
    # an unimplemented challenge type is retained without failing the whole
    # authorization, and is simply not selectable
    val mixed: *u8 = "{\"status\":\"pending\",\"identifier\":{\"type\":\"dns\",\"value\":\"a.example\"},\"challenges\":[{\"type\":\"tls-sni-99\",\"url\":\"https://example.com/chall/9\",\"token\":\"tok-9\",\"status\":\"pending\"},{\"type\":\"http-01\",\"url\":\"https://example.com/chall/1\",\"token\":\"tok-1\",\"status\":\"pending\"}]}";
    if (problem.failed(order.parse_authorization(response(status.OK, ?fields,
        view.view(mixed, length(mixed))), url,
        identifier.policy_default(), order_limits(), ?scratch[0], 32768,
        storage, ?parsed))) { ret 8; }
    if (parsed.challenge_len != 2 || parsed.challenges[0].typ != 0 ||
        parsed.challenges[1].typ != challenge.HTTP_01 ||
        order.select_challenge(parsed, 0) != nil ||
        order.select_challenge(parsed, challenge.HTTP_01) == nil) { ret 9; }
    ret 0;
}

test "order: newOrder payloads are exact and reject invalid identifiers" {
    var names: [2]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("a.example", 9)};
    names[1] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("*.b.example", 11)};
    var output:  [512]u8;
    val encoded: order.Operation = order.encode(
        order.Request{identifiers: ?names[0], len: 2,
        not_before: view.view(nil, 0), not_after: view.view(nil, 0)},
        identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512});
    val expected: *u8 = "{\"identifiers\":[{\"type\":\"dns\",\"value\":\"a.example\"},{\"type\":\"dns\",\"value\":\"*.b.example\"}]}";
    if (problem.failed(encoded.error) ||
        encoded.written != length(expected) ||
        !equal(?output[0], expected, encoded.written)) { ret 1; }

    var dated: order.Request = order.Request{identifiers: ?names[0], len: 1,
        not_before: view.view("2026-01-01T00:00:00Z", 20),
        not_after:  view.view("2026-04-01T00:00:00Z", 20)};
    val windowed: order.Operation = order.encode(dated,
        identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512});
    val expected_window: *u8 = "{\"identifiers\":[{\"type\":\"dns\",\"value\":\"a.example\"}],\"notBefore\":\"2026-01-01T00:00:00Z\",\"notAfter\":\"2026-04-01T00:00:00Z\"}";
    if (problem.failed(windowed.error) ||
        windowed.written != length(expected_window) ||
        !equal(?output[0], expected_window, windowed.written)) { ret 2; }

    # a duplicate identifier makes the authorization list ambiguous
    var duplicated: [2]identifier.Identifier;
    duplicated[0] = names[0];
    duplicated[1] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("A.EXAMPLE", 9)};
    fill(?output[0], 0xa5, 512);
    if (order.encode(order.Request{identifiers: ?duplicated[0], len: 2,
        not_before: view.view(nil, 0), not_after: view.view(nil, 0)},
        identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT || !filled(?output[0], 0xa5, 512)) { ret 3; }

    # an empty order, a malformed timestamp, and a denied wildcard all fail
    var strict: identifier.Policy = identifier.policy_default();
    strict.allow_wildcard = false;
    var bad_time: order.Request = dated;
    bad_time.not_after = view.view("soon", 4);
    if (order.encode(order.Request{identifiers: ?names[0], len: 0,
        not_before: view.view(nil, 0), not_after: view.view(nil, 0)},
        identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT ||
        order.encode(bad_time, identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT ||
        order.encode(order.Request{identifiers: ?names[0], len: 2,
        not_before: view.view(nil, 0), not_after: view.view(nil, 0)},
        strict, order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 512}).error.code !=
        problem.INVALID_INPUT || !filled(?output[0], 0xa5, 512)) { ret 4; }

    # a short output is measured before any byte is published
    if (order.encode(order.Request{identifiers: ?names[0], len: 2,
        not_before: view.view(nil, 0), not_after: view.view(nil, 0)},
        identifier.policy_default(), order_limits(),
        contracts.Buffer{data: ?output[0], capacity: 16}).error.code !=
        problem.OUTPUT_TOO_SMALL || !filled(?output[0], 0xa5, 512)) {
        ret 5;
    }
    ret 0;
}

# a provider that counts every boundary crossing, so exactly-once is observed
# rather than inferred
rec CountingProvider {
    present_calls: usize;
    cleanup_calls: usize;
    supported:     bool;
    fail_present:  bool;
    fail_cleanup:  bool;
    reenter:       *challenge.Attempt;
    reentered:     bool;
    seen_key_auth: [256]u8;
    seen_len:      usize;
}

fun counting_supports(ctx: ptr, subject: identifier.Identifier,
    kind: u8) bool {
    val state: *CountingProvider = ctx::*CountingProvider;
    ret state.supported;
}

fun counting_present(ctx: ptr, subject: identifier.Identifier,
    value: challenge.Challenge,
    key_authorization: view.View) res[challenge.Presentation, problem.Error] {
    val state: *CountingProvider = ctx::*CountingProvider;
    state.present_calls = state.present_calls + 1;
    state.seen_len      = key_authorization.len;
    if (key_authorization.len <= 256) {
        copy(?state.seen_key_auth[0], key_authorization.data,
            key_authorization.len);
    }
    # a provider that re-enters the attempt from inside its own callback must
    # be refused before it can move the attempt's state
    if (state.reenter != nil) {
        state.reentered = problem.failed(challenge.finish(state.reenter));
    }
    if (state.fail_present) {
        ret res[challenge.Presentation, problem.Error].err{problem.local_code(problem.CHALLENGE, problem.INVALID_STATE,
            "provider could not publish")};
    }
    ret res[challenge.Presentation, problem.Error].ok{challenge.Presentation{ctx: ctx}};
}

fun counting_cleanup(ctx: ptr,
    presentation: challenge.Presentation) res[bool, problem.Error] {
    val state: *CountingProvider = ctx::*CountingProvider;
    state.cleanup_calls = state.cleanup_calls + 1;
    if (state.fail_cleanup) {
        ret res[bool, problem.Error].err{problem.local_code(problem.CHALLENGE, problem.INVALID_STATE,
            "provider could not withdraw")};
    }
    ret res[bool, problem.Error].ok{true};
}

fun counting_provider(state: *CountingProvider) challenge.Provider {
    state.present_calls = 0;
    state.cleanup_calls = 0;
    state.supported     = true;
    state.fail_present  = false;
    state.fail_cleanup  = false;
    state.reenter       = nil;
    state.reentered     = false;
    state.seen_len      = 0;
    ret challenge.Provider{ctx: state::ptr, supports: counting_supports,
        present: counting_present, cleanup: counting_cleanup};
}

fun pending_challenge(kind: u8) challenge.Challenge {
    var value: challenge.Challenge;
    value.typ       = kind;
    value.url       = view.view("https://example.com/chall/1", 27);
    value.token     = view.view("LoqXcYV8q5ONbJQxbmR7SCTNo3tiAXDfowyjxAjEuX0", 43);
    value.status    = challenge.PENDING;
    value.validated = view.view(nil, 0);
    ret value;
}

fun live_key_authorization() view.View {
    ret view.view("LoqXcYV8q5ONbJQxbmR7SCTNo3tiAXDfowyjxAjEuX0.9jg46WB3rR_AHD-EBXdN7cBkH1WOu0tA3M9fm21mqTI", 87);
}

test "challenge: presentation and cleanup run exactly once on every exit" {
    val subject: identifier.Identifier = identifier.Identifier{
        kind: identifier.DNS, value: view.view("example.org", 11)
    };
    val key_auth: view.View = live_key_authorization();

    # success, then a repeated finish that must not reach the provider again
    var state:   CountingProvider;
    var attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?attempt,
        counting_provider(?state)))) { ret 1; }
    if (problem.failed(challenge.begin(?attempt, subject,
        pending_challenge(challenge.HTTP_01), key_auth))) { ret 2; }
    if (state.present_calls != 1 || !challenge.presented(?attempt) ||
        state.seen_len != 87 ||
        !equal(?state.seen_key_auth[0], key_auth.data, 87)) { ret 3; }
    if (problem.failed(challenge.finish(?attempt)) ||
        state.cleanup_calls != 1) { ret 4; }
    if (problem.failed(challenge.finish(?attempt)) ||
        problem.failed(challenge.finish(?attempt)) ||
        state.cleanup_calls != 1 || state.present_calls != 1) { ret 5; }
    # a retired attempt cannot be presented again
    if (!problem.failed(challenge.begin(?attempt, subject,
        pending_challenge(challenge.HTTP_01), key_auth)) ||
        state.present_calls != 1) { ret 6; }

    # a presentation that failed owes no cleanup
    var failing:        CountingProvider;
    var failed_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?failed_attempt,
        counting_provider(?failing)))) { ret 7; }
    failing.fail_present = true;
    if (!problem.failed(challenge.begin(?failed_attempt, subject,
        pending_challenge(challenge.DNS_01), key_auth)) ||
        failing.present_calls != 1 ||
        challenge.presented(?failed_attempt)) { ret 8; }
    if (problem.failed(challenge.finish(?failed_attempt)) ||
        failing.cleanup_calls != 0) { ret 9; }

    # a declined challenge never reaches presentation
    var declined:         CountingProvider;
    var declined_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?declined_attempt,
        counting_provider(?declined)))) { ret 10; }
    declined.supported = false;
    if (challenge.supports(?declined_attempt, subject, challenge.HTTP_01) ||
        !problem.failed(challenge.begin(?declined_attempt, subject,
        pending_challenge(challenge.HTTP_01), key_auth)) ||
        declined.present_calls != 0) { ret 11; }
    if (problem.failed(challenge.finish(?declined_attempt)) ||
        declined.cleanup_calls != 0) { ret 12; }

    # a timeout exit: the poll deadline ends the wait and finish still retires
    # the presentation exactly once
    var timed:         CountingProvider;
    var timed_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?timed_attempt,
        counting_provider(?timed))) ||
        problem.failed(challenge.begin(?timed_attempt, subject,
        pending_challenge(challenge.DNS_01), key_auth))) { ret 13; }
    var waiting: poll.State;
    if (problem.failed(poll.begin(?waiting, poll.policy_default(), 0)) ||
        poll.next(?waiting, false, false, 0, 1).action != poll.DEADLINE) {
        ret 14;
    }
    if (problem.failed(challenge.finish(?timed_attempt)) ||
        timed.cleanup_calls != 1 ||
        problem.failed(challenge.finish(?timed_attempt)) ||
        timed.cleanup_calls != 1) { ret 15; }

    # a cancellation exit behaves identically
    var cancelled:         CountingProvider;
    var cancelled_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?cancelled_attempt,
        counting_provider(?cancelled))) ||
        problem.failed(challenge.begin(?cancelled_attempt, subject,
        pending_challenge(challenge.TLS_ALPN_01), key_auth))) { ret 16; }
    var stopping: poll.State;
    if (problem.failed(poll.begin(?stopping, poll.policy_default(),
        1000000000000)) || !poll.cancel(?stopping) ||
        poll.next(?stopping, false, false, 0, 0).action != poll.CANCELLED) {
        ret 17;
    }
    if (problem.failed(challenge.finish(?cancelled_attempt)) ||
        cancelled.cleanup_calls != 1 ||
        problem.failed(challenge.finish(?cancelled_attempt)) ||
        cancelled.cleanup_calls != 1) { ret 18; }

    # a cleanup that fails reports the failure and is still never repeated
    var stubborn:         CountingProvider;
    var stubborn_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?stubborn_attempt,
        counting_provider(?stubborn))) ||
        problem.failed(challenge.begin(?stubborn_attempt, subject,
        pending_challenge(challenge.HTTP_01), key_auth))) { ret 19; }
    stubborn.fail_cleanup = true;
    if (!problem.failed(challenge.finish(?stubborn_attempt)) ||
        stubborn.cleanup_calls != 1) { ret 20; }
    if (problem.failed(challenge.finish(?stubborn_attempt)) ||
        stubborn.cleanup_calls != 1) { ret 21; }

    # a provider that re-enters the attempt from its own callback fails closed
    var hostile:         CountingProvider;
    var hostile_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?hostile_attempt,
        counting_provider(?hostile)))) { ret 22; }
    hostile.reenter = ?hostile_attempt;
    if (problem.failed(challenge.begin(?hostile_attempt, subject,
        pending_challenge(challenge.HTTP_01), key_auth)) ||
        !hostile.reentered || hostile.cleanup_calls != 0) { ret 23; }
    if (problem.failed(challenge.finish(?hostile_attempt)) ||
        hostile.cleanup_calls != 1) { ret 24; }

    # a malformed key authorization never reaches the provider
    var guarded:         CountingProvider;
    var guarded_attempt: challenge.Attempt;
    if (problem.failed(challenge.attempt_init(?guarded_attempt,
        counting_provider(?guarded)))) { ret 25; }
    if (!problem.failed(challenge.begin(?guarded_attempt, subject,
        pending_challenge(challenge.HTTP_01),
        view.view("no-dot", 6))) || guarded.present_calls != 0) { ret 26; }
    ret 0;
}

rec ScriptedProbe {
    answers: [8]bool;
    len:     usize;
    at:      usize;
    calls:   usize;
}

fun scripted_observe(ctx: ptr, name: view.View, expected: view.View) bool {
    val state: *ScriptedProbe = ctx::*ScriptedProbe;
    state.calls = state.calls + 1;
    if (state.at >= state.len) { ret true; }
    val answer: bool = state.answers[state.at];
    state.at = state.at + 1;
    ret answer;
}

test "challenge: dns propagation is bounded, injectable, and consecutive" {
    val name:     view.View = view.view("_acme-challenge.example.org", 27);
    val expected: view.View = view.view(
        "LPsIwTo7o8BoG0-vjCyGQGBWSVIPxI-i_X336eUOQZo", 43);
    var probe:  ScriptedProbe;
    var state:  challenge.Propagation;
    var policy: challenge.PropagationPolicy =
        challenge.propagation_policy_default();
    policy.poll.min_delay_ns = 1000000;
    policy.poll.max_delay_ns = 4000000;
    policy.poll.max_attempts = 8;
    policy.required_checks   = 2;
    val injected: challenge.Probe = challenge.Probe{ctx: (?probe)::ptr,
        observe: scripted_observe};

    # not observed, observed once, then lost again: the count restarts, so a
    # record that flaps never counts as propagated
    probe.answers[0] = false;
    probe.answers[1] = true;
    probe.answers[2] = false;
    probe.answers[3] = true;
    probe.answers[4] = true;
    probe.len        = 5;
    probe.at         = 0;
    probe.calls      = 0;
    if (problem.failed(challenge.propagation_begin(?state, policy,
        1000000000000))) { ret 1; }
    if (challenge.propagation_next(?state, injected, name, expected,
        0).action != poll.WAIT || state.confirmed != 0) { ret 2; }
    if (challenge.propagation_next(?state, injected, name, expected,
        0).action != poll.WAIT || state.confirmed != 1) { ret 3; }
    if (challenge.propagation_next(?state, injected, name, expected,
        0).action != poll.WAIT || state.confirmed != 0) { ret 4; }
    if (challenge.propagation_next(?state, injected, name, expected,
        0).action != poll.WAIT || state.confirmed != 1) { ret 5; }
    val settled: poll.Decision = challenge.propagation_next(?state, injected,
        name, expected, 0);
    if (settled.action != poll.READY || state.confirmed != 2 ||
        probe.calls != 5) { ret 6; }

    # a record that never appears stops at the attempt ceiling
    var never: ScriptedProbe;
    var i:     usize = 0;
    for (i < 8) {
        never.answers[i] = false;
        i                = i + 1;
    }
    never.len   = 8;
    never.at    = 0;
    never.calls = 0;
    val absent: challenge.Probe = challenge.Probe{ctx: (?never)::ptr,
        observe: scripted_observe};
    if (problem.failed(challenge.propagation_begin(?state, policy,
        1000000000000))) { ret 7; }
    var rounds: usize       = 0;
    var action: poll.Action = poll.WAIT;
    for (rounds < 32 && action == poll.WAIT) {
        action = challenge.propagation_next(?state, absent, name, expected,
            0).action;
        rounds = rounds + 1;
    }
    if (action != poll.LIMIT || rounds != 9) { ret 8; }

    # the absolute deadline and cancellation both stop the wait
    if (problem.failed(challenge.propagation_begin(?state, policy, 0))) {
        ret 9;
    }
    if (challenge.propagation_next(?state, absent, name, expected,
        1).action != poll.DEADLINE) { ret 10; }
    if (problem.failed(challenge.propagation_begin(?state, policy,
        1000000000000)) || !challenge.propagation_cancel(?state)) {
        ret 11;
    }
    val stopped: poll.Decision = challenge.propagation_next(?state, absent,
        name, expected, 0);
    if (stopped.action != poll.CANCELLED) { ret 12; }

    # an absent probe or an empty record is refused before any observation
    var empty: challenge.Probe = injected;
    empty.observe = nil;
    if (problem.failed(challenge.propagation_begin(?state, policy,
        1000000000000))) { ret 13; }
    if (challenge.propagation_next(?state, empty, name, expected, 0).action !=
        poll.TERMINAL ||
        challenge.propagation_next(?state, injected, view.view(nil, 0),
        expected, 0).action != poll.TERMINAL) { ret 14; }
    ret 0;
}

# a signing provider resolves its own key material. the opaque context never
# carries a secret, so no public alias to the scalar can exist.
fun csr_sign_p256(ctx: ptr, tbs: *u8, tbs_len: usize, output: *u8,
    capacity: usize) usize {
    var private_bytes: [32]^u8;
    set_private(?private_bytes[0]);
    val signed: contracts.Operation = signature.sign_ecdsa_p256_sha256(
        contracts.SecretBytes{data: ?private_bytes[0], len: 32},
        contracts.Bytes{data: tbs, len: tbs_len},
        contracts.Buffer{data: output, capacity: capacity});
    if (signed.error != contracts.OK) { ret 0; }
    ret signed.written;
}

fun p256_spki(point: *u8, output: *u8) usize {
    val prefix: [26]u8 = [26]u8{
        0x30, 0x59, 0x30, 0x13, 0x06, 0x07, 0x2a, 0x86,
        0x48, 0xce, 0x3d, 0x02, 0x01, 0x06, 0x08, 0x2a,
        0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07, 0x03,
        0x42, 0x00
    };
    var i: usize = 0;
    for (i < 26) {
        output[i] = prefix[i];
        i         = i + 1;
    }
    i = 0;
    for (i < 65) {
        output[26 + i] = point[i];
        i              = i + 1;
    }
    ret 91;
}

# walks one der element so a test can reach the exact bytes a signature covers
fun der_element(data: *u8, len: usize, at: usize, tag: *u8,
    content_at: *usize, content_len: *usize, next: *usize) bool {
    if (at + 2 > len) { ret false; }
    @tag = data[at];
    var cursor: usize = at + 1;
    val first:  u8    = data[cursor];
    cursor = cursor + 1;
    var size: usize = 0;
    if (first < 128) {
        size = first::usize;
    }
    or {
        val count: usize = (first & 0x7f)::usize;
        if (count == 0 || count > 8 || cursor + count > len) { ret false; }
        var i: usize = 0;
        for (i < count) {
            size = (size << 8) + data[cursor + i]::usize;
            i    = i + 1;
        }
        cursor = cursor + count;
    }
    if (size > len - cursor) { ret false; }
    @content_at  = cursor;
    @content_len = size;
    @next        = cursor + size;
    ret true;
}

test "certificate: a csr is valid der and its signature covers the request info" {
    var private_bytes: [32]^u8;
    var public_bytes:  [65]u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }
    var spki:     [128]u8;
    val spki_len: usize = p256_spki(?public_bytes[0], ?spki[0]);
    var names:    [2]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("a.example.com", 13)};
    names[1] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("*.b.example.com", 15)};
    var work:   [4096]u8;
    var output: [4096]u8;
    val signer: certificate.CsrSigner = certificate.CsrSigner{ctx: nil,
        sign:           csr_sign_p256, algorithm: certificate.ECDSA_P256_SHA256,
        public_key_der: view.view(?spki[0], spki_len)};
    val csr: certificate.Operation = certificate.encode_csr(?names[0], 2,
        identifier.policy_default(), signer,
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 4096});
    if (problem.failed(csr.error) || csr.written == 0) { ret 2; }

    # the request is a single der sequence holding the request info, the
    # signature algorithm, and the signature bit string
    var tag:         u8    = 0;
    var content_at:  usize = 0;
    var content_len: usize = 0;
    var next:        usize = 0;
    if (!der_element(?output[0], csr.written, 0, ?tag, ?content_at,
        ?content_len, ?next) || tag != 0x30 ||
        next != csr.written) { ret 3; }
    val body_at:    usize = content_at;
    val body_len:   usize = content_len;
    var info_at:    usize = 0;
    var info_len:   usize = 0;
    var after_info: usize = 0;
    if (!der_element(?output[0], body_at + body_len, body_at, ?tag, ?info_at,
        ?info_len, ?after_info) || tag != 0x30) { ret 4; }
    var algorithm_at:    usize = 0;
    var algorithm_len:   usize = 0;
    var after_algorithm: usize = 0;
    if (!der_element(?output[0], body_at + body_len, after_info, ?tag,
        ?algorithm_at, ?algorithm_len, ?after_algorithm) ||
        tag != 0x30) { ret 5; }
    var signature_at:    usize = 0;
    var signature_len:   usize = 0;
    var after_signature: usize = 0;
    if (!der_element(?output[0], body_at + body_len, after_algorithm, ?tag,
        ?signature_at, ?signature_len, ?after_signature) ||
        tag != 0x03 || after_signature != body_at + body_len) { ret 6; }
    # a bit string leads with its count of unused trailing bits
    if (output[signature_at] != 0x00) { ret 7; }

    # the signature must verify over the exact certification request info,
    # tag and length included
    if (signature.verify_ecdsa_p256_sha256(
        contracts.Bytes{data: ?public_bytes[0], len: 65},
        contracts.Bytes{data: ?output[body_at],
        len: after_info - body_at},
        contracts.Bytes{data: ?output[signature_at + 1],
        len: signature_len - 1}) != contracts.OK) { ret 8; }

    # both requested names appear in the subjectAltName, wildcard included
    var found_a: bool  = false;
    var found_b: bool  = false;
    var i:       usize = 0;
    for (i + 15 <= csr.written) {
        if (output[i] == 0x82 && output[i + 1] == 13 &&
            equal(?output[i + 2], "a.example.com", 13)) { found_a = true; }
        if (output[i] == 0x82 && output[i + 1] == 15 &&
            equal(?output[i + 2], "*.b.example.com", 15)) { found_b = true; }
        i = i + 1;
    }
    if (!found_a || !found_b) { ret 9; }

    # a signer that returns a shape the algorithm does not admit is refused
    fill(?output[0], 0xa5, 4096);
    var wrong: certificate.CsrSigner = signer;
    wrong.algorithm = certificate.ED25519;
    if (certificate.encode_csr(?names[0], 2, identifier.policy_default(),
        wrong, contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 4096}).error.code !=
        problem.SIGNATURE_FAILED || !filled(?output[0], 0xa5, 4096)) {
        ret 10;
    }
    # a denied wildcard, an empty request, and a short output all fail closed
    var strict: identifier.Policy = identifier.policy_default();
    strict.allow_wildcard = false;
    if (certificate.encode_csr(?names[0], 2, strict, signer,
        contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 4096}).error.code !=
        problem.INVALID_INPUT ||
        certificate.encode_csr(?names[0], 0, identifier.policy_default(),
        signer, contracts.Buffer{data: ?work[0], capacity: 4096},
        contracts.Buffer{data: ?output[0], capacity: 4096}).error.code !=
        problem.INVALID_INPUT ||
        certificate.encode_csr(?names[0], 2, identifier.policy_default(),
        signer, contracts.Buffer{data: ?work[0], capacity: 32},
        contracts.Buffer{data: ?output[0], capacity: 4096}).error.code !=
        problem.OUTPUT_TOO_SMALL || !filled(?output[0], 0xa5, 4096)) {
        ret 11;
    }
    ret 0;
}

# an openssl-generated leaf carrying two dns names and one ip address, with a
# validity window computed independently of this implementation
fun leaf_pem() *u8 {
    ret "-----BEGIN CERTIFICATE-----\nMIIBiTCCAS6gAwIBAgIUbnYIUfdvfMCkoKJt0Eea62OURk4wCgYIKoZIzj0EAwIw\nADAeFw0yNjA4MjgyMjExMjlaFw0yNjExMjYyMjExMjlaMAAwWTATBgcqhkjOPQIB\nBggqhkjOPQMBBwNCAASJaX667nSrQmHvMORhTY5bdMthaA5tWnTEYE4IZrGRhbzq\ndmGLpaxPUw2l8UZ/OxASnhHykrG+7YPh+yuKDkUBo4GFMIGCMB0GA1UdDgQWBBQk\n3YkQ9uZntNvhuTAiHiTkx0z1tTAfBgNVHSMEGDAWgBQk3YkQ9uZntNvhuTAiHiTk\nx0z1tTAPBgNVHRMBAf8EBTADAQH/MC8GA1UdEQQoMCaCDWEuZXhhbXBsZS5jb22C\nDyouYi5leGFtcGxlLmNvbYcEwAACBzAKBggqhkjOPQQDAgNJADBGAiEA1ZNxagn1\ndjiUbqFt2W5ldU/YCi5LDTf3T3q8GhZfu88CIQDDnxCeO5FxsOCAICYh80tWlbeB\nUGdTd19IAG7vYnuVDA==\n-----END CERTIFICATE-----";
}

test "certificate: chains decode and are verified against requested identifiers" {
    val pem:          *u8       = leaf_pem();
    val body:         view.View = view.view(pem, length(pem));
    var certificates: [4]certificate.Certificate;
    var der:          [8192]u8;
    var chain:        certificate.Chain;
    if (problem.failed(certificate.parse_chain(body, ?certificates[0], 4,
        ?der[0], 8192, ?chain))) { ret 1; }
    if (chain.len != 1 || chain.certificates[0].der.len == 0) { ret 2; }

    var names:  [8]identifier.Identifier;
    var parsed: certificate.Parsed;
    if (problem.failed(certificate.parse_certificate(
        chain.certificates[0].der, ?names[0], 8, ?parsed))) { ret 3; }
    # the validity window is decoded from the certificate, not the clock
    if (parsed.name_len != 3 || parsed.not_before_unix != 1787955089 ||
        parsed.not_after_unix != 1795731089) { ret 4; }
    if (parsed.names[0].kind != identifier.DNS ||
        !equal(parsed.names[0].value.data, "a.example.com", 13) ||
        parsed.names[1].kind != identifier.DNS ||
        !equal(parsed.names[1].value.data, "*.b.example.com", 15) ||
        parsed.names[2].kind != identifier.IP ||
        parsed.names[2].value.len != 4) { ret 5; }

    # a certificate covering exactly the requested identifiers is accepted
    var requested: [3]identifier.Identifier;
    requested[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("A.EXAMPLE.COM", 13)};
    requested[1] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("*.b.example.com", 15)};
    requested[2] = identifier.Identifier{kind: identifier.IP,
        value: view.view("192.0.2.7", 9)};
    var verified: certificate.Parsed;
    if (problem.failed(certificate.verify_issued(chain, ?requested[0], 3,
        ?names[0], 8, ?verified))) { ret 6; }

    # a certificate that omits or exceeds the requested set is refused before
    # anything reaches storage
    var short_request: [2]identifier.Identifier;
    short_request[0] = requested[0];
    short_request[1] = requested[1];
    if (certificate.verify_issued(chain, ?short_request[0], 2, ?names[0], 8,
        ?verified).code != problem.INVALID_INPUT) { ret 7; }
    var wrong: [3]identifier.Identifier;
    wrong[0] = requested[0];
    wrong[1] = requested[1];
    wrong[2] = identifier.Identifier{kind: identifier.IP,
        value: view.view("192.0.2.8", 9)};
    if (certificate.verify_issued(chain, ?wrong[0], 3, ?names[0], 8,
        ?verified).code != problem.INVALID_INPUT) { ret 8; }
    var other: [3]identifier.Identifier;
    other[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("c.example.com", 13)};
    other[1] = requested[1];
    other[2] = requested[2];
    if (certificate.verify_issued(chain, ?other[0], 3, ?names[0], 8,
        ?verified).code != problem.INVALID_INPUT) { ret 9; }

    # name storage smaller than the certificate's own name count fails closed
    if (certificate.parse_certificate(chain.certificates[0].der, ?names[0], 2,
        ?parsed).code != problem.OUTPUT_TOO_SMALL) { ret 10; }

    # a malformed chain never yields certificates
    var guarded:     certificate.Chain;
    val truncated:   *u8 = "-----BEGIN CERTIFICATE-----\nMIIB\n";
    val junk:        *u8 = "not a pem block at all";
    val empty_block: *u8 = "-----BEGIN CERTIFICATE-----\n-----END CERTIFICATE-----\n";
    if (!problem.failed(certificate.parse_chain(
        view.view(truncated, length(truncated)), ?certificates[0], 4,
        ?der[0], 8192, ?guarded)) ||
        !problem.failed(certificate.parse_chain(
        view.view(junk, length(junk)), ?certificates[0], 4, ?der[0], 8192,
        ?guarded)) ||
        !problem.failed(certificate.parse_chain(
        view.view(empty_block, length(empty_block)), ?certificates[0], 4,
        ?der[0], 8192, ?guarded))) { ret 11; }
    # der storage too small for the decoded certificate fails closed
    if (certificate.parse_chain(body, ?certificates[0], 4, ?der[0], 16,
        ?guarded).code != problem.OUTPUT_TOO_SMALL) { ret 12; }

    # a truncated der body is rejected rather than partially decoded
    var short_der: certificate.Certificate = chain.certificates[0];
    short_der.der.len = short_der.der.len - 40;
    if (!problem.failed(certificate.parse_certificate(short_der.der,
        ?names[0], 8, ?parsed))) { ret 13; }
    ret 0;
}

test "certificate: finalize, revocation, and alternate links encode exactly" {
    # rfc 8555 section 7.4 finalize payload
    var output:   [256]u8;
    val csr:      *u8                   = "abcde";
    val finalize: certificate.Operation = certificate.encode_finalize(
        view.view(csr, 5), contracts.Buffer{data: ?output[0], capacity: 256});
    val expected_finalize: *u8 = "{\"csr\":\"YWJjZGU\"}";
    if (problem.failed(finalize.error) ||
        finalize.written != length(expected_finalize) ||
        !equal(?output[0], expected_finalize, finalize.written)) { ret 1; }

    # rfc 8555 section 7.6 revocation payload, with the crl reason
    val revoke: certificate.Operation = certificate.encode_revoke(
        view.view(csr, 5), certificate.KEY_COMPROMISE,
        contracts.Buffer{data: ?output[0], capacity: 256});
    val expected_revoke: *u8 = "{\"certificate\":\"YWJjZGU\",\"reason\":1}";
    if (problem.failed(revoke.error) ||
        revoke.written != length(expected_revoke) ||
        !equal(?output[0], expected_revoke, revoke.written)) { ret 2; }
    val superseded: certificate.Operation = certificate.encode_revoke(
        view.view(csr, 5), certificate.SUPERSEDED,
        contracts.Buffer{data: ?output[0], capacity: 256});
    val expected_superseded: *u8 = "{\"certificate\":\"YWJjZGU\",\"reason\":4}";
    if (problem.failed(superseded.error) ||
        !equal(?output[0], expected_superseded, superseded.written)) { ret 3; }

    # an undefined crl reason and a short output both fail closed
    fill(?output[0], 0xa5, 256);
    if (certificate.encode_revoke(view.view(csr, 5), 7::certificate.Reason,
        contracts.Buffer{data: ?output[0], capacity: 256}).error.code !=
        problem.INVALID_INPUT ||
        certificate.encode_revoke(view.view(csr, 5), certificate.SUPERSEDED,
        contracts.Buffer{data: ?output[0], capacity: 8}).error.code !=
        problem.OUTPUT_TOO_SMALL ||
        certificate.encode_finalize(view.view(csr, 5),
        contracts.Buffer{data: ?output[0], capacity: 8}).error.code !=
        problem.OUTPUT_TOO_SMALL ||
        !filled(?output[0], 0xa5, 256)) { ret 4; }

    # rfc 8288 Link headers: only rel="alternate" targets are retained
    var items:  [4]field.Field;
    var fields: field.Fields = field.init(?items[0], 4,
        field.limits(4, 65536, 256, 8192));
    items[0] = field.Field{name: view.view("Link", 4),
        value:     view.view("<https://example.com/acme/directory>;rel=\"index\"", 48),
        sensitive: false};
    items[1] = field.Field{name: view.view("Link", 4),
        value:     view.view("<https://example.com/cert/alt/1>;rel=\"alternate\"", 48),
        sensitive: false};
    items[2] = field.Field{name: view.view("Link", 4),
        value:     view.view("<https://example.com/cert/alt/2>;rel=\"alternate\", <https://example.com/x>;rel=\"up\"", 82),
        sensitive: false};
    fields.len = 3;
    var text:       [512]u8;
    var urls:       [4]view.View;
    var alternates: certificate.Alternates;
    if (problem.failed(certificate.parse_alternates(
        response(status.OK, ?fields, view.view(nil, 0)), 4096, ?text[0],
        512, ?urls[0], 4, ?alternates))) { ret 5; }
    if (alternates.len != 2 ||
        !equal(alternates.urls[0].data, "https://example.com/cert/alt/1", 30) ||
        !equal(alternates.urls[1].data, "https://example.com/cert/alt/2", 30)) {
        ret 6;
    }
    # the retained urls are copies, so they outlive the response fields
    if (alternates.urls[0].data == items[1].value.data) { ret 7; }

    # a non-https alternate and a storage ceiling both fail closed
    items[1].value = view.view("<http://example.com/cert/alt/1>;rel=\"alternate\"", 47);
    if (certificate.parse_alternates(
        response(status.OK, ?fields, view.view(nil, 0)), 4096, ?text[0],
        512, ?urls[0], 4, ?alternates).code != problem.INVALID_INPUT) {
        ret 8;
    }
    items[1].value = view.view("<https://example.com/cert/alt/1>;rel=\"alternate\"", 48);
    if (certificate.parse_alternates(
        response(status.OK, ?fields, view.view(nil, 0)), 4096, ?text[0],
        8, ?urls[0], 4, ?alternates).code != problem.OUTPUT_TOO_SMALL ||
        certificate.parse_alternates(
        response(status.OK, ?fields, view.view(nil, 0)), 4096, ?text[0],
        512, ?urls[0], 1, ?alternates).code != problem.OUTPUT_TOO_SMALL) {
        ret 9;
    }
    ret 0;
}

# an in-memory certificate store. every returned range lives inside its own
# declared context, so the manager's ownership checks are exercised for real.
rec CertStore {
    anchor:        u8;
    gate:          storage.Gate;
    token:         u64;
    has_current:   bool;
    has_pending:   bool;
    current:       storage.CertificateRecord;
    pending:       storage.CertificateRecord;
    active:        storage.Transaction;
    key_bytes:     [64]u8;
    url_bytes:     [128]u8;
    chain_bytes:   [256]u8;
    name_bytes:    [64]u8;
    names:         [1]identifier.Identifier;
    secret_owner:  u8;
    stage_status:  storage.Status;
    commit_status: storage.Status;
    ready_flag:    bool;
}

fun cert_store_ready(ctx: ptr) bool {
    ret (ctx::*CertStore).ready_flag;
}

fun cert_store_aliases(ctx: ptr, data: *u8, len: usize) bool {
    val store: *CertStore = ctx::*CertStore;
    if (len == 0)                       { ret true; }
    if (!memory_range.valid(data, len)) { ret false; }
    val start:  usize = (?store.anchor)::usize;
    val finish: usize = start + $size_of(CertStore);
    val at:     usize = data::usize;
    ret at >= start && at + len <= finish;
}

fun cert_store_owns_secret(ctx: ptr, owner: ptr) bool {
    val store: *CertStore = ctx::*CertStore;
    ret owner == (?store.secret_owner)::ptr;
}

fun cert_store_begin(ctx: ptr, key: view.View,
    generation: u64) storage.BeginResult {
    val store: *CertStore = ctx::*CertStore;
    store.token = store.token + 1;
    var result: storage.BeginResult;
    result.status      = storage.SUCCESS;
    result.transaction = storage.Transaction{owner: ctx, token: store.token,
        generation: generation};
    store.active = result.transaction;
    ret result;
}

fun cert_store_stage(ctx: ptr, transaction: storage.Transaction,
    value: storage.CertificateRecord) storage.Status {
    val store: *CertStore = ctx::*CertStore;
    if (store.stage_status != storage.SUCCESS) { ret store.stage_status; }
    store.pending     = value;
    store.has_pending = true;
    store.active      = transaction;
    ret storage.SUCCESS;
}

fun cert_store_commit(ctx: ptr,
    transaction: storage.Transaction) storage.Status {
    val store: *CertStore = ctx::*CertStore;
    if (store.commit_status != storage.SUCCESS) { ret store.commit_status; }
    if (!store.has_pending ||
        store.active.token != transaction.token) { ret storage.CONFLICT; }
    store.current     = store.pending;
    store.has_current = true;
    store.has_pending = false;
    ret storage.SUCCESS;
}

fun cert_store_abort(ctx: ptr,
    transaction: storage.Transaction) storage.Status {
    val store: *CertStore = ctx::*CertStore;
    if (store.active.token != transaction.token) { ret storage.CONFLICT; }
    store.has_pending = false;
    ret storage.SUCCESS;
}

fun cert_store_load(ctx: ptr, key: view.View,
    output: *storage.CertificateSnapshot) storage.Status {
    val store:  *CertStore = ctx::*CertStore;
    var result: storage.CertificateSnapshot;
    result.status = storage.NOT_FOUND;
    if (store.has_current) { result.status = storage.SUCCESS; }
    result.current     = store.current;
    result.pending     = store.pending;
    result.transaction = store.active;
    result.has_pending = store.has_pending;
    @output            = result;
    ret result.status;
}

fun cert_store_account_begin(ctx: ptr, url: view.View,
    generation: u64) storage.BeginResult {
    var result: storage.BeginResult;
    result.status = storage.FAILED;
    ret result;
}

fun cert_store_account_stage(ctx: ptr, transaction: storage.Transaction,
    value: account.Credentials) storage.Status {
    ret storage.FAILED;
}

fun cert_store_account_load(ctx: ptr, url: view.View,
    output: *storage.Snapshot) storage.Status {
    ret storage.FAILED;
}

fun cert_store(value: *CertStore) storage.Store {
    ret storage.Store{ctx: value::ptr, context_anchor: ?value.anchor,
        context_size:      $size_of(CertStore), gate: ?value.gate,
        ready:             cert_store_ready, aliases: cert_store_aliases,
        owns_secret:       cert_store_owns_secret, begin: cert_store_begin,
        stage:             cert_store_account_stage, commit: cert_store_commit,
        abort:             cert_store_abort, load: cert_store_account_load,
        stage_certificate: cert_store_stage,
        load_certificate:  cert_store_load};
}

# builds a record whose every range lives inside the store's own context
fun cert_record(store: *CertStore, generation: u64,
    chain_len: usize) storage.CertificateRecord {
    copy(?store.key_bytes[0], "issue.live.example", 18);
    copy(?store.url_bytes[0], "https://example.com/cert/1", 26);
    var i: usize = 0;
    for (i < 256) {
        store.chain_bytes[i] = (i & 0xff)::u8;
        i                    = i + 1;
    }
    copy(?store.name_bytes[0], "issue.live.example", 18);
    store.names[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view(?store.name_bytes[0], 18)};
    ret storage.CertificateRecord{
        storage_key:     view.view(?store.key_bytes[0], 18),
        certificate_url: view.view(?store.url_bytes[0], 26),
        chain_der:       view.view(?store.chain_bytes[0], 256),
        chain_len:       chain_len,
        private_key_owner: (?store.secret_owner)::ptr,
        identifiers:     ?store.names[0], identifier_len: 1,
        not_before_unix: 1787955089, not_after_unix: 1795731089,
        generation:      generation
    };
}

fun init_cert_store(store: *CertStore, manager: *storage.Manager) bool {
    store.token               = 0;
    store.has_current         = false;
    store.has_pending         = false;
    store.stage_status        = storage.SUCCESS;
    store.commit_status       = storage.SUCCESS;
    store.ready_flag          = true;
    store.gate.initialized    = false;
    store.gate.callback_owner = 0;
    ret !problem.failed(storage.init_manager(manager, cert_store(store)));
}

test "certificate: private key and chain replacement is transactional" {
    var store:   CertStore;
    var manager: storage.Manager;
    if (!init_cert_store(?store, ?manager)) { ret 1; }

    # the first record installs at generation one against expected zero
    val first: storage.CertificateRecord = cert_record(?store, 1, 2);
    val write: storage.Write             = storage.begin_replace_certificate(?manager, 0,
        first);
    if (problem.failed(write.error) ||
        write.state != storage.WRITE_STAGED ||
        write.record != storage.RECORD_CERTIFICATE ||
        !store.has_pending || store.has_current) { ret 2; }
    if (problem.failed(storage.commit_certificate(?manager, write)) ||
        !store.has_current || store.has_pending ||
        store.current.generation != 1) { ret 3; }

    # a second replacement must name the generation it replaces
    val second: storage.CertificateRecord = cert_record(?store, 2, 2);
    val stale:  storage.Write             = storage.begin_replace_certificate(?manager, 5,
        second);
    if (!problem.failed(stale.error)) { ret 4; }
    val next: storage.Write = storage.begin_replace_certificate(?manager, 1,
        second);
    if (problem.failed(next.error) ||
        next.transaction.token <= write.transaction.token) { ret 5; }

    # abort rolls the staged replacement back and leaves the committed record
    if (problem.failed(storage.abort_certificate(?manager, next)) ||
        store.has_pending || store.current.generation != 1) { ret 6; }
    # a retired transaction cannot be committed afterwards
    if (!problem.failed(storage.commit_certificate(?manager, next))) { ret 7; }

    # one active transaction at a time
    val third: storage.Write = storage.begin_replace_certificate(?manager, 1,
        second);
    if (problem.failed(third.error)) { ret 8; }
    if (!problem.failed(storage.begin_replace_certificate(?manager, 1,
        second).error)) { ret 9; }

    # a record changed after staging no longer matches its bound digest
    store.pending.not_after_unix = store.pending.not_after_unix + 1;
    if (storage.commit_certificate(?manager, third).code !=
        problem.STORAGE_CONFLICT) { ret 10; }
    store.pending.not_after_unix = store.pending.not_after_unix - 1;
    if (problem.failed(storage.commit_certificate(?manager, third)) ||
        store.current.generation != 2) { ret 11; }

    # an interrupted replacement is recoverable after a restart
    var restarted: storage.Manager;
    store.gate.initialized    = false;
    store.gate.callback_owner = 0;
    if (problem.failed(storage.init_manager(?restarted,
        cert_store(?store)))) { ret 12; }
    val fourth:      storage.CertificateRecord = cert_record(?store, 3, 2);
    val interrupted: storage.Write             = storage.begin_replace_certificate(
        ?restarted, 2, fourth);
    if (problem.failed(interrupted.error)) { ret 13; }
    var recovered: storage.Manager;
    store.gate.initialized    = false;
    store.gate.callback_owner = 0;
    if (problem.failed(storage.init_manager(?recovered,
        cert_store(?store)))) { ret 14; }
    var snapshot: storage.CertificateSnapshot;
    if (problem.failed(storage.recover_certificate(?recovered,
        view.view(?store.key_bytes[0], 18), ?snapshot))) { ret 15; }
    if (!snapshot.has_pending || snapshot.pending.generation != 3 ||
        snapshot.current.generation != 2) { ret 16; }
    val resumed: storage.Write = storage.resume_certificate(snapshot);
    if (problem.failed(resumed.error) ||
        resumed.transaction.token != interrupted.transaction.token) {
        ret 17;
    }
    if (problem.failed(storage.commit_certificate(?recovered, resumed)) ||
        store.current.generation != 3) { ret 18; }

    # a store that declares no certificate callbacks refuses the record kind
    var plain:         CertStore;
    var plain_manager: storage.Manager;
    plain.ready_flag          = true;
    plain.token               = 0;
    plain.has_current         = false;
    plain.has_pending         = false;
    plain.stage_status        = storage.SUCCESS;
    plain.commit_status       = storage.SUCCESS;
    plain.gate.initialized    = false;
    plain.gate.callback_owner = 0;
    var account_only: storage.Store = cert_store(?plain);
    account_only.stage_certificate = nil;
    account_only.load_certificate  = nil;
    if (storage.supports_certificates(account_only)) { ret 19; }
    if (problem.failed(storage.init_manager(?plain_manager, account_only))) {
        ret 20;
    }
    val record: storage.CertificateRecord = cert_record(?plain, 1, 2);
    if (!problem.failed(storage.begin_replace_certificate(?plain_manager, 0,
        record).error)) { ret 21; }
    ret 0;
}

fun read_raw(path: *u8, buffer: *u8, capacity: usize, len: *usize) bool {
    val opened: res[fs.File, IO.Error] = fs.open(path);
    if (sel opened.err) { ret false; }
    var file:    fs.File = opened.ok;
    var total:   usize   = 0;
    var reading: bool    = true;
    for (reading) {
        val received: res[usize, IO.Error] = fs.read(file, ?buffer[total],
            capacity - total);
        if (sel received.err) {
            fs.close(?file);
            ret false;
        }
        val count: usize = received.ok;
        if (count == 0 || total + count == capacity) { reading = false; }
        total = total + count;
    }
    fs.close(?file);
    @len = total;
    ret true;
}

test "file store: documents are versioned, checksummed, and atomically replaced" {
    val path: *u8 = "/tmp/mach-acme-document.bin";
    fs.remove_file(path);
    var scratch:  [16384]u8;
    var buffer:   [8192]u8;
    val payload:  *u8 = "durable acme state";
    var document: file_store.Document;

    # a document that was never written is not a corrupt one
    if (!problem.failed(file_store.read_document(path,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?document))) { ret 1; }

    if (problem.failed(file_store.write_document(path, file_store.DOC_ORDER,
        view.view(payload, 18), ?scratch[0], 16384))) { ret 2; }
    if (problem.failed(file_store.read_document(path, file_store.DOC_ORDER,
        ?buffer[0], 8192, ?document))) { ret 3; }
    if (document.payload.len != 18 ||
        !equal(document.payload.data, payload, 18) ||
        document.version != file_store.SCHEMA_VERSION ||
        file_store.needs_migration(document)) { ret 4; }

    # durable acme state includes account keys, so the file is owner-only
    val meta: res[fs.Metadata, IO.Error] = fs.metadata(path);
    if (sel meta.err) { ret 5; }
    var found: fs.Metadata = meta.ok;
    if ((found.mode & 511) != 384) { ret 6; }

    # a document is refused when it names a different record kind
    if (!problem.failed(file_store.read_document(path,
        file_store.DOC_RENEWAL, ?buffer[0], 8192, ?document))) { ret 7; }

    # corruption anywhere in the payload is detected by the digest
    var raw:     [8192]u8;
    var raw_len: usize = 0;
    if (!read_raw(path, ?raw[0], 8192, ?raw_len) ||
        raw_len != file_store.HEADER_BYTES + 18) { ret 8; }
    raw[file_store.HEADER_BYTES + 3] = raw[file_store.HEADER_BYTES + 3] ^ 1;
    if (!fs_ok(fs.write_bytes(path, ?raw[0], raw_len, 384))) { ret 9; }
    if (file_store.read_document(path, file_store.DOC_ORDER, ?buffer[0], 8192,
        ?document).code != problem.STORAGE_FAILED) { ret 10; }

    # a truncated document, a wrong magic, and a future schema version are all
    # refused rather than partly believed
    raw[file_store.HEADER_BYTES + 3] = raw[file_store.HEADER_BYTES + 3] ^ 1;
    if (!fs_ok(fs.write_bytes(path, ?raw[0], raw_len - 4, 384)) ||
        !problem.failed(file_store.read_document(path, file_store.DOC_ORDER,
        ?buffer[0], 8192, ?document))) { ret 11; }
    if (!fs_ok(fs.write_bytes(path, ?raw[0], 20, 384)) ||
        !problem.failed(file_store.read_document(path, file_store.DOC_ORDER,
        ?buffer[0], 8192, ?document))) { ret 12; }
    var broken: [8192]u8;
    copy(?broken[0], ?raw[0], raw_len);
    broken[0] = 'X';
    if (!fs_ok(fs.write_bytes(path, ?broken[0], raw_len, 384)) ||
        !problem.failed(file_store.read_document(path, file_store.DOC_ORDER,
        ?buffer[0], 8192, ?document))) { ret 13; }
    copy(?broken[0], ?raw[0], raw_len);
    broken[11] = 99;
    if (!fs_ok(fs.write_bytes(path, ?broken[0], raw_len, 384)) ||
        !problem.failed(file_store.read_document(path, file_store.DOC_ORDER,
        ?buffer[0], 8192, ?document))) { ret 14; }

    # a replacement that fails inside the atomic write leaves the last
    # committed document exactly as it was. the scratch here is large enough
    # to encode the document but too small for the replacement's own
    # temporary-path storage, so the write fails before the destination is
    # touched, which is the path a full disk would also take.
    if (!fs_ok(fs.write_bytes(path, ?raw[0], raw_len, 384))) { ret 15; }
    val locked: *u8 = "/tmp/mach-acme-preserve.bin";
    fs.remove_file(locked);
    if (problem.failed(file_store.write_document(locked,
        file_store.DOC_ORDER, view.view(payload, 18), ?scratch[0],
        16384))) { ret 16; }
    val replaced: *u8           = "replacement that must not land";
    val starved:  usize         = file_store.HEADER_BYTES + 30 + 64;
    val outcome:  problem.Error = file_store.write_document(locked,
        file_store.DOC_ORDER, view.view(replaced, 30), ?scratch[0], starved);
    if (!problem.failed(outcome)) { ret 17; }
    if (problem.failed(file_store.read_document(locked,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?document)) ||
        document.payload.len != 18 ||
        !equal(document.payload.data, payload, 18)) { ret 18; }

    # backup and restore round trip through a fully validated document
    val backup: *u8 = "/tmp/mach-acme-document-backup.bin";
    fs.remove_file(backup);
    if (problem.failed(file_store.copy_document(locked, backup,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?scratch[0], 16384))) {
        ret 22;
    }
    if (problem.failed(file_store.write_document(locked,
        file_store.DOC_ORDER, view.view(replaced, 30), ?scratch[0],
        16384))) { ret 23; }
    if (problem.failed(file_store.copy_document(backup, locked,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?scratch[0], 16384))) {
        ret 24;
    }
    if (problem.failed(file_store.read_document(locked,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?document)) ||
        document.payload.len != 18 ||
        !equal(document.payload.data, payload, 18)) { ret 25; }
    # a corrupt source is never copied over a good destination
    copy(?broken[0], ?raw[0], raw_len);
    broken[file_store.HEADER_BYTES + 1] =
        broken[file_store.HEADER_BYTES + 1] ^ 0xff;
    if (!fs_ok(fs.write_bytes(backup, ?broken[0], raw_len, 384))) {
        ret 26;
    }
    if (!problem.failed(file_store.copy_document(backup, locked,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?scratch[0], 16384))) {
        ret 27;
    }
    if (problem.failed(file_store.read_document(locked,
        file_store.DOC_ORDER, ?buffer[0], 8192, ?document)) ||
        document.payload.len != 18) { ret 25; }

    fs.remove_file(path);
    fs.remove_file(backup);
    fs.remove_file(locked);
    ret 0;
}

fun store_credentials(key: jose.PublicKey, owner: ptr,
    generation: u64) account.Credentials {
    ret account.Credentials{account: account.Account{
        url:                     view.view("https://example.com/acme/acct/7", 31),
        status:                  account.VALID, contacts: nil, contact_len: 0,
        orders_url:              view.view("https://example.com/acme/orders/7", 32),
        terms_of_service_agreed: true
    },
        signer:     jose.signer(key), secret_owner: owner,
        generation: generation};
}

test "file store: durable records survive restart and an interrupted write" {
    val account_path:     *u8 = "/tmp/mach-acme-fs-account.bin";
    val certificate_path: *u8 = "/tmp/mach-acme-fs-cert.bin";
    fs.remove_file(account_path);
    fs.remove_file(certificate_path);
    var public_bytes:  [65]u8;
    var private_bytes: [32]^u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }

    var store:   file_store.Store;
    var manager: storage.Manager;
    if (problem.failed(file_store.open_store(?store, account_path,
        certificate_path))) { ret 2; }
    if (problem.failed(storage.init_manager(?manager,
        file_store.descriptor(?store)))) { ret 3; }

    # the first account record commits at generation one
    val first: account.Credentials = store_credentials(public_key,
        file_store.secret_owner(?store), 1);
    val save: storage.Write = storage.begin_save(?manager, 0, first);
    if (problem.failed(save.error))                           { ret 4; }
    if (problem.failed(storage.commit_write(?manager, save))) { ret 5; }

    # a fresh store reads back exactly what was committed
    var reopened:         file_store.Store;
    var reopened_manager: storage.Manager;
    if (problem.failed(file_store.open_store(?reopened, account_path,
        certificate_path))) { ret 6; }
    if (problem.failed(storage.init_manager(?reopened_manager,
        file_store.descriptor(?reopened)))) { ret 7; }
    var recovered: storage.Snapshot;
    if (problem.failed(storage.recover(?reopened_manager,
        view.view("https://example.com/acme/acct/7", 31),
        ?recovered))) { ret 8; }
    if (recovered.status != storage.SUCCESS || recovered.has_pending ||
        recovered.current.generation != 1 ||
        recovered.current.account.status != account.VALID ||
        !recovered.current.account.terms_of_service_agreed ||
        !equal(recovered.current.account.url.data,
        "https://example.com/acme/acct/7", 31) ||
        !equal(recovered.current.account.orders_url.data,
        "https://example.com/acme/orders/7", 32)) { ret 9; }
    # the public key round trips exactly; the private key never went to disk
    if (recovered.current.signer.public_key.algorithm != jose.ES256 ||
        recovered.current.signer.public_key.value.len != 65 ||
        !equal(recovered.current.signer.public_key.value.data,
        ?public_bytes[0], 65) ||
        recovered.current.secret_owner !=
        file_store.secret_owner(?reopened)) { ret 10; }

    # a staged replacement that is never committed is a crash. the next run
    # sees it as pending with the committed record untouched.
    val next: account.Credentials = store_credentials(public_key,
        file_store.secret_owner(?reopened), 2);
    val staged: storage.Write = storage.begin_replace(?reopened_manager,
        recovered.current, next);
    if (problem.failed(staged.error)) { ret 11; }

    var crashed:         file_store.Store;
    var crashed_manager: storage.Manager;
    if (problem.failed(file_store.open_store(?crashed, account_path,
        certificate_path))) { ret 12; }
    if (problem.failed(storage.init_manager(?crashed_manager,
        file_store.descriptor(?crashed)))) { ret 13; }
    var after_crash: storage.Snapshot;
    if (problem.failed(storage.recover(?crashed_manager,
        view.view("https://example.com/acme/acct/7", 31),
        ?after_crash))) { ret 14; }
    if (!after_crash.has_pending || after_crash.current.generation != 1 ||
        after_crash.pending.generation != 2) { ret 15; }
    # the token sequence is monotonic across the restart
    if (after_crash.transaction.token != staged.transaction.token) { ret 16; }

    # the recovered replacement can be finished deliberately
    val resumed: storage.Write = storage.resume(after_crash);
    if (problem.failed(resumed.error) ||
        problem.failed(storage.authorize_recovered_replace(?crashed_manager,
        resumed))) { ret 17; }
    if (problem.failed(storage.commit_write(?crashed_manager, resumed))) {
        ret 18;
    }
    var settled:         file_store.Store;
    var settled_manager: storage.Manager;
    var final_snapshot:  storage.Snapshot;
    if (problem.failed(file_store.open_store(?settled, account_path,
        certificate_path)) ||
        problem.failed(storage.init_manager(?settled_manager,
        file_store.descriptor(?settled))) ||
        problem.failed(storage.recover(?settled_manager,
        view.view("https://example.com/acme/acct/7", 31),
        ?final_snapshot))) { ret 19; }
    if (final_snapshot.has_pending ||
        final_snapshot.current.generation != 2) { ret 20; }

    # a certificate record uses the same manager, gate, and token sequence
    var chain: [64]u8;
    var i:     usize = 0;
    for (i < 64) {
        chain[i] = (i & 0xff)::u8;
        i        = i + 1;
    }
    var names: [1]identifier.Identifier;
    names[0] = identifier.Identifier{kind: identifier.DNS,
        value: view.view("issue.example.com", 17)};
    val record: storage.CertificateRecord = storage.CertificateRecord{
        storage_key:       view.view("issue.example.com", 17),
        certificate_url:   view.view("https://example.com/cert/7", 26),
        chain_der:         view.view(?chain[0], 64), chain_len: 2,
        private_key_owner: file_store.secret_owner(?settled),
        identifiers:       ?names[0], identifier_len: 1,
        not_before_unix:   1787955089, not_after_unix: 1795731089,
        generation:        1
    };
    val certificate_write: storage.Write =
        storage.begin_replace_certificate(?settled_manager, 0, record);
    if (problem.failed(certificate_write.error)) { ret 21; }
    # the certificate transaction draws from the same monotonic sequence
    if (certificate_write.transaction.token <=
        after_crash.transaction.token) { ret 22; }
    if (problem.failed(storage.commit_certificate(?settled_manager,
        certificate_write))) { ret 23; }

    var final_store:          file_store.Store;
    var final_manager:        storage.Manager;
    var certificate_snapshot: storage.CertificateSnapshot;
    if (problem.failed(file_store.open_store(?final_store, account_path,
        certificate_path)) ||
        problem.failed(storage.init_manager(?final_manager,
        file_store.descriptor(?final_store))) ||
        problem.failed(storage.recover_certificate(?final_manager,
        view.view("issue.example.com", 17),
        ?certificate_snapshot))) { ret 24; }
    if (certificate_snapshot.status != storage.SUCCESS ||
        certificate_snapshot.has_pending ||
        certificate_snapshot.current.generation != 1 ||
        certificate_snapshot.current.chain_len != 2 ||
        certificate_snapshot.current.chain_der.len != 64 ||
        !equal(certificate_snapshot.current.chain_der.data, ?chain[0], 64) ||
        certificate_snapshot.current.identifier_len != 1 ||
        !equal(certificate_snapshot.current.identifiers[0].value.data,
        "issue.example.com", 17) ||
        certificate_snapshot.current.not_after_unix != 1795731089) { ret 25; }
    # the account record is still intact alongside it
    var both: storage.Snapshot;
    if (problem.failed(storage.recover(?final_manager,
        view.view("https://example.com/acme/acct/7", 31), ?both)) ||
        both.current.generation != 2) { ret 26; }

    # a corrupt durable document is reported rather than read as absent
    var raw:     [8192]u8;
    var raw_len: usize = 0;
    if (!read_raw(account_path, ?raw[0], 8192, ?raw_len)) { ret 27; }
    raw[file_store.HEADER_BYTES + 2] = raw[file_store.HEADER_BYTES + 2] ^ 0xff;
    if (!fs_ok(fs.write_bytes(account_path, ?raw[0], raw_len, 384))) {
        ret 28;
    }
    var corrupt: file_store.Store;
    if (!problem.failed(file_store.open_store(?corrupt, account_path,
        certificate_path))) { ret 29; }

    fs.remove_file(account_path);
    fs.remove_file(certificate_path);
    ret 0;
}

rec StoreRaceContext {
    manager:     *storage.Manager;
    credentials: *account.Credentials;
    result:      *i64;
}

fun store_race_worker(arg: *u8) {
    val context: *StoreRaceContext = arg::*StoreRaceContext;
    val write:   storage.Write     = storage.begin_save(context.manager, 0,
        @context.credentials);
    if (problem.failed(write.error)) {
        atomic.store(context.result, -1);
        ret;
    }
    if (problem.failed(storage.commit_write(context.manager, write))) {
        atomic.store(context.result, -2);
        ret;
    }
    atomic.store(context.result, 1);
}

test "file store: concurrent writers are serialized to one committed record" {
    val account_path:     *u8 = "/tmp/mach-acme-fs-race-account.bin";
    val certificate_path: *u8 = "/tmp/mach-acme-fs-race-cert.bin";
    fs.remove_file(account_path);
    fs.remove_file(certificate_path);
    var public_bytes:  [65]u8;
    var private_bytes: [32]^u8;
    var public_key:    jose.PublicKey;
    var private_key:   jose.PrivateKey;
    if (!es_keys(?public_key, ?private_key, ?private_bytes[0],
        ?public_bytes[0])) { ret 1; }
    var store: file_store.Store;
    if (problem.failed(file_store.open_store(?store, account_path,
        certificate_path))) { ret 2; }

    # two managers over one store share its gate, so the one-active-transaction
    # rule holds across manager instances and across threads
    var first_manager:  storage.Manager;
    var second_manager: storage.Manager;
    if (problem.failed(storage.init_manager(?first_manager,
        file_store.descriptor(?store))) ||
        problem.failed(storage.init_manager(?second_manager,
        file_store.descriptor(?store)))) { ret 3; }

    var credentials: account.Credentials = store_credentials(public_key,
        file_store.secret_owner(?store), 1);
    var first_result:  i64              = 0;
    var second_result: i64              = 0;
    var first_context: StoreRaceContext = StoreRaceContext{
        manager: ?first_manager, credentials: ?credentials,
        result:  ?first_result
    };
    var second_context: StoreRaceContext = StoreRaceContext{
        manager: ?second_manager, credentials: ?credentials,
        result:  ?second_result
    };
    var first_thread:  thread.Thread;
    var second_thread: thread.Thread;
    thread.spawn_with(store_race_worker, (?first_context)::*u8,
        ?first_thread);
    if (first_thread.tid < 0) { ret 4; }
    thread.spawn_with(store_race_worker, (?second_context)::*u8,
        ?second_thread);
    if (second_thread.tid < 0) {
        thread.join(?first_thread);
        ret 5;
    }
    thread.join(?first_thread);
    thread.join(?second_thread);

    # exactly one writer may install the first record; the other is refused
    # rather than both landing or the file being interleaved
    val first_outcome:  i64 = atomic.load(?first_result);
    val second_outcome: i64 = atomic.load(?second_result);
    if (first_outcome == 1 && second_outcome == 1)    { ret 6; }
    if (first_outcome != 1 && second_outcome != 1)    { ret 7; }
    if (atomic.load(?store.gate.callback_owner) != 0) { ret 8; }

    # the durable document is a complete, valid record afterwards
    var settled:         file_store.Store;
    var settled_manager: storage.Manager;
    var snapshot:        storage.Snapshot;
    if (problem.failed(file_store.open_store(?settled, account_path,
        certificate_path)) ||
        problem.failed(storage.init_manager(?settled_manager,
        file_store.descriptor(?settled))) ||
        problem.failed(storage.recover(?settled_manager,
        view.view("https://example.com/acme/acct/7", 31), ?snapshot))) {
        ret 9;
    }
    if (snapshot.status != storage.SUCCESS || snapshot.has_pending ||
        snapshot.current.generation != 1) { ret 10; }

    fs.remove_file(account_path);
    fs.remove_file(certificate_path);
    ret 0;
}

test "renewal info: certificate identifiers, urls, and windows are exact" {
    val pem:          *u8 = leaf_pem();
    var certificates: [4]certificate.Certificate;
    var der:          [8192]u8;
    var chain:        certificate.Chain;
    if (problem.failed(certificate.parse_chain(
        view.view(pem, length(pem)), ?certificates[0], 4, ?der[0], 8192,
        ?chain))) { ret 1; }

    # draft-ietf-acme-ari section 4.1, checked against a value computed from
    # the certificate's own authority key identifier and serial number
    var id_bytes: [128]u8;
    val id:       renewal_info.Operation = renewal_info.certificate_id(
        chain.certificates[0].der,
        contracts.Buffer{data: ?id_bytes[0], capacity: 128});
    val expected_id: *u8 = "JN2JEPbmZ7Tb4bkwIh4k5MdM9bU.bnYIUfdvfMCkoKJt0Eea62OURk4";
    if (problem.failed(id.error) || id.written != length(expected_id) ||
        !equal(?id_bytes[0], expected_id, id.written)) { ret 2; }

    # the request url joins the directory's base with that identifier, and a
    # base that already ends in a slash does not gain a second one
    var url_bytes: [512]u8;
    val joined:    renewal_info.Operation = renewal_info.request_url(
        view.view("https://example.com/acme/renewal-info", 37), id.value,
        4096, contracts.Buffer{data: ?url_bytes[0], capacity: 512});
    val expected_url: *u8 = "https://example.com/acme/renewal-info/JN2JEPbmZ7Tb4bkwIh4k5MdM9bU.bnYIUfdvfMCkoKJt0Eea62OURk4";
    if (problem.failed(joined.error) ||
        joined.written != length(expected_url) ||
        !equal(?url_bytes[0], expected_url, joined.written)) { ret 3; }
    val slashed: renewal_info.Operation = renewal_info.request_url(
        view.view("https://example.com/acme/renewal-info/", 38), id.value,
        4096, contracts.Buffer{data: ?url_bytes[0], capacity: 512});
    if (problem.failed(slashed.error) ||
        slashed.written != length(expected_url) ||
        !equal(?url_bytes[0], expected_url, slashed.written)) { ret 4; }

    # a short output and a non-https base both fail closed
    fill(?url_bytes[0], 0xa5, 512);
    if (renewal_info.request_url(
        view.view("https://example.com/acme/renewal-info", 37), id.value,
        4096, contracts.Buffer{data: ?url_bytes[0], capacity: 16}).error.code != problem.OUTPUT_TOO_SMALL ||
        renewal_info.request_url(
        view.view("http://example.com/acme/renewal-info", 36), id.value,
        4096, contracts.Buffer{data: ?url_bytes[0], capacity: 512}).error.code != problem.INVALID_INPUT ||
        !filled(?url_bytes[0], 0xa5, 512)) { ret 5; }

    # a suggested window decodes to unix seconds and carries the advice
    var fields: field.Fields;
    empty_fields(?fields);
    var scratch: [16384]u8;
    var window:  renewal_info.Window;
    val body:    *u8             = "{\"suggestedWindow\":{\"start\":\"2026-01-02T03:04:05Z\",\"end\":\"2026-01-09T03:04:05Z\"}}";
    var advised: client.Response = response(status.OK, ?fields,
        view.view(body, length(body)));
    advised.retry_after_seconds = 21600;
    if (problem.failed(renewal_info.parse(advised, client.limits_default(),
        ?scratch[0], 16384, ?window))) { ret 6; }
    if (!renewal_info.window_valid(window) ||
        window.start_unix != 1767323045 ||
        window.end_unix != 1767927845 ||
        window.retry_after_seconds != 21600) { ret 7; }
    ret 0;
}
