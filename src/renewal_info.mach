# acme renewal information (draft-ietf-acme-ari)
#
# an authority may publish the window in which it would prefer a certificate to
# be renewed. the window is advice: it is validated, clamped, and combined with
# the local policy rather than obeyed blindly.

use crypto.contracts;
use http.core.field;
use http.core.status;
use J: std.data.json;
use R: std.types.result;
use std.encoding.base64;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.certificate;
use acme.client;
use acme.json;
use acme.memory_range;
use acme.problem;

# base64url of a 20-byte key identifier and a 20-byte serial, plus the dot
pub val MAX_CERTIFICATE_ID_BYTES: usize = 64;
pub val MAX_TIME_BYTES: usize = 64;

pub rec Window {
    start_unix:          u64;
    end_unix:            u64;
    retry_after_seconds: u64;
    explanation:         view.View;
    present:             bool;
}

pub fun empty_window() Window {
    ret Window{start_unix: 0, end_unix: 0, retry_after_seconds: 0,
        explanation: view.view(nil, 0), present: false};
}

pub fun window_valid(value: Window) bool {
    ret value.present && value.end_unix > value.start_unix;
}

pub rec Operation {
    error:   problem.Error;
    written: usize;
    value:   view.View;
}

fun failed(kind: problem.Kind, code: problem.Code, detail: str) Operation {
    ret Operation{error: problem.local_code(kind, code, detail), written: 0,
        value: view.view(nil, 0)};
}

# draft-ietf-acme-ari section 4.1: base64url(akiKeyIdentifier) "."
# base64url(serialNumber), both unpadded and over the exact der octets
pub fun certificate_id(der: view.View, output: contracts.Buffer) Operation {
    if (output.data == nil ||
        !memory_range.valid(output.data, output.capacity) ||
        memory_range.overlap(output.data, output.capacity, der.data,
            der.len)) {
        ret failed(problem.PROTOCOL, problem.INVALID_INPUT,
            "invalid renewal identifier output");
    }
    var key_id: view.View;
    var serial: view.View;
    val parts: problem.Error = certificate.renewal_id_parts(der, ?key_id,
        ?serial);
    if (problem.failed(parts)) {
        ret Operation{error: parts, written: 0, value: view.view(nil, 0)};
    }
    if (output.capacity < MAX_CERTIFICATE_ID_BYTES) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "renewal identifier output is too small");
    }
    val key_written: usize = base64.encode_url(key_id.data, key_id.len,
        output.data, output.capacity);
    if (key_written == 0 || key_written >= output.capacity - 2) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "renewal identifier key encoding failed");
    }
    output.data[key_written] = '.';
    val serial_written: usize = base64.encode_url(serial.data, serial.len,
        ?output.data[key_written + 1], output.capacity - key_written - 1);
    if (serial_written == 0) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "renewal identifier serial encoding failed");
    }
    val total: usize = key_written + 1 + serial_written;
    ret Operation{error: problem.none(), written: total,
        value: view.view(output.data, total)};
}

# the renewalInfo endpoint is the directory's base joined with the identifier
pub fun request_url(base: view.View, certificate_id_value: view.View,
    max_url_bytes: usize, output: contracts.Buffer) Operation {
    if (output.data == nil ||
        !memory_range.valid(output.data, output.capacity) ||
        !client.url_valid(base, max_url_bytes) ||
        !memory_range.valid(certificate_id_value.data,
            certificate_id_value.len) ||
        certificate_id_value.len == 0 ||
        certificate_id_value.len > MAX_CERTIFICATE_ID_BYTES ||
        memory_range.overlap(output.data, output.capacity, base.data,
            base.len) ||
        memory_range.overlap(output.data, output.capacity,
            certificate_id_value.data, certificate_id_value.len)) {
        ret failed(problem.PROTOCOL, problem.INVALID_INPUT,
            "invalid renewal information url inputs");
    }
    var separator: usize = 1;
    if (base.data[base.len - 1] == '/') { separator = 0; }
    val total: usize = base.len + separator + certificate_id_value.len;
    if (total > max_url_bytes || output.capacity < total) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "renewal information url output is too small");
    }
    var i: usize = 0;
    for (i < base.len) {
        output.data[i] = base.data[i];
        i = i + 1;
    }
    if (separator == 1) { output.data[base.len] = '/'; }
    i = 0;
    for (i < certificate_id_value.len) {
        output.data[base.len + separator + i] = certificate_id_value.data[i];
        i = i + 1;
    }
    val built: view.View = view.view(output.data, total);
    if (!client.url_valid(built, max_url_bytes)) {
        ret failed(problem.PROTOCOL, problem.INVALID_INPUT,
            "renewal information url is not a valid https url");
    }
    ret Operation{error: problem.none(), written: total, value: built};
}

# renewalInfo is fetched with an unauthenticated GET
pub fun request(url: view.View, configured: client.Limits) client.WireRequest {
    ret client.discovery_request(url, configured);
}

fun digits2(data: *u8, at: usize) i64 {
    ret ((data[at] - '0')::i64) * 10 + (data[at + 1] - '0')::i64;
}

fun all_digits(data: *u8, at: usize, count: usize) bool {
    var i: usize = 0;
    for (i < count) {
        if (data[at + i] < '0' || data[at + i] > '9') { ret false; }
        i = i + 1;
    }
    ret true;
}

fun days_from_civil(year: i64, month: i64, day: i64) i64 {
    var y: i64 = year;
    if (month <= 2) { y = y - 1; }
    var era: i64 = y / 400;
    if (y < 0) { era = (y - 399) / 400; }
    val yoe: i64 = y - era * 400;
    var shifted: i64 = month + 9;
    if (month > 2) { shifted = month - 3; }
    val doy: i64 = (153 * shifted + 2) / 5 + day - 1;
    val doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    ret era * 146097 + doe - 719468;
}

# rfc 3339 instants in zulu. a fractional second is accepted and truncated,
# and a numeric offset is applied, so an authority's exact spelling is honoured
fun parse_timestamp(value: view.View, output: *u64) bool {
    if (!memory_range.valid(value.data, value.len) || value.len < 20 ||
        value.len > MAX_TIME_BYTES) { ret false; }
    if (!all_digits(value.data, 0, 4) || value.data[4] != '-' ||
        !all_digits(value.data, 5, 2) || value.data[7] != '-' ||
        !all_digits(value.data, 8, 2) ||
        (value.data[10] != 'T' && value.data[10] != 't') ||
        !all_digits(value.data, 11, 2) || value.data[13] != ':' ||
        !all_digits(value.data, 14, 2) || value.data[16] != ':' ||
        !all_digits(value.data, 17, 2)) { ret false; }
    val year: i64 = digits2(value.data, 0) * 100 + digits2(value.data, 2);
    val month: i64 = digits2(value.data, 5);
    val day: i64 = digits2(value.data, 8);
    val hour: i64 = digits2(value.data, 11);
    val minute: i64 = digits2(value.data, 14);
    val second: i64 = digits2(value.data, 17);
    if (month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 ||
        minute > 59 || second > 60) { ret false; }
    var i: usize = 19;
    if (i < value.len && value.data[i] == '.') {
        i = i + 1;
        val start: usize = i;
        for (i < value.len && value.data[i] >= '0' &&
            value.data[i] <= '9') { i = i + 1; }
        if (i == start) { ret false; }
    }
    var offset: i64 = 0;
    if (i == value.len) { ret false; }
    if (value.data[i] == 'Z' || value.data[i] == 'z') {
        if (i + 1 != value.len) { ret false; }
    } or (value.data[i] == '+' || value.data[i] == '-') {
        if (i + 6 != value.len || value.data[i + 3] != ':' ||
            !all_digits(value.data, i + 1, 2) ||
            !all_digits(value.data, i + 4, 2)) { ret false; }
        val offset_hours: i64 = digits2(value.data, i + 1);
        val offset_minutes: i64 = digits2(value.data, i + 4);
        if (offset_hours > 23 || offset_minutes > 59) { ret false; }
        offset = offset_hours * 3600 + offset_minutes * 60;
        if (value.data[i] == '+') { offset = 0 - offset; }
    } or { ret false; }
    val stamp: i64 = days_from_civil(year, month, day) * 86400 +
        hour * 3600 + minute * 60 + second + offset;
    if (stamp < 0) { ret false; }
    @output = stamp::u64;
    ret true;
}

fun decoded_len(value: *J.Value, maximum: usize, output: *usize) bool {
    if (value == nil || value.kind != J.STRING || output == nil) { ret false; }
    val result: R.Result[usize, str] = J.value_string_decode(value, nil, 0);
    if (R.is_err[usize, str](result)) { ret false; }
    val len: usize = R.unwrap_ok[usize, str](result);
    if (len > maximum) { ret false; }
    @output = len;
    ret true;
}

fun decode_timestamp(value: *J.Value, output: *u64) bool {
    var len: usize = 0;
    if (!decoded_len(value, MAX_TIME_BYTES, ?len)) { ret false; }
    var decoded: [64]u8;
    val result: R.Result[usize, str] = J.value_string_decode(value,
        ?decoded[0], 64);
    if (R.is_err[usize, str](result)) { ret false; }
    ret parse_timestamp(view.view(?decoded[0], len), output);
}

# the authority's advice is validated before it is retained. a window that is
# inverted, absent, or unparseable leaves the caller on its own policy.
pub fun parse(response: client.Response, configured: client.Limits,
    scratch: *u8, scratch_capacity: usize, output: *Window) problem.Error {
    if (output == nil || !memory_range.valid(output::*u8, $size_of(Window)) ||
        response.fields == nil || !status.is_final(response.status) ||
        response.body.data == nil || response.body.len == 0 ||
        !memory_range.valid(response.body.data, response.body.len) ||
        response.body.len > configured.max_response_bytes || scratch == nil ||
        scratch_capacity == 0 ||
        !memory_range.valid(scratch, scratch_capacity) ||
        memory_range.overlap(scratch, scratch_capacity, output::*u8,
            $size_of(Window)) ||
        memory_range.overlap(scratch, scratch_capacity, response.body.data,
            response.body.len)) {
        ret problem.local_code(problem.PROTOCOL, problem.INVALID_INPUT,
            "invalid renewal information response");
    }
    if (response.status != status.OK) {
        ret problem.http(response.status, response.body,
            response.retry_after_seconds);
    }
    var usable: usize = scratch_capacity;
    if (usable > configured.max_json_scratch) {
        usable = configured.max_json_scratch;
    }
    val document: json.Document = json.parse(response.body, scratch, usable,
        json.Limits{max_bytes: configured.max_response_bytes,
            max_depth: configured.max_json_depth,
            max_values: configured.max_json_values,
            max_key_bytes: configured.max_json_key_bytes,
            max_key_comparisons: configured.max_json_key_comparisons});
    if (!document.valid) { ret document.error; }
    var root: J.Value = document.root;
    if (root.kind != J.OBJECT) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "renewal information is not an object");
    }
    val suggested: *J.Value = json.find(?root, "suggestedWindow");
    if (suggested == nil || suggested.kind != J.OBJECT) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "renewal information has no suggested window");
    }
    var result: Window = empty_window();
    if (!decode_timestamp(json.find(suggested, "start"), ?result.start_unix) ||
        !decode_timestamp(json.find(suggested, "end"), ?result.end_unix)) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "renewal information window is not a pair of rfc 3339 instants");
    }
    if (result.end_unix <= result.start_unix) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "renewal information window ends before it starts");
    }
    result.retry_after_seconds = response.retry_after_seconds;
    result.present = true;
    @output = result;
    ret problem.none();
}
