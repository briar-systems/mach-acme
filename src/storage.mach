# transactional durable account credential storage

use crypto.contracts;
use crypto.hash;
use std.system.os;
use std.sync.atomic;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;
use acme.account;
use acme.client;
use acme.jose;
use acme.memory_range;
use acme.problem;

pub def Status: u8;

pub val SUCCESS: Status = 1;
pub val NOT_FOUND: Status = 2;
pub val CONFLICT: Status = 3;
pub val FAILED: Status = 4;
pub val UNKNOWN: Status = 5;

pub rec Transaction {
    owner:      ptr;
    token:      u64;
    generation: u64;
}

pub rec BeginResult {
    status:      Status;
    transaction: Transaction;
}

pub rec Snapshot {
    status:      Status;
    current:     account.Credentials;
    pending:     account.Credentials;
    transaction: Transaction;
    has_pending: bool;
}

pub def WriteState: u8;

pub val WRITE_EMPTY:     WriteState = 0;
pub val WRITE_STAGED:    WriteState = 1;
pub val WRITE_UNCERTAIN: WriteState = 2;

pub def WriteKind: u8;

pub val WRITE_SAVE:    WriteKind = 1;
pub val WRITE_REPLACE: WriteKind = 2;

pub def ActiveState: u8;

pub val ACTIVE_IDLE:      ActiveState = 0;
pub val ACTIVE_STAGED:    ActiveState = 1;
pub val ACTIVE_WIRE:      ActiveState = 2;
pub val ACTIVE_RECOVERED: ActiveState = 3;

pub rec Write {
    error:       problem.Error;
    transaction: Transaction;
    candidate:   account.Credentials;
    digest:      [32]u8;
    state:       WriteState;
    kind:        WriteKind;
    prepared:    bool;
}

pub def ReadyFun: fun(ptr) bool;
pub def AliasesFun: fun(ptr, *u8, usize) bool;
pub def OwnsSecretFun: fun(ptr, ptr) bool;
pub def BeginFun: fun(ptr, view.View, u64) BeginResult;
pub def StageFun: fun(ptr, Transaction, account.Credentials) Status;
pub def FinishFun: fun(ptr, Transaction) Status;
pub def LoadFun: fun(ptr, view.View, *Snapshot) Status;

pub rec Gate {
    callback_owner: i64;
    last_token: u64;
    active_transaction: Transaction;
    active_digest: [32]u8;
    active_state: ActiveState;
    active_kind: WriteKind;
    ctx: ptr;
    context_anchor: *u8;
    context_size: usize;
    ready: ReadyFun;
    aliases: AliasesFun;
    owns_secret: OwnsSecretFun;
    begin: BeginFun;
    stage: StageFun;
    commit: FinishFun;
    abort: FinishFun;
    load: LoadFun;
    initialized: bool;
}

pub rec Store {
    ctx:         ptr;
    context_anchor: *u8;
    context_size: usize;
    gate:        *Gate;
    ready:       ReadyFun;
    aliases:     AliasesFun;
    owns_secret: OwnsSecretFun;
    begin:       BeginFun;
    stage:       StageFun;
    commit:      FinishFun;
    abort:       FinishFun;
    load:        LoadFun;
}

pub rec Manager {
    store:       Store;
    gate:        *Gate;
    self_owner:  *Manager;
    initialized: bool;
}

rec ManagerGuard {
    store: Store;
    gate: *Gate;
    last_token: u64;
    active_transaction: Transaction;
    active_digest: [32]u8;
    active_state: ActiveState;
    active_kind: WriteKind;
    initialized: bool;
}

fun store_shape(value: Store) bool {
    ret value.ctx != nil && value.context_anchor != nil &&
        value.context_size != 0 &&
        memory_range.valid(value.context_anchor, value.context_size) &&
        memory_range.overlap(value.ctx::*u8, 1, value.context_anchor,
            value.context_size) && value.gate != nil &&
        memory_range.valid(value.gate::*u8, $size_of(Gate)) &&
        memory_range.overlap(value.gate::*u8, $size_of(Gate),
            value.context_anchor, value.context_size) && value.ready:^ != nil &&
        value.aliases:^ != nil &&
        value.owns_secret:^ != nil && value.begin:^ != nil &&
        value.stage:^ != nil && value.commit:^ != nil &&
        value.abort:^ != nil && value.load:^ != nil;
}

fun store_same(first: Store, second: Store) bool {
    ret first.ctx == second.ctx &&
        first.context_anchor == second.context_anchor &&
        first.context_size == second.context_size &&
        first.gate == second.gate &&
        first.ready:^ == second.ready:^ &&
        first.aliases:^ == second.aliases:^ &&
        first.owns_secret:^ == second.owns_secret:^ &&
        first.begin:^ == second.begin:^ && first.stage:^ == second.stage:^ &&
        first.commit:^ == second.commit:^ && first.abort:^ == second.abort:^ &&
        first.load:^ == second.load:^;
}

fun gate_same(value: *Gate, store: Store) bool {
    ret value != nil && value.initialized && value.ctx == store.ctx &&
        value.context_anchor == store.context_anchor &&
        value.context_size == store.context_size &&
        value.ready:^ == store.ready:^ && value.aliases:^ == store.aliases:^ &&
        value.owns_secret:^ == store.owns_secret:^ &&
        value.begin:^ == store.begin:^ && value.stage:^ == store.stage:^ &&
        value.commit:^ == store.commit:^ && value.abort:^ == store.abort:^ &&
        value.load:^ == store.load:^;
}

fun status_valid(value: Status) bool {
    ret value == SUCCESS || value == NOT_FOUND || value == CONFLICT ||
        value == FAILED || value == UNKNOWN;
}

fun transaction_valid(value: Transaction, store: Store,
    generation: u64) bool {
    ret value.owner == store.ctx && value.token != 0 &&
        value.generation == generation;
}

fun transaction_empty(value: Transaction) bool {
    ret value.owner == nil && value.token == 0 && value.generation == 0;
}

fun transaction_same(first: Transaction, second: Transaction) bool {
    ret first.owner == second.owner && first.token == second.token &&
        first.generation == second.generation;
}

fun digest_update(context: *hash.Sha256, data: *u8, len: usize) bool {
    if (!memory_range.valid(data, len)) { ret false; }
    ret hash.update_sha256(context,
        contracts.Bytes{data: data, len: len}) == contracts.OK;
}

pub fun credentials_digest(value: account.Credentials, output: *u8) bool {
    if (!account.credentials_valid(value) ||
        !memory_range.valid(output, 32)) { ret false; }
    var context: hash.Sha256 = hash.empty_sha256();
    if (hash.init_sha256(?context) != contracts.OK) { ret false; }
    var generation: u64 = value.generation;
    var algorithm: u8 = value.signer.algorithm;
    var account_status: u8 = value.account.status;
    var agreed: bool = value.account.terms_of_service_agreed;
    var contact_len: usize = value.account.contact_len;
    var url_len: usize = value.account.url.len;
    var orders_len: usize = value.account.orders_url.len;
    var owner: ptr = value.secret_owner;
    var max_jwk: usize = value.signer.max_jwk_bytes;
    var max_thumb: usize = value.signer.max_thumb_bytes;
    var max_signature: usize = value.signer.max_signature_bytes;
    if (!digest_update(?context, value.account.url.data, value.account.url.len) ||
        !digest_update(?context, (?url_len)::*u8, $size_of(usize)) ||
        !digest_update(?context, value.account.orders_url.data,
            value.account.orders_url.len) ||
        !digest_update(?context, (?orders_len)::*u8, $size_of(usize)) ||
        !digest_update(?context, (?generation)::*u8, $size_of(u64)) ||
        !digest_update(?context, (?algorithm)::*u8, $size_of(u8)) ||
        !digest_update(?context, (?account_status)::*u8, $size_of(u8)) ||
        !digest_update(?context, (?agreed)::*u8, $size_of(bool)) ||
        !digest_update(?context, (?contact_len)::*u8, $size_of(usize)) ||
        !digest_update(?context, (?owner)::*u8, $size_of(ptr)) ||
        !digest_update(?context, (?max_jwk)::*u8, $size_of(usize)) ||
        !digest_update(?context, (?max_thumb)::*u8, $size_of(usize)) ||
        !digest_update(?context, (?max_signature)::*u8, $size_of(usize))) {
        hash.destroy_sha256(?context);
        ret false;
    }
    var i: usize = 0;
    for (i < value.account.contact_len) {
        var item_len: usize = value.account.contacts[i].len;
        if (!digest_update(?context, value.account.contacts[i].data,
                value.account.contacts[i].len) ||
            !digest_update(?context, (?item_len)::*u8, $size_of(usize))) {
            hash.destroy_sha256(?context);
            ret false;
        }
        i = i + 1;
    }
    val key: jose.PublicKey = value.signer.public_key;
    var value_len: usize = key.value.len;
    var modulus_len: usize = key.rsa.modulus.len;
    var exponent_len: usize = key.rsa.exponent.len;
    if (key.algorithm == jose.ES256 || key.algorithm == jose.EDDSA) {
        if (!digest_update(?context, key.value.data, key.value.len) ||
            !digest_update(?context, (?value_len)::*u8, $size_of(usize))) {
            hash.destroy_sha256(?context);
            ret false;
        }
    } or {
        if (!digest_update(?context, key.rsa.modulus.data, key.rsa.modulus.len) ||
            !digest_update(?context, (?modulus_len)::*u8, $size_of(usize)) ||
            !digest_update(?context, key.rsa.exponent.data, key.rsa.exponent.len) ||
            !digest_update(?context, (?exponent_len)::*u8, $size_of(usize))) {
            hash.destroy_sha256(?context);
            ret false;
        }
    }
    val result: contracts.Operation = hash.final_sha256(?context,
        contracts.Buffer{data: output, capacity: 32});
    ret result.error == contracts.OK && result.written == 32;
}

fun digest_same(value: account.Credentials, expected: *u8) bool {
    var actual: [32]u8;
    if (!credentials_digest(value, ?actual[0])) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun view_digest(value: view.View, output: *u8) bool {
    if (!memory_range.valid(value.data, value.len) ||
        !memory_range.valid(output, 32)) { ret false; }
    var context: hash.Sha256 = hash.empty_sha256();
    if (hash.init_sha256(?context) != contracts.OK ||
        hash.update_sha256(?context, contracts.Bytes{data: value.data,
            len: value.len}) != contracts.OK) {
        hash.destroy_sha256(?context);
        ret false;
    }
    val result: contracts.Operation = hash.final_sha256(?context,
        contracts.Buffer{data: output, capacity: 32});
    ret result.error == contracts.OK && result.written == 32;
}

fun view_digest_same(value: view.View, expected: *u8) bool {
    var actual: [32]u8;
    if (!view_digest(value, ?actual[0])) { ret false; }
    var i: usize = 0;
    for (i < 32) {
        if (actual[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun manager_ready(manager: *Manager) bool {
    ret manager != nil && memory_range.valid(manager::*u8, $size_of(Manager)) &&
        manager.initialized && manager.self_owner == manager &&
        manager.gate == manager.store.gate && store_shape(manager.store) &&
        gate_same(manager.gate, manager.store);
}

fun gate_state_valid(manager: *Manager) bool {
    ret (manager.gate.active_state == ACTIVE_IDLE &&
            transaction_empty(manager.gate.active_transaction) &&
            manager.gate.active_kind == 0) ||
        (manager.gate.active_state != ACTIVE_IDLE &&
            (manager.gate.active_state == ACTIVE_STAGED ||
            manager.gate.active_state == ACTIVE_WIRE ||
            manager.gate.active_state == ACTIVE_RECOVERED) &&
            (manager.gate.active_kind == WRITE_SAVE ||
            manager.gate.active_kind == WRITE_REPLACE) &&
            transaction_valid(manager.gate.active_transaction,
                manager.store, manager.gate.active_transaction.generation));
}

fun guard(manager: *Manager) ManagerGuard {
    var result: ManagerGuard = ManagerGuard{store: manager.store,
        gate: manager.gate, last_token: manager.gate.last_token,
        active_transaction: manager.gate.active_transaction,
        active_state: manager.gate.active_state,
        active_kind: manager.gate.active_kind, initialized: manager.initialized};
    digest_copy(?manager.gate.active_digest[0], ?result.active_digest[0]);
    ret result;
}

fun manager_intact(manager: *Manager, before: ManagerGuard) bool {
    ret manager != nil && before.initialized && manager.initialized &&
        manager.self_owner == manager && before.gate == manager.gate &&
        store_same(before.store, manager.store) && gate_same(manager.gate,
            manager.store) && manager.gate.last_token == before.last_token &&
        manager.gate.active_state == before.active_state &&
        manager.gate.active_kind == before.active_kind &&
        transaction_same(manager.gate.active_transaction,
            before.active_transaction) &&
        same_bytes(?manager.gate.active_digest[0],
            ?before.active_digest[0], 32) &&
        atomic.load(?manager.gate.callback_owner) == os.thread_current_id();
}

fun enter(manager: *Manager) bool {
    if (!manager_ready(manager)) { ret false; }
    val owner: i64 = os.thread_current_id();
    if (owner <= 0) { ret false; }
    for (true) {
        var expected: i64 = atomic.load(?manager.gate.callback_owner);
        if (expected == owner) { ret false; }
        if (expected == 0 && atomic.cas(?manager.gate.callback_owner,
                ?expected, owner)) {
            if (gate_state_valid(manager)) { ret true; }
            atomic.store(?manager.gate.callback_owner, 0);
            os.thread_wake(?manager.gate.callback_owner);
            ret false;
        }
        if (expected != 0) {
            os.thread_wait(?manager.gate.callback_owner, expected);
        }
    }
}

fun leave(manager: *Manager) {
    atomic.store(?manager.gate.callback_owner, 0);
    os.thread_wake(?manager.gate.callback_owner);
}

fun storage_error(code: problem.Code, detail: *u8) problem.Error {
    ret problem.local_code(problem.STORAGE, code, detail);
}

fun status_error(value: Status, detail: *u8) problem.Error {
    if (value == CONFLICT) { ret storage_error(problem.STORAGE_CONFLICT, detail); }
    if (value == UNKNOWN) { ret storage_error(problem.STORAGE_UNKNOWN, detail); }
    ret storage_error(problem.STORAGE_FAILED, detail);
}

fun same_bytes(first: *u8, second: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (first[i] != second[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun view_same(first: view.View, second: view.View) bool {
    ret first.len == second.len && memory_range.valid(first.data, first.len) &&
        memory_range.valid(second.data, second.len) &&
        same_bytes(first.data, second.data, first.len);
}

fun signer_same(first: jose.Signer, second: jose.Signer) bool {
    if (first.algorithm != second.algorithm ||
        first.max_jwk_bytes != second.max_jwk_bytes ||
        first.max_thumb_bytes != second.max_thumb_bytes ||
        first.max_signature_bytes != second.max_signature_bytes ||
        first.public_key.algorithm != second.public_key.algorithm) { ret false; }
    if (first.public_key.algorithm == jose.ES256 ||
        first.public_key.algorithm == jose.EDDSA) {
        ret view_same(view.view(first.public_key.value.data,
            first.public_key.value.len), view.view(second.public_key.value.data,
            second.public_key.value.len));
    }
    ret view_same(view.view(first.public_key.rsa.modulus.data,
            first.public_key.rsa.modulus.len),
            view.view(second.public_key.rsa.modulus.data,
                second.public_key.rsa.modulus.len)) &&
        view_same(view.view(first.public_key.rsa.exponent.data,
            first.public_key.rsa.exponent.len),
            view.view(second.public_key.rsa.exponent.data,
                second.public_key.rsa.exponent.len));
}

fun credentials_descriptor_same(first: account.Credentials,
    second: account.Credentials) bool {
    ret first.account.url.data == second.account.url.data &&
        first.account.url.len == second.account.url.len &&
        first.account.status == second.account.status &&
        first.account.contacts == second.account.contacts &&
        first.account.contact_len == second.account.contact_len &&
        first.account.orders_url.data == second.account.orders_url.data &&
        first.account.orders_url.len == second.account.orders_url.len &&
        first.account.terms_of_service_agreed ==
            second.account.terms_of_service_agreed &&
        first.signer.algorithm == second.signer.algorithm &&
        first.signer.max_jwk_bytes == second.signer.max_jwk_bytes &&
        first.signer.max_thumb_bytes == second.signer.max_thumb_bytes &&
        first.signer.max_signature_bytes == second.signer.max_signature_bytes &&
        first.signer.public_key.algorithm ==
            second.signer.public_key.algorithm &&
        first.signer.public_key.value.data ==
            second.signer.public_key.value.data &&
        first.signer.public_key.value.len ==
            second.signer.public_key.value.len &&
        first.signer.public_key.rsa.modulus.data ==
            second.signer.public_key.rsa.modulus.data &&
        first.signer.public_key.rsa.modulus.len ==
            second.signer.public_key.rsa.modulus.len &&
        first.signer.public_key.rsa.exponent.data ==
            second.signer.public_key.rsa.exponent.data &&
        first.signer.public_key.rsa.exponent.len ==
            second.signer.public_key.rsa.exponent.len &&
        first.secret_owner == second.secret_owner &&
        first.generation == second.generation;
}

fun digest_copy(source: *u8, output: *u8) {
    var i: usize = 0;
    for (i < 32) {
        output[i] = source[i];
        i = i + 1;
    }
}

fun clear_active(manager: *Manager) {
    manager.gate.active_transaction.owner = nil;
    manager.gate.active_transaction.token = 0;
    manager.gate.active_transaction.generation = 0;
    var i: usize = 0;
    for (i < 32) {
        manager.gate.active_digest[i] = 0;
        i = i + 1;
    }
    manager.gate.active_state = ACTIVE_IDLE;
    manager.gate.active_kind = 0;
}

fun set_active(manager: *Manager, transaction: Transaction, digest: *u8,
    kind: WriteKind, state: ActiveState) {
    manager.gate.active_transaction = transaction;
    digest_copy(digest, ?manager.gate.active_digest[0]);
    manager.gate.active_kind = kind;
    manager.gate.active_state = state;
}

fun active_matches(manager: *Manager, transaction: Transaction,
    digest: *u8, kind: WriteKind) bool {
    ret manager.gate.active_state != ACTIVE_IDLE &&
        manager.gate.active_kind == kind &&
        transaction_same(manager.gate.active_transaction, transaction) &&
        same_bytes(?manager.gate.active_digest[0], digest, 32);
}

fun credentials_owned(store: Store, value: account.Credentials) bool {
    if (!store.aliases(store.ctx, value.account.url.data,
            value.account.url.len) ||
        !store.aliases(store.ctx, value.account.orders_url.data,
            value.account.orders_url.len) ||
        !store.owns_secret(store.ctx, value.secret_owner)) { ret false; }
    var contact_bytes: usize = 0;
    if (!memory_range.size(value.account.contact_len, $size_of(view.View),
            ?contact_bytes) || (contact_bytes != 0 &&
        !store.aliases(store.ctx, value.account.contacts::*u8,
            contact_bytes))) { ret false; }
    var i: usize = 0;
    for (i < value.account.contact_len) {
        if (!store.aliases(store.ctx, value.account.contacts[i].data,
                value.account.contacts[i].len)) { ret false; }
        i = i + 1;
    }
    val key: jose.PublicKey = value.signer.public_key;
    if (key.algorithm == jose.ES256 || key.algorithm == jose.EDDSA) {
        ret store.aliases(store.ctx, key.value.data, key.value.len);
    }
    ret store.aliases(store.ctx, key.rsa.modulus.data, key.rsa.modulus.len) &&
        store.aliases(store.ctx, key.rsa.exponent.data, key.rsa.exponent.len);
}

fun credentials_disjoint_control(manager: *Manager,
    value: account.Credentials) bool {
    ret !account.credentials_overlap(value, manager::*u8,
            $size_of(Manager)) &&
        !account.credentials_overlap(value, manager.gate::*u8,
            $size_of(Gate));
}

fun write_value(error: problem.Error, transaction: Transaction,
    candidate: account.Credentials, digest: *u8, state: WriteState,
    kind: WriteKind) Write {
    var result: Write;
    result.error = error;
    result.transaction = transaction;
    result.candidate = candidate;
    result.state = state;
    result.kind = kind;
    result.prepared = state == WRITE_STAGED;
    if (digest != nil) { digest_copy(digest, ?result.digest[0]); }
    ret result;
}

fun empty_write(detail: *u8) Write {
    var result: Write;
    result.error = problem.local_code(problem.STORAGE,
        problem.INVALID_INPUT, detail);
    result.transaction.owner = nil;
    result.transaction.token = 0;
    result.transaction.generation = 0;
    var empty_candidate: account.Credentials;
    result.candidate = empty_candidate;
    result.state = WRITE_EMPTY;
    result.kind = 0;
    result.prepared = false;
    var i: usize = 0;
    for (i < 32) {
        result.digest[i] = 0;
        i = i + 1;
    }
    ret result;
}

pub fun init_manager(manager: *Manager, value: Store) problem.Error {
    if (manager == nil || !memory_range.valid(manager::*u8, $size_of(Manager)) ||
        manager.initialized || !store_shape(value) ||
        memory_range.overlap(manager::*u8, $size_of(Manager),
            value.context_anchor, value.context_size) ||
        memory_range.overlap(manager::*u8, $size_of(Manager),
            value.gate::*u8, $size_of(Gate))) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account store");
    }
    val owner: i64 = os.thread_current_id();
    if (owner <= 0) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account store");
    }
    var expected: i64 = atomic.load(?value.gate.callback_owner);
    if (expected == owner || (expected != 0 && !value.gate.initialized)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "account store gate is initializing");
    }
    if (!value.gate.initialized) {
        if (!atomic.cas(?value.gate.callback_owner, ?expected, owner)) {
            ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
                "account store gate is initializing");
        }
        value.gate.last_token = 0;
        value.gate.active_transaction.owner = nil;
        value.gate.active_transaction.token = 0;
        value.gate.active_transaction.generation = 0;
        var i: usize = 0;
        for (i < 32) { value.gate.active_digest[i] = 0; i = i + 1; }
        value.gate.active_state = ACTIVE_IDLE;
        value.gate.active_kind = 0;
        value.gate.ctx = value.ctx;
        value.gate.context_anchor = value.context_anchor;
        value.gate.context_size = value.context_size;
        value.gate.ready = value.ready;
        value.gate.aliases = value.aliases;
        value.gate.owns_secret = value.owns_secret;
        value.gate.begin = value.begin;
        value.gate.stage = value.stage;
        value.gate.commit = value.commit;
        value.gate.abort = value.abort;
        value.gate.load = value.load;
        value.gate.initialized = true;
        atomic.store(?value.gate.callback_owner, 0);
        os.thread_wake(?value.gate.callback_owner);
    }
    if (!gate_same(value.gate, value)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "account store gate has a different provider binding");
    }
    manager.store = value;
    manager.gate = value.gate;
    manager.self_owner = manager;
    manager.initialized = true;
    if (!enter(manager)) {
        manager.initialized = false;
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account store");
    }
    val before: Store = manager.store;
    val state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    var intact: bool = manager_intact(manager, state);
    var manager_owned: bool = true;
    var context_owned: bool = false;
    if (ready && intact) {
        manager_owned = before.aliases(before.ctx, manager::*u8,
            $size_of(Manager));
        intact = manager_intact(manager, state);
    }
    if (ready && intact) {
        context_owned = before.aliases(before.ctx, before.context_anchor,
            before.context_size);
        intact = manager_intact(manager, state);
    }
    leave(manager);
    if (!ready || !intact || manager_owned || !context_owned) {
        var empty: Store;
        manager.store = empty;
        manager.gate = nil;
        manager.self_owner = nil;
        manager.initialized = false;
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account store");
    }
    ret problem.none();
}

pub fun range_disjoint(manager: *Manager, data: *u8,
    len: usize) problem.Error {
    if (!manager_ready(manager) || !memory_range.valid(data, len) ||
        memory_range.overlap(manager::*u8, $size_of(Manager), data, len) ||
        memory_range.overlap(manager.store.context_anchor,
            manager.store.context_size, data, len)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "range overlaps account storage state");
    }
    var bound: [32]u8;
    if (!view_digest(view.view(data, len), ?bound[0]) || !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account storage range");
    }
    val before: Store = manager.store;
    val state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    var intact: bool = manager_intact(manager, state);
    var owned: bool = true;
    if (ready && intact) {
        owned = before.aliases(before.ctx, data, len);
        intact = manager_intact(manager, state);
    }
    val unchanged: bool = view_digest_same(view.view(data, len), ?bound[0]);
    leave(manager);
    if (!ready || !intact || !unchanged || owned) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "range aliases account storage state");
    }
    ret problem.none();
}

fun snapshot_shape(manager: *Manager, value: Snapshot,
    account_url: view.View, store: Store, transient: *Snapshot,
    output: *Snapshot) bool {
    if (value.status != SUCCESS && value.status != NOT_FOUND) { ret false; }
    if (value.status == NOT_FOUND) {
        if (!value.has_pending) { ret transaction_empty(value.transaction); }
        ret account.credentials_valid(value.pending) &&
            credentials_disjoint_control(manager, value.pending) &&
            value.pending.generation == 1 &&
            value.pending.account.url.len == account_url.len &&
            same_bytes(value.pending.account.url.data, account_url.data,
                account_url.len) &&
            transaction_valid(value.transaction, store, 0) &&
            !account.credentials_overlap(value.pending, transient::*u8,
                $size_of(Snapshot)) &&
            !account.credentials_overlap(value.pending, output::*u8,
                $size_of(Snapshot));
    }
    if (!account.credentials_valid(value.current) ||
        !credentials_disjoint_control(manager, value.current) ||
        value.current.account.url.len != account_url.len ||
        !same_bytes(value.current.account.url.data, account_url.data,
            account_url.len) ||
        account.credentials_overlap(value.current, transient::*u8,
            $size_of(Snapshot)) ||
        account.credentials_overlap(value.current, output::*u8,
            $size_of(Snapshot))) { ret false; }
    if (!value.has_pending) { ret transaction_empty(value.transaction); }
    ret account.credentials_valid(value.pending) &&
        credentials_disjoint_control(manager, value.pending) &&
        ((value.pending.generation == value.current.generation &&
            value.pending.secret_owner == value.current.secret_owner &&
            signer_same(value.pending.signer, value.current.signer) &&
            view_same(value.pending.account.url, value.current.account.url)) ||
        (value.current.generation != 0xffffffffffffffff &&
            value.pending.generation == value.current.generation + 1 &&
            account.same(value.current.account, value.pending.account))) &&
        transaction_valid(value.transaction, store,
            value.current.generation) &&
        !account.credentials_overlap(value.pending, transient::*u8,
            $size_of(Snapshot)) &&
        !account.credentials_overlap(value.pending, output::*u8,
            $size_of(Snapshot));
}

fun validate_snapshot_locked(manager: *Manager, state: ManagerGuard,
    account_url: view.View, candidate: *Snapshot, output: *Snapshot) bool {
    val before: Store = state.store;
    if (!snapshot_shape(manager, @candidate, account_url, before,
            candidate, output)) {
        ret false;
    }
    val status_before: Status = candidate.status;
    val pending_before: bool = candidate.has_pending;
    val transaction_before: Transaction = candidate.transaction;
    val current_before: account.Credentials = candidate.current;
    val pending_value_before: account.Credentials = candidate.pending;
    var current_digest: [32]u8;
    var pending_digest: [32]u8;
    if (candidate.status == SUCCESS &&
        !credentials_digest(candidate.current, ?current_digest[0])) { ret false; }
    if (candidate.has_pending &&
        !credentials_digest(candidate.pending, ?pending_digest[0])) { ret false; }
    if (before.aliases(before.ctx, candidate::*u8, $size_of(Snapshot)) ||
        !manager_intact(manager, state)) { ret false; }
    if (candidate.status == SUCCESS &&
        (!credentials_owned(before, candidate.current) ||
        !manager_intact(manager, state))) { ret false; }
    if (candidate.has_pending &&
        (!credentials_owned(before, candidate.pending) ||
        !manager_intact(manager, state))) { ret false; }
    if (candidate.status != status_before ||
        candidate.has_pending != pending_before ||
        !transaction_same(candidate.transaction, transaction_before) ||
        (candidate.status == SUCCESS &&
            !credentials_descriptor_same(candidate.current, current_before)) ||
        (candidate.has_pending && !credentials_descriptor_same(
            candidate.pending, pending_value_before)) ||
        !snapshot_shape(manager, @candidate, account_url, before,
            candidate, output) ||
        (candidate.status == SUCCESS &&
            !digest_same(candidate.current, ?current_digest[0])) ||
        (candidate.has_pending &&
            !digest_same(candidate.pending, ?pending_digest[0]))) { ret false; }
    val ready: bool = before.ready(before.ctx);
    ret ready && manager_intact(manager, state) &&
        candidate.status == status_before &&
        candidate.has_pending == pending_before &&
        transaction_same(candidate.transaction, transaction_before) &&
        (candidate.status != SUCCESS ||
            credentials_descriptor_same(candidate.current, current_before)) &&
        (!candidate.has_pending || credentials_descriptor_same(
            candidate.pending, pending_value_before)) &&
        snapshot_shape(manager, @candidate, account_url, before,
            candidate, output) &&
        (candidate.status != SUCCESS ||
            digest_same(candidate.current, ?current_digest[0])) &&
        (!candidate.has_pending ||
            digest_same(candidate.pending, ?pending_digest[0]));
}

pub fun recover(manager: *Manager, account_url: view.View,
    output: *Snapshot) problem.Error {
    if (!manager_ready(manager) || output == nil ||
        !memory_range.valid(output::*u8, $size_of(Snapshot)) ||
        !client.url_valid(account_url, 4096) ||
        memory_range.overlap(output::*u8, $size_of(Snapshot),
            account_url.data, account_url.len) ||
        memory_range.overlap(output::*u8, $size_of(Snapshot),
            manager::*u8, $size_of(Manager)) ||
        memory_range.overlap(output::*u8, $size_of(Snapshot),
            manager.store.context_anchor, manager.store.context_size)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account recovery request");
    }
    var url_digest: [32]u8;
    var output_digest: [32]u8;
    val output_before: Snapshot = @output;
    if (!view_digest(account_url, ?url_digest[0]) ||
        !view_digest(view.view(output::*u8, $size_of(Snapshot)),
            ?output_digest[0]) || !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "account store callback is reentrant");
    }
    val before: Store = manager.store;
    val state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    var intact: bool = manager_intact(manager, state);
    var output_owned: bool = true;
    if (ready && intact) {
        output_owned = before.aliases(before.ctx, output::*u8,
            $size_of(Snapshot));
        intact = manager_intact(manager, state);
    }
    if (!ready || !intact || output_owned ||
        !view_digest_same(account_url, ?url_digest[0]) ||
        !view_digest_same(view.view(output::*u8, $size_of(Snapshot)),
            ?output_digest[0])) {
        leave(manager);
        @output = output_before;
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid account recovery storage");
    }
    var candidate: Snapshot;
    val loaded: Status = before.load(before.ctx, account_url, ?candidate);
    if (!manager_intact(manager, state) || !status_valid(loaded) ||
        candidate.status != loaded ||
        !view_digest_same(account_url, ?url_digest[0]) ||
        !view_digest_same(view.view(output::*u8, $size_of(Snapshot)),
            ?output_digest[0])) {
        leave(manager);
        @output = output_before;
        ret storage_error(problem.INVALID_STATE,
            "account store returned an invalid recovery result");
    }
    if (loaded != SUCCESS && loaded != NOT_FOUND) {
        leave(manager);
        @output = output_before;
        ret status_error(loaded, "account recovery failed");
    }
    var valid: bool = validate_snapshot_locked(manager, state,
        account_url, ?candidate, output) &&
        view_digest_same(account_url, ?url_digest[0]) &&
        view_digest_same(view.view(output::*u8, $size_of(Snapshot)),
            ?output_digest[0]);
    var pending_digest: [32]u8;
    var pending_kind: WriteKind = 0;
    if (valid && candidate.has_pending) {
        if (candidate.status == NOT_FOUND ||
            candidate.pending.generation == candidate.current.generation) {
            pending_kind = WRITE_SAVE;
        } or { pending_kind = WRITE_REPLACE; }
        valid = credentials_digest(candidate.pending, ?pending_digest[0]) &&
            ((manager.gate.active_state == ACTIVE_IDLE &&
                (manager.gate.last_token == 0 ||
                candidate.transaction.token > manager.gate.last_token)) ||
            active_matches(manager, candidate.transaction,
                ?pending_digest[0], pending_kind)) &&
            view_digest_same(view.view(output::*u8, $size_of(Snapshot)),
                ?output_digest[0]);
    }
    if (valid && candidate.has_pending &&
        manager.gate.active_state == ACTIVE_IDLE) {
        manager.gate.last_token = candidate.transaction.token;
        set_active(manager, candidate.transaction, ?pending_digest[0],
            pending_kind, ACTIVE_RECOVERED);
    } or (valid && !candidate.has_pending) {
        clear_active(manager);
    }
    leave(manager);
    if (!valid) {
        @output = output_before;
        ret storage_error(problem.INVALID_STATE,
            "account store returned an invalid recovery result");
    }
    if (loaded == NOT_FOUND && !candidate.has_pending) {
        var missing: Snapshot;
        missing.status = NOT_FOUND;
        var empty_current: account.Credentials;
        var empty_pending: account.Credentials;
        missing.current = empty_current;
        missing.pending = empty_pending;
        missing.has_pending = false;
        missing.transaction.owner = nil;
        missing.transaction.token = 0;
        missing.transaction.generation = 0;
        @output = missing;
    } or { @output = candidate; }
    ret problem.none();
}

pub fun resume(value: Snapshot) Write {
    if (!value.has_pending ||
        (value.status != SUCCESS && value.status != NOT_FOUND) ||
        !account.credentials_valid(value.pending) ||
        transaction_empty(value.transaction)) {
        ret empty_write("snapshot has no recoverable credential write");
    }
    var digest: [32]u8;
    if (!credentials_digest(value.pending, ?digest[0])) {
        ret empty_write("snapshot pending credential is invalid");
    }
    var kind: WriteKind = WRITE_SAVE;
    if (value.status == SUCCESS && value.pending.generation !=
        value.current.generation) { kind = WRITE_REPLACE; }
    ret write_value(problem.none(), value.transaction, value.pending,
        ?digest[0], WRITE_STAGED, kind);
}

fun cleanup_locked(manager: *Manager, state: ManagerGuard,
    transaction: Transaction) Status {
    val before: Store = state.store;
    if (!manager_intact(manager, state)) { ret UNKNOWN; }
    val status: Status = before.abort(before.ctx, transaction);
    if (!manager_intact(manager, state) || !status_valid(status)) {
        ret UNKNOWN;
    }
    val ready: bool = before.ready(before.ctx);
    if (!ready || !manager_intact(manager, state)) { ret UNKNOWN; }
    ret status;
}

fun begin_failure(manager: *Manager, state: ManagerGuard,
    transaction: Transaction, candidate: account.Credentials, digest: *u8,
    kind: WriteKind, detail: *u8) Write {
    val aborted: Status = cleanup_locked(manager, state, transaction);
    if (aborted == SUCCESS) {
        clear_active(manager);
        ret empty_write(detail);
    }
    set_active(manager, transaction, digest, kind, ACTIVE_RECOVERED);
    ret write_value(status_error(aborted,
        "credential transaction cleanup requires recovery"), transaction,
        candidate, digest, WRITE_UNCERTAIN, kind);
}

pub fun begin_replace(manager: *Manager, current: account.Credentials,
    replacement: account.Credentials) Write {
    var failed_result: Write = empty_write("invalid credential replacement");
    if (!manager_ready(manager) || !enter(manager)) { ret failed_result; }
    val before: Store = manager.store;
    var token: u64 = manager.gate.last_token;
    var state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    if (!ready || !manager_intact(manager, state) ||
        manager.gate.active_state != ACTIVE_IDLE ||
        !account.credentials_valid(current) ||
        !account.credentials_valid(replacement) ||
        !credentials_disjoint_control(manager, current) ||
        !credentials_disjoint_control(manager, replacement) ||
        current.generation == 0xffffffffffffffff ||
        replacement.generation != current.generation + 1 ||
        !account.same(current.account, replacement.account)) {
        leave(manager);
        ret failed_result;
    }
    val current_before: account.Credentials = current;
    val replacement_before: account.Credentials = replacement;
    var current_digest: [32]u8;
    var replacement_digest: [32]u8;
    if (!credentials_digest(current, ?current_digest[0]) ||
        !credentials_digest(replacement, ?replacement_digest[0]) ||
        !credentials_owned(before, current) ||
        !manager_intact(manager, state) ||
        !credentials_descriptor_same(current, current_before) ||
        !credentials_descriptor_same(replacement, replacement_before) ||
        !digest_same(current, ?current_digest[0]) ||
        !digest_same(replacement, ?replacement_digest[0])) {
        leave(manager);
        failed_result.error = storage_error(problem.INVALID_STATE,
            "credential ownership callbacks changed their inputs");
        ret failed_result;
    }
    val begun: BeginResult = before.begin(before.ctx, current.account.url,
        current.generation);
    var valid: bool = manager_intact(manager, state) &&
        status_valid(begun.status) &&
        credentials_descriptor_same(current, current_before) &&
        credentials_descriptor_same(replacement, replacement_before) &&
        digest_same(current, ?current_digest[0]) &&
        digest_same(replacement, ?replacement_digest[0]);
    if (valid) {
        valid = before.ready(before.ctx) &&
            manager_intact(manager, state) &&
            credentials_descriptor_same(current, current_before) &&
            credentials_descriptor_same(replacement, replacement_before) &&
            digest_same(current, ?current_digest[0]) &&
            digest_same(replacement, ?replacement_digest[0]);
    }
    if (valid && begun.status != SUCCESS) {
        var result: Write = failed_result;
        if (transaction_valid(begun.transaction, before, current.generation)) {
            if (begun.transaction.token > token) {
                manager.gate.last_token = begun.transaction.token;
                token = manager.gate.last_token;
                state = guard(manager);
            }
            result = begin_failure(manager, state, begun.transaction,
                replacement, ?replacement_digest[0], WRITE_REPLACE,
                "account store returned a transaction with failure status");
        } or (transaction_empty(begun.transaction)) {
            result.error = status_error(begun.status,
                "credential transaction could not begin");
        } or {
            result.error = storage_error(problem.INVALID_STATE,
                "account store returned an invalid begin result");
        }
        leave(manager);
        ret result;
    }
    val usable_transaction: bool = begun.status == SUCCESS &&
        transaction_valid(begun.transaction, before, current.generation) &&
        begun.transaction.token > token;
    if (usable_transaction && manager_intact(manager, state)) {
        manager.gate.last_token = begun.transaction.token;
        token = manager.gate.last_token;
        state = guard(manager);
    }
    if (!valid || !usable_transaction) {
        var result: Write = failed_result;
        if (transaction_valid(begun.transaction, before, current.generation)) {
            result = begin_failure(manager, state, begun.transaction,
                replacement, ?replacement_digest[0], WRITE_REPLACE,
                "credential transaction changed its inputs");
        }
        leave(manager);
        ret result;
    }
    val staged: Status = before.stage(before.ctx, begun.transaction,
        replacement);
    valid = manager_intact(manager, state) && status_valid(staged) &&
        credentials_descriptor_same(current, current_before) &&
        credentials_descriptor_same(replacement, replacement_before) &&
        digest_same(current, ?current_digest[0]) &&
        digest_same(replacement, ?replacement_digest[0]);
    if (valid && staged == SUCCESS) {
        valid = credentials_owned(before, current) &&
            manager_intact(manager, state) &&
            credentials_descriptor_same(current, current_before) &&
            credentials_descriptor_same(replacement, replacement_before) &&
            credentials_owned(before, replacement) &&
            manager_intact(manager, state) &&
            digest_same(current, ?current_digest[0]) &&
            digest_same(replacement, ?replacement_digest[0]);
    }
    if (!valid || staged != SUCCESS) {
        val result: Write = begin_failure(manager, state,
            begun.transaction, replacement, ?replacement_digest[0],
            WRITE_REPLACE,
            "credential replacement was rejected");
        leave(manager);
        ret result;
    }
    set_active(manager, begun.transaction, ?replacement_digest[0],
        WRITE_REPLACE, ACTIVE_STAGED);
    leave(manager);
    ret write_value(problem.none(), begun.transaction, replacement,
        ?replacement_digest[0], WRITE_STAGED, WRITE_REPLACE);
}

pub fun begin_save(manager: *Manager, expected_generation: u64,
    candidate: account.Credentials) Write {
    var failed_result: Write = empty_write("invalid account credential save");
    if (!manager_ready(manager) || !enter(manager)) { ret failed_result; }
    val before: Store = manager.store;
    var token: u64 = manager.gate.last_token;
    var state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    if (!ready || !manager_intact(manager, state) ||
        manager.gate.active_state != ACTIVE_IDLE ||
        !account.credentials_valid(candidate) ||
        !credentials_disjoint_control(manager, candidate) ||
        (expected_generation == 0 && candidate.generation != 1) ||
        (expected_generation != 0 && candidate.generation != expected_generation)) {
        leave(manager);
        ret failed_result;
    }
    val candidate_before: account.Credentials = candidate;
    var candidate_digest: [32]u8;
    if (!credentials_digest(candidate, ?candidate_digest[0])) {
        leave(manager);
        ret failed_result;
    }
    val begun: BeginResult = before.begin(before.ctx, candidate.account.url,
        expected_generation);
    var valid: bool = manager_intact(manager, state) &&
        status_valid(begun.status) &&
        credentials_descriptor_same(candidate, candidate_before) &&
        digest_same(candidate, ?candidate_digest[0]);
    if (valid) {
        valid = before.ready(before.ctx) &&
            manager_intact(manager, state) &&
            credentials_descriptor_same(candidate, candidate_before) &&
            digest_same(candidate, ?candidate_digest[0]);
    }
    if (valid && begun.status != SUCCESS) {
        var result: Write = failed_result;
        if (transaction_valid(begun.transaction, before,
                expected_generation)) {
            if (begun.transaction.token > token) {
                manager.gate.last_token = begun.transaction.token;
                token = manager.gate.last_token;
                state = guard(manager);
            }
            result = begin_failure(manager, state, begun.transaction,
                candidate, ?candidate_digest[0], WRITE_SAVE,
                "account store returned a transaction with failure status");
        } or (transaction_empty(begun.transaction)) {
            result.error = status_error(begun.status,
                "account credential transaction could not begin");
        } or {
            result.error = storage_error(problem.INVALID_STATE,
                "account store returned an invalid begin result");
        }
        leave(manager);
        ret result;
    }
    val usable_transaction: bool = begun.status == SUCCESS &&
        transaction_valid(begun.transaction, before, expected_generation) &&
        begun.transaction.token > token;
    if (usable_transaction && manager_intact(manager, state)) {
        manager.gate.last_token = begun.transaction.token;
        token = manager.gate.last_token;
        state = guard(manager);
    }
    if (!valid || !usable_transaction) {
        var result: Write = failed_result;
        if (transaction_valid(begun.transaction, before,
                expected_generation)) {
            result = begin_failure(manager, state, begun.transaction,
                candidate, ?candidate_digest[0], WRITE_SAVE,
                "account credential transaction changed its inputs");
        }
        leave(manager);
        ret result;
    }
    val staged: Status = before.stage(before.ctx, begun.transaction, candidate);
    valid = manager_intact(manager, state) && status_valid(staged) &&
        credentials_descriptor_same(candidate, candidate_before) &&
        digest_same(candidate, ?candidate_digest[0]);
    if (valid && staged == SUCCESS) {
        valid = credentials_owned(before, candidate) &&
            manager_intact(manager, state) &&
            credentials_descriptor_same(candidate, candidate_before) &&
            digest_same(candidate, ?candidate_digest[0]);
    }
    if (!valid || staged != SUCCESS) {
        val result: Write = begin_failure(manager, state,
            begun.transaction, candidate, ?candidate_digest[0], WRITE_SAVE,
            "account credential save was rejected");
        leave(manager);
        ret result;
    }
    set_active(manager, begun.transaction, ?candidate_digest[0], WRITE_SAVE,
        ACTIVE_STAGED);
    leave(manager);
    ret write_value(problem.none(), begun.transaction, candidate,
        ?candidate_digest[0], WRITE_STAGED, WRITE_SAVE);
}

fun write_valid(manager: *Manager, value: Write) bool {
    ret manager_ready(manager) && !problem.failed(value.error) &&
        value.state == WRITE_STAGED && value.prepared &&
        (value.kind == WRITE_SAVE || value.kind == WRITE_REPLACE) &&
        account.credentials_valid(value.candidate) &&
        credentials_disjoint_control(manager, value.candidate) &&
        digest_same(value.candidate, ?value.digest[0]) &&
        transaction_valid(value.transaction, manager.store,
            value.transaction.generation);
}

fun pending_error_locked(manager: *Manager, state: ManagerGuard,
    value: Write) problem.Error {
    val before: Store = state.store;
    if (!manager_intact(manager, state)) {
        ret storage_error(problem.STORAGE_UNKNOWN,
            "account store changed during pending-state validation");
    }
    val ready: bool = before.ready(before.ctx);
    if (!ready || !manager_intact(manager, state)) {
        ret storage_error(problem.STORAGE_FAILED,
            "account store is not ready to validate pending state");
    }
    var snapshot: Snapshot;
    val loaded: Status = before.load(before.ctx, value.candidate.account.url,
        ?snapshot);
    if (!manager_intact(manager, state) || !status_valid(loaded) ||
        snapshot.status != loaded) {
        ret storage_error(problem.STORAGE_UNKNOWN,
            "account store returned an invalid pending-state result");
    }
    if (loaded != SUCCESS && loaded != NOT_FOUND) {
        ret status_error(loaded, "pending credential lookup failed");
    }
    if (!validate_snapshot_locked(manager, state,
            value.candidate.account.url, ?snapshot, ?snapshot)) {
        ret storage_error(problem.INVALID_STATE,
            "account store returned invalid pending state");
    }
    if (!snapshot.has_pending ||
        !transaction_same(snapshot.transaction, value.transaction) ||
        !digest_same(snapshot.pending, ?value.digest[0]) ||
        !digest_same(value.candidate, ?value.digest[0]) ||
        !active_matches(manager, value.transaction,
            ?value.digest[0], value.kind)) {
        ret storage_error(problem.STORAGE_CONFLICT,
            "prepared credential no longer matches durable pending state");
    }
    ret problem.none();
}

pub fun check_write(manager: *Manager, value: Write) problem.Error {
    if (!write_valid(manager, value) || !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid prepared credential write");
    }
    val result: problem.Error = pending_error_locked(manager,
        guard(manager), value);
    leave(manager);
    ret result;
}

pub fun bind_replace(manager: *Manager, value: Write) problem.Error {
    if (!write_valid(manager, value) || value.kind != WRITE_REPLACE ||
        !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid prepared credential replacement");
    }
    val state: ManagerGuard = guard(manager);
    if (state.active_state != ACTIVE_STAGED ||
        !active_matches(manager, value.transaction, ?value.digest[0],
            WRITE_REPLACE)) {
        leave(manager);
        ret storage_error(problem.STORAGE_CONFLICT,
            "credential replacement is not available for a request");
    }
    val result: problem.Error = pending_error_locked(manager, state, value);
    if (!problem.failed(result)) { manager.gate.active_state = ACTIVE_WIRE; }
    leave(manager);
    ret result;
}

pub fun unbind_replace(manager: *Manager, value: Write) problem.Error {
    if (!write_valid(manager, value) || value.kind != WRITE_REPLACE ||
        !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid credential replacement request binding");
    }
    if (manager.gate.active_state != ACTIVE_WIRE ||
        !active_matches(manager, value.transaction, ?value.digest[0],
            WRITE_REPLACE)) {
        leave(manager);
        ret storage_error(problem.STORAGE_CONFLICT,
            "credential replacement request is not active");
    }
    manager.gate.active_state = ACTIVE_STAGED;
    leave(manager);
    ret problem.none();
}

pub fun authorize_recovered_replace(manager: *Manager,
    value: Write) problem.Error {
    if (!write_valid(manager, value) || value.kind != WRITE_REPLACE ||
        !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid recovered credential replacement");
    }
    val state: ManagerGuard = guard(manager);
    if ((state.active_state != ACTIVE_RECOVERED &&
            state.active_state != ACTIVE_WIRE) ||
        !active_matches(manager, value.transaction, ?value.digest[0],
            WRITE_REPLACE)) {
        leave(manager);
        ret storage_error(problem.STORAGE_CONFLICT,
            "recovered credential replacement is not pending");
    }
    val result: problem.Error = pending_error_locked(manager, state, value);
    if (!problem.failed(result)) { manager.gate.active_state = ACTIVE_WIRE; }
    leave(manager);
    ret result;
}

pub fun commit_write(manager: *Manager, value: Write) problem.Error {
    if (!write_valid(manager, value) || !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid prepared credential write");
    }
    val before: Store = manager.store;
    val state: ManagerGuard = guard(manager);
    val state_valid: bool = (value.kind == WRITE_SAVE &&
            (state.active_state == ACTIVE_STAGED ||
            state.active_state == ACTIVE_RECOVERED)) ||
        (value.kind == WRITE_REPLACE && state.active_state == ACTIVE_WIRE);
    if (!state_valid) {
        leave(manager);
        ret storage_error(problem.STORAGE_CONFLICT,
            "prepared credential is not authorized for commit");
    }
    val pending_error: problem.Error = pending_error_locked(manager,
        state, value);
    if (problem.failed(pending_error)) {
        leave(manager);
        ret pending_error;
    }
    val status: Status = before.commit(before.ctx, value.transaction);
    val valid: bool = manager_intact(manager, state) &&
        status_valid(status) && before.ready(before.ctx) &&
        manager_intact(manager, state);
    if (valid && status == SUCCESS) { clear_active(manager); }
    leave(manager);
    if (!valid) {
        ret storage_error(problem.STORAGE_UNKNOWN,
            "credential commit outcome is unknown");
    }
    if (status != SUCCESS) { ret status_error(status, "credential commit failed"); }
    ret problem.none();
}

pub fun abort_write(manager: *Manager, value: Write) problem.Error {
    if (!manager_ready(manager) ||
        (value.state != WRITE_STAGED && value.state != WRITE_UNCERTAIN) ||
        (value.kind != WRITE_SAVE && value.kind != WRITE_REPLACE) ||
        (value.state == WRITE_STAGED && (!value.prepared ||
            !account.credentials_valid(value.candidate) ||
            !credentials_disjoint_control(manager, value.candidate) ||
            !digest_same(value.candidate, ?value.digest[0]))) ||
        !transaction_valid(value.transaction, manager.store,
            value.transaction.generation) || !enter(manager)) {
        ret problem.local_code(problem.STORAGE, problem.INVALID_INPUT,
            "invalid credential transaction abort");
    }
    val before: Store = manager.store;
    val state: ManagerGuard = guard(manager);
    val ready: bool = before.ready(before.ctx);
    if (!ready || !manager_intact(manager, state)) {
        leave(manager);
        ret storage_error(problem.STORAGE_FAILED,
            "account store is not ready to abort");
    }
    if (!active_matches(manager, value.transaction, ?value.digest[0],
            value.kind)) {
        leave(manager);
        ret storage_error(problem.STORAGE_CONFLICT,
            "credential transaction is not active");
    }
    if (value.state == WRITE_STAGED) {
        val pending_error: problem.Error = pending_error_locked(manager,
            state, value);
        if (problem.failed(pending_error)) {
            leave(manager);
            ret pending_error;
        }
    }
    val status: Status = before.abort(before.ctx, value.transaction);
    val valid: bool = manager_intact(manager, state) &&
        status_valid(status) && before.ready(before.ctx) &&
        manager_intact(manager, state);
    if (valid && status == SUCCESS) { clear_active(manager); }
    leave(manager);
    if (!valid) {
        ret storage_error(problem.STORAGE_UNKNOWN,
            "credential abort outcome is unknown");
    }
    if (status != SUCCESS) { ret status_error(status, "credential abort failed"); }
    ret problem.none();
}
