# bounded polling decisions over a caller-owned monotonic clock
#
# orders, challenges, and renewal all wait on a remote status. the wait policy
# is identical in every case, so it lives here once and is status agnostic.
# callers reduce their own status to `reached` and `terminal` and keep their
# own vocabulary.

use acme.memory_range;
use acme.problem;
use std.chrono.time;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

pub def Action: u8;

pub val WAIT:      Action = 1;
pub val READY:     Action = 2;
pub val TERMINAL:  Action = 3;
pub val DEADLINE:  Action = 4;
pub val CANCELLED: Action = 5;
pub val LIMIT:     Action = 6;

pub rec Policy {
    min_delay_ns: u64;
    max_delay_ns: u64;
    max_attempts: usize;
}

pub rec State {
    policy:    Policy;
    deadline:  time.Instant;
    attempts:  usize;
    cancelled: bool;
    started:   bool;
}

# cancelled reports that the poll had been cancelled when the decision was
# made, including a ready or terminal decision that outranked the cancellation
pub rec Decision {
    action:    Action;
    delay_ns:  u64;
    cause:     problem.Error;
    cancelled: bool;
}

pub fun policy_default() Policy {
    ret Policy{min_delay_ns: 1000000000, max_delay_ns: 30000000000,
        max_attempts: 32};
}

pub fun policy_valid(value: Policy) bool {
    ret value.min_delay_ns != 0 && value.max_delay_ns >= value.min_delay_ns &&
        value.max_delay_ns <= 3600000000000 && value.max_attempts != 0 &&
        value.max_attempts <= 4096;
}

# deadline is a monotonic instant. a wall-clock time does not type-check here
pub fun begin(state: *State, policy: Policy, deadline: time.Instant) problem.Error {
    if (state == nil || !memory_range.valid(state::*u8, $size_of(State)) ||
        !policy_valid(policy)) {
        ret problem.local_code(problem.POLICY, problem.INVALID_INPUT,
            "invalid poll policy");
    }
    state.policy    = policy;
    state.deadline  = deadline;
    state.attempts  = 0;
    state.cancelled = false;
    state.started   = true;
    ret problem.none();
}

pub fun cancel(state: *State) bool {
    if (state == nil || !memory_range.valid(state::*u8, $size_of(State)) ||
        !state.started) { ret false; }
    state.cancelled = true;
    ret true;
}

pub fun cancelled(state: *State) bool {
    ret state != nil && memory_range.valid(state::*u8, $size_of(State)) &&
        state.started && state.cancelled;
}

fun decision(state: *State, action: Action, delay_ns: u64,
    cause: problem.Error) Decision {
    ret Decision{action: action, delay_ns: delay_ns, cause: cause,
        cancelled: cancelled(state)};
}

# bounded exponential backoff. doubling stops at max_delay_ns, so a long wait
# can never overflow or grow without a ceiling.
fun backoff(policy: Policy, attempts: usize) u64 {
    var delay: u64   = policy.min_delay_ns;
    var i:     usize = 0;
    for (i < attempts) {
        if (delay >= policy.max_delay_ns || delay > 0x7fffffffffffffff) {
            ret policy.max_delay_ns;
        }
        delay = delay * 2;
        i     = i + 1;
    }
    if (delay > policy.max_delay_ns) { ret policy.max_delay_ns; }
    ret delay;
}

fun advised_ns(seconds: u64) u64 {
    if (seconds > 0xffffffffffffffff / 1000000000) {
        ret 0xffffffffffffffff;
    }
    ret seconds * 1000000000;
}

# the caller owns the clock. every wait is decided from the supplied monotonic
# instant, the authority's Retry-After, and the absolute deadline.
#
# an observation is accounted for before the poll's own state. a status that
# reached the target is READY, and a failed one is TERMINAL, even after a
# cancellation or at the deadline, because cancellation states the caller's
# intent and says nothing about what the authority already did. CANCELLED is
# returned only for an observation that made no progress.
pub fun next(state: *State, reached: bool, terminal: bool,
    retry_after_seconds: u64, now: time.Instant) Decision {
    if (state == nil || !memory_range.valid(state::*u8, $size_of(State)) ||
        !state.started || !policy_valid(state.policy)) {
        ret decision(state, TERMINAL, 0,
            problem.local_code(problem.STATE, problem.INVALID_STATE,
            "poll state is not initialized"));
    }
    if (reached) { ret decision(state, READY, 0, problem.none()); }
    if (terminal) {
        ret decision(state, TERMINAL, 0,
            problem.local_code(problem.PROTOCOL, problem.INVALID_STATE,
            "resource reached a terminal status other than the target"));
    }
    if (state.cancelled) {
        ret decision(state, CANCELLED, 0,
            problem.local_code(problem.POLICY, problem.INVALID_STATE,
            "poll was cancelled"));
    }
    if (state.attempts >= state.policy.max_attempts) {
        ret decision(state, LIMIT, 0,
            problem.local_code(problem.POLICY, problem.RETRY_LIMIT,
            "poll attempt limit reached"));
    }
    var delay:   u64 = backoff(state.policy, state.attempts);
    val advised: u64 = advised_ns(retry_after_seconds);
    if (advised > delay)                   { delay = advised; }
    if (delay > state.policy.max_delay_ns) { delay = state.policy.max_delay_ns; }
    if (!time.instant_before(now, state.deadline)) {
        ret decision(state, DEADLINE, 0,
            problem.local_code(problem.POLICY, problem.RETRY_LIMIT,
            "poll deadline reached"));
    }
    val remaining: u64 = time.instant_sub(state.deadline, now)::u64;
    if (delay > remaining) {
        ret decision(state, DEADLINE, 0,
            problem.local_code(problem.POLICY, problem.RETRY_LIMIT,
            "poll delay would pass the deadline"));
    }
    state.attempts = state.attempts + 1;
    ret decision(state, WAIT, delay, problem.none());
}

# a fixed monotonic instant, nanoseconds after the clock's start
fun at(ns: i64) time.Instant {
    ret time.Instant{sec: ns / 1000000000, nsec: ns % 1000000000};
}

test "acme.poll: waits are bounded, advised, and deadline aware" {
    var state:  State;
    var policy: Policy = policy_default();
    policy.min_delay_ns = 1000000000;
    policy.max_delay_ns = 8000000000;
    policy.max_attempts = 4;
    if (problem.failed(begin(?state, policy, at(1000000000000)))) { ret 1; }
    if (next(?state, false, false, 0, at(0)).delay_ns != 1000000000 ||
        next(?state, false, false, 0, at(0)).delay_ns != 2000000000 ||
        next(?state, false, false, 0, at(0)).delay_ns != 4000000000 ||
        next(?state, false, false, 0, at(0)).delay_ns != 8000000000) { ret 2; }
    if (next(?state, false, false, 0, at(0)).action != LIMIT) { ret 3; }
    # advice outranks the floor but never the ceiling
    if (problem.failed(begin(?state, policy, at(1000000000000))))    { ret 4; }
    if (next(?state, false, false, 5, at(0)).delay_ns != 5000000000) { ret 5; }
    if (problem.failed(begin(?state, policy, at(1000000000000))))    { ret 6; }
    if (next(?state, false, false, 3600, at(0)).delay_ns != policy.max_delay_ns ||
        next(?state, false, false, 0xffffffffffffffff, at(0)).delay_ns !=
        policy.max_delay_ns) { ret 7; }
    # a wait that would pass the deadline is refused, not truncated, and the
    # attempt counter does not advance
    if (problem.failed(begin(?state, policy, at(500000000)))) { ret 8; }
    if (next(?state, false, false, 0, at(0)).action != DEADLINE ||
        state.attempts != 0) { ret 9; }
    if (problem.failed(begin(?state, policy, at(100))))            { ret 10; }
    if (next(?state, false, false, 0, at(100)).action != DEADLINE) { ret 11; }
    # reached, terminal, and cancelled are distinct outcomes
    if (problem.failed(begin(?state, policy, at(1000000000000)))) { ret 12; }
    if (next(?state, true, false, 0, at(0)).action != READY ||
        next(?state, false, true, 0, at(0)).action != TERMINAL ||
        next(?state, true, true, 0, at(0)).action != READY) { ret 13; }
    if (!cancel(?state) || !cancelled(?state) ||
        next(?state, false, false, 0, at(0)).action != CANCELLED ||
        !next(?state, false, false, 0, at(0)).cancelled) { ret 14; }
    # an observation that arrived outranks the cancellation, so a resource that
    # already reached its target is never abandoned as cancelled
    val late: Decision = next(?state, true, false, 0, at(0));
    if (late.action != READY || !late.cancelled ||
        next(?state, false, true, 0, at(0)).action != TERMINAL ||
        next(?state, true, false, 0, at(2000000000000)).action != READY) {
        ret 17;
    }
    # an uncancelled decision says so
    if (problem.failed(begin(?state, policy, at(1000000000000))) ||
        next(?state, true, false, 0, at(0)).cancelled) { ret 18; }
    var fresh: State;
    if (next(?fresh, false, false, 0, at(0)).action != TERMINAL ||
        cancel(?fresh) || cancelled(?fresh)) { ret 15; }
    var bad: Policy = policy;
    bad.min_delay_ns = 0;
    if (!problem.failed(begin(?state, bad, at(1000)))) { ret 16; }
    ret 0;
}
