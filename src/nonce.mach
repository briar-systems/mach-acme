# bounded one-use replay nonce ownership

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.view;
use std.sync.atomic;
use std.sync.mutex;
use std.sync.thread;
use acme.problem;

pub val EMPTY:     u8 = 0;
pub val AVAILABLE: u8 = 1;

pub rec Taken {
    error: problem.Error;
    found: bool;
    value: view.View;
}

pub def TakeFun: fun(ptr, *u8, usize) Taken;
pub def PutFun: fun(ptr, view.View) problem.Error;
pub def ClearFun: fun(ptr) problem.Error;
pub def ReadyFun: fun(ptr) bool;

pub rec Pool {
    ctx:             ptr;
    take:            TakeFun;
    put:             PutFun;
    clear:           ClearFun;
    ready:           ReadyFun;
    max_nonce_bytes: usize;
    capacity:        usize;
}

pub rec Slot {
    state:    u8;
    len:      usize;
    sequence: u64;
}

pub rec Memory {
    slots:            *Slot;
    capacity:         usize;
    storage:          *u8;
    storage_capacity: usize;
    max_nonce_bytes:  usize;
    next_sequence:    u64;
    lock:             mutex.Mutex;
    initialized:      bool;
}

fun empty_taken(error: problem.Error) Taken {
    ret Taken{error: error, found: false, value: view.view(nil, 0)};
}

fun valid_nonce(value: view.View, max_nonce_bytes: usize) bool {
    if (value.data == nil || value.len == 0 || value.len > max_nonce_bytes) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val byte: u8 = value.data[i];
        if (!((byte >= 'A' && byte <= 'Z') || (byte >= 'a' && byte <= 'z') ||
            (byte >= '0' && byte <= '9') || byte == '-' || byte == '_')) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

fun slot_data(memory: *Memory, index: usize) *u8 {
    ret ?memory.storage[index * memory.max_nonce_bytes];
}

fun equal_slot(memory: *Memory, index: usize, value: view.View) bool {
    if (memory.slots[index].state != AVAILABLE || memory.slots[index].len != value.len) {
        ret false;
    }
    val data: *u8 = slot_data(memory, index);
    var i: usize = 0;
    for (i < value.len) {
        if (data[i] != value.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun wipe_slot(memory: *Memory, index: usize) {
    val data: *u8 = slot_data(memory, index);
    var i: usize = 0;
    for (i < memory.max_nonce_bytes) {
        data[i] = 0;
        i = i + 1;
    }
    memory.slots[index].state = EMPTY;
    memory.slots[index].len = 0;
    memory.slots[index].sequence = 0;
}

pub fun init_memory(memory: *Memory, slots: *Slot, capacity: usize,
    storage: *u8, storage_capacity: usize, max_nonce_bytes: usize) problem.Error {
    if (memory == nil || memory.initialized || slots == nil || storage == nil || capacity == 0 ||
        max_nonce_bytes == 0 || capacity > storage_capacity / max_nonce_bytes) {
        ret problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "invalid nonce storage");
    }
    memory.slots = slots;
    memory.capacity = capacity;
    memory.storage = storage;
    memory.storage_capacity = storage_capacity;
    memory.max_nonce_bytes = max_nonce_bytes;
    memory.next_sequence = 1;
    memory.lock = mutex.make();
    memory.initialized = true;
    var i: usize = 0;
    for (i < capacity) {
        wipe_slot(memory, i);
        i = i + 1;
    }
    ret problem.none();
}

fun put_locked(memory: *Memory, value: view.View) problem.Error {
    if (!memory.initialized || !valid_nonce(value, memory.max_nonce_bytes)) {
        ret problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "invalid replay nonce");
    }
    var empty_index: usize = memory.capacity;
    var i: usize = 0;
    for (i < memory.capacity) {
        if (equal_slot(memory, i, value)) {
            ret problem.local_code(problem.NONCE, problem.DUPLICATE_NONCE,
                "duplicate replay nonce");
        }
        if (empty_index == memory.capacity && memory.slots[i].state == EMPTY) {
            empty_index = i;
        }
        i = i + 1;
    }
    if (empty_index == memory.capacity) {
        ret problem.local_code(problem.LIMIT, problem.NONCE_STORAGE_FULL,
            "nonce storage is full");
    }
    if (memory.next_sequence == 18446744073709551615) {
        ret problem.local_code(problem.STATE, problem.INVALID_STATE,
            "nonce sequence is exhausted; clear the pool");
    }
    val output: *u8 = slot_data(memory, empty_index);
    i = 0;
    for (i < value.len) {
        output[i] = value.data[i];
        i = i + 1;
    }
    memory.slots[empty_index].state = AVAILABLE;
    memory.slots[empty_index].len = value.len;
    memory.slots[empty_index].sequence = memory.next_sequence;
    memory.next_sequence = memory.next_sequence + 1;
    ret problem.none();
}

pub fun memory_put(ctx: ptr, value: view.View) problem.Error {
    val memory: *Memory = ctx::*Memory;
    if (memory == nil) {
        ret problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "invalid replay nonce");
    }
    mutex.lock(?memory.lock);
    val result: problem.Error = put_locked(memory, value);
    mutex.unlock(?memory.lock);
    ret result;
}

fun take_locked(memory: *Memory, output: *u8, capacity: usize) Taken {
    if (!memory.initialized || output == nil) {
        ret empty_taken(problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "invalid nonce take"));
    }
    var selected: usize = memory.capacity;
    var sequence: u64 = 0;
    var i: usize = 0;
    for (i < memory.capacity) {
        if (memory.slots[i].state == AVAILABLE &&
            (selected == memory.capacity || memory.slots[i].sequence > sequence)) {
            selected = i;
            sequence = memory.slots[i].sequence;
        }
        i = i + 1;
    }
    if (selected == memory.capacity) { ret empty_taken(problem.none()); }
    val len: usize = memory.slots[selected].len;
    if (capacity < len) {
        ret empty_taken(problem.local_code(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "nonce output is too small"));
    }
    val input: *u8 = slot_data(memory, selected);
    i = 0;
    for (i < len) {
        output[i] = input[i];
        i = i + 1;
    }
    wipe_slot(memory, selected);
    ret Taken{error: problem.none(), found: true, value: view.view(output, len)};
}

pub fun memory_take(ctx: ptr, output: *u8, capacity: usize) Taken {
    val memory: *Memory = ctx::*Memory;
    if (memory == nil) {
        ret empty_taken(problem.local_code(problem.NONCE, problem.INVALID_INPUT,
            "invalid nonce take"));
    }
    mutex.lock(?memory.lock);
    val result: Taken = take_locked(memory, output, capacity);
    mutex.unlock(?memory.lock);
    ret result;
}

fun clear_locked(memory: *Memory) problem.Error {
    if (!memory.initialized) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "nonce storage is not initialized");
    }
    var i: usize = 0;
    for (i < memory.capacity) {
        wipe_slot(memory, i);
        i = i + 1;
    }
    i = memory.capacity * memory.max_nonce_bytes;
    for (i < memory.storage_capacity) {
        memory.storage[i] = 0;
        i = i + 1;
    }
    memory.next_sequence = 1;
    ret problem.none();
}

pub fun memory_clear(ctx: ptr) problem.Error {
    val memory: *Memory = ctx::*Memory;
    if (memory == nil) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "nonce storage is not initialized");
    }
    mutex.lock(?memory.lock);
    val result: problem.Error = clear_locked(memory);
    mutex.unlock(?memory.lock);
    ret result;
}

pub fun release_memory(memory: *Memory) problem.Error {
    if (memory == nil || !memory.initialized) {
        ret problem.local_code(problem.NONCE, problem.INVALID_STATE,
            "nonce storage is not initialized");
    }
    mutex.lock(?memory.lock);
    val result: problem.Error = clear_locked(memory);
    if (!problem.failed(result)) {
        memory.slots = nil;
        memory.capacity = 0;
        memory.storage = nil;
        memory.storage_capacity = 0;
        memory.max_nonce_bytes = 0;
        memory.next_sequence = 0;
        memory.initialized = false;
    }
    mutex.unlock(?memory.lock);
    ret result;
}

pub fun memory_ready(ctx: ptr) bool {
    val memory: *Memory = ctx::*Memory;
    if (memory == nil) { ret false; }
    mutex.lock(?memory.lock);
    val result: bool = memory.initialized;
    mutex.unlock(?memory.lock);
    ret result;
}

pub fun pool(memory: *Memory) Pool {
    if (memory == nil || !memory.initialized) {
        ret Pool{ctx: nil, take: memory_take, put: memory_put, clear: memory_clear,
            ready: memory_ready, max_nonce_bytes: 0, capacity: 0};
    }
    ret Pool{ctx: memory::ptr, take: memory_take, put: memory_put,
        clear: memory_clear, ready: memory_ready,
        max_nonce_bytes: memory.max_nonce_bytes,
        capacity: memory.capacity};
}

pub fun valid(value: *Pool) bool {
    ret value != nil && value.ctx != nil && value.take::usize != 0 &&
        value.put::usize != 0 && value.clear::usize != 0 &&
        value.ready::usize != 0 && value.max_nonce_bytes != 0 &&
        value.capacity != 0 && value.ready(value.ctx);
}

rec PutContext {
    pool:   *Pool;
    value:  view.View;
    result: *i64;
}

fun put_worker(arg: *u8) {
    val context: *PutContext = arg::*PutContext;
    val result: problem.Error = context.pool.put(context.pool.ctx,
        context.value);
    if (problem.failed(result)) { atomic.store(context.result, -1); }
    or { atomic.store(context.result, 1); }
}

test "acme.nonce: take consumes the newest nonce exactly once" {
    var slots: [2]Slot;
    var storage: [17]u8;
    var memory: Memory;
    if (problem.failed(init_memory(?memory, ?slots[0], 2, ?storage[0], 17, 8))) { ret 1; }
    val value: Pool = pool(?memory);
    if (problem.failed(value.put(value.ctx, view.view("first", 5))) ||
        problem.failed(value.put(value.ctx, view.view("second", 6)))) { ret 2; }
    var output: [8]u8;
    val newest: Taken = value.take(value.ctx, ?output[0], 8);
    if (problem.failed(newest.error) || !newest.found || newest.value.len != 6 ||
        output[0] != 's') { ret 3; }
    val older: Taken = value.take(value.ctx, ?output[0], 8);
    if (problem.failed(older.error) || !older.found || older.value.len != 5 ||
        output[0] != 'f') { ret 4; }
    if (value.take(value.ctx, ?output[0], 8).found) { ret 5; }
    memory.next_sequence = 18446744073709551615;
    if (value.put(value.ctx, view.view("blocked", 7)).code != problem.INVALID_STATE ||
        problem.failed(value.clear(value.ctx)) || memory.next_sequence != 1 ||
        problem.failed(value.put(value.ctx, view.view("after", 5)))) { ret 6; }
    if (problem.failed(release_memory(?memory)) || memory.initialized || valid(?value) ||
        value.take(value.ctx, ?output[0], 8).error.code != problem.INVALID_INPUT) { ret 7; }
    var i: usize = 0;
    for (i < 17) {
        if (storage[i] != 0) { ret 8; }
        i = i + 1;
    }
    if (problem.failed(init_memory(?memory, ?slots[0], 2,
        ?storage[0], 17, 8))) { ret 9; }
    ret 0;
}

test "acme.nonce: concurrent producers preserve every slot" {
    var slots: [4]Slot;
    var storage: [64]u8;
    var memory: Memory;
    if (problem.failed(init_memory(?memory, ?slots[0], 4,
        ?storage[0], 64, 16))) { ret 1; }
    var value: Pool = pool(?memory);
    var results: [4]i64;
    var contexts: [4]PutContext;
    var threads: [4]thread.Thread;
    val nonces: [4]view.View = [4]view.View{
        view.view("nonce_one", 9), view.view("nonce_two", 9),
        view.view("nonce_three", 11), view.view("nonce_four", 10),
    };
    var i: usize = 0;
    for (i < 4) {
        contexts[i] = PutContext{pool: ?value, value: nonces[i],
            result: ?results[i]};
        thread.spawn_with(put_worker, (?contexts[i])::*u8, ?threads[i]);
        if (threads[i].tid < 0) {
            var joined: usize = 0;
            for (joined < i) {
                thread.join(?threads[joined]);
                joined = joined + 1;
            }
            ret 2;
        }
        i = i + 1;
    }
    i = 0;
    for (i < 4) {
        thread.join(?threads[i]);
        if (atomic.load(?results[i]) != 1) { ret 3; }
        i = i + 1;
    }
    var output: [16]u8;
    i = 0;
    for (i < 4) {
        val taken: Taken = value.take(value.ctx, ?output[0], 16);
        if (problem.failed(taken.error) || !taken.found) { ret 4; }
        i = i + 1;
    }
    if (value.take(value.ctx, ?output[0], 16).found ||
        problem.failed(release_memory(?memory))) { ret 5; }
    ret 0;
}
