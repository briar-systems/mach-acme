# certificate identifier model and explicit wildcard and ip policy

use R: std.types.result;
use std.net.ip;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.memory_range;

pub val DNS: u8 = 1;
pub val IP:  u8 = 2;

# a presentation dns name never exceeds 253 bytes, and a wildcard adds "*."
pub val MAX_DNS_BYTES:   usize = 253;
pub val MAX_LABEL_BYTES: usize = 63;
pub val MAX_IP_BYTES:    usize = 45;
pub val MAX_VALUE_BYTES: usize = 255;

pub rec Identifier {
    kind:  u8;
    value: view.View;
}

# identifier admission is a caller policy rather than a library default, so a
# deployment that cannot answer dns-01 never silently orders a wildcard
pub rec Policy {
    allow_wildcard:  bool;
    allow_ip:        bool;
    max_value_bytes: usize;
}

# wildcards are admitted because rfc 8555 defines them, ip identifiers are not
# because rfc 8738 support is optional and many authorities reject them
pub fun policy_default() Policy {
    ret Policy{allow_wildcard: true, allow_ip: false,
        max_value_bytes: MAX_VALUE_BYTES};
}

pub fun policy_valid(value: Policy) bool {
    ret value.max_value_bytes != 0 &&
        value.max_value_bytes <= MAX_VALUE_BYTES;
}

fun alpha(value: u8) bool {
    ret (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z');
}

fun digit(value: u8) bool { ret value >= '0' && value <= '9'; }

# rfc 1123 preferred name syntax, case insensitive and without a trailing dot
fun dns_name_valid(value: view.View) bool {
    if (!memory_range.valid(value.data, value.len) || value.len == 0 ||
        value.len > MAX_DNS_BYTES) { ret false; }
    var label: usize = 0;
    var i: usize = 0;
    for (i < value.len) {
        val current: u8 = value.data[i];
        if (current == '.') {
            if (label == 0 || value.data[i - 1] == '-' ||
                i + 1 == value.len) { ret false; }
            label = 0;
        } or {
            if (!alpha(current) && !digit(current) && current != '-') {
                ret false;
            }
            if (label == 0 && current == '-') { ret false; }
            label = label + 1;
            if (label > MAX_LABEL_BYTES) { ret false; }
        }
        i = i + 1;
    }
    ret label != 0 && value.data[value.len - 1] != '-';
}

pub fun is_wildcard(value: Identifier) bool {
    ret value.kind == DNS && memory_range.valid(value.value.data,
        value.value.len) && value.value.len > 2 && value.value.data[0] == '*' &&
        value.value.data[1] == '.';
}

# the authorization returned for a wildcard order names the base domain, so
# callers need the exact bytes the authority will echo back
pub fun base_name(value: Identifier) view.View {
    if (!is_wildcard(value)) { ret value.value; }
    ret view.view(?value.value.data[2], value.value.len - 2);
}

fun ip_valid(value: view.View) bool {
    if (!memory_range.valid(value.data, value.len) || value.len == 0 ||
        value.len > MAX_IP_BYTES) { ret false; }
    var text: [46]u8;
    var i: usize = 0;
    for (i < value.len) {
        if (value.data[i] == 0) { ret false; }
        text[i] = value.data[i];
        i = i + 1;
    }
    text[value.len] = 0;
    ret !R.is_err[ip.IPv4, str](ip.ipv4_parse(?text[0])) ||
        !R.is_err[ip.IPv6, str](ip.ipv6_parse(?text[0]));
}

pub fun valid(value: Identifier, policy: Policy) bool {
    if (!policy_valid(policy) ||
        !memory_range.valid(value.value.data, value.value.len) ||
        value.value.len == 0 || value.value.len > policy.max_value_bytes) {
        ret false;
    }
    if (value.kind == IP) { ret policy.allow_ip && ip_valid(value.value); }
    if (value.kind != DNS) { ret false; }
    if (is_wildcard(value)) {
        ret policy.allow_wildcard && dns_name_valid(base_name(value));
    }
    # a bare "*" or an interior wildcard is never a valid dns name
    ret dns_name_valid(value.value);
}

fun lower(value: u8) u8 {
    if (value >= 'A' && value <= 'Z') { ret value + 32; }
    ret value;
}

# dns names compare case insensitively, ip literals compare exactly
pub fun same(first: Identifier, second: Identifier) bool {
    if (first.kind != second.kind || first.value.len != second.value.len ||
        !memory_range.valid(first.value.data, first.value.len) ||
        !memory_range.valid(second.value.data, second.value.len)) {
        ret false;
    }
    var i: usize = 0;
    for (i < first.value.len) {
        if (first.kind == DNS) {
            if (lower(first.value.data[i]) != lower(second.value.data[i])) {
                ret false;
            }
        } or {
            if (first.value.data[i] != second.value.data[i]) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

pub fun type_name(kind: u8) view.View {
    if (kind == DNS) { ret view.view("dns", 3); }
    if (kind == IP) { ret view.view("ip", 2); }
    ret view.view(nil, 0);
}

pub fun kind_from_name(value: view.View) u8 {
    if (!memory_range.valid(value.data, value.len)) { ret 0; }
    if (value.len == 3 && value.data[0] == 'd' && value.data[1] == 'n' &&
        value.data[2] == 's') { ret DNS; }
    if (value.len == 2 && value.data[0] == 'i' && value.data[1] == 'p') {
        ret IP;
    }
    ret 0;
}

fun dns(value: str, len: usize) Identifier {
    ret Identifier{kind: DNS, value: view.view(value, len)};
}

test "acme.identifier: wildcard and ip admission follow explicit policy" {
    var policy: Policy = policy_default();
    if (!valid(dns("example.com", 11), policy) ||
        !valid(dns("*.example.com", 13), policy)) { ret 1; }
    policy.allow_wildcard = false;
    if (valid(dns("*.example.com", 13), policy) ||
        !valid(dns("example.com", 11), policy)) { ret 2; }
    policy = policy_default();
    val address: Identifier = Identifier{kind: IP,
        value: view.view("192.0.2.1", 9)};
    if (valid(address, policy)) { ret 3; }
    policy.allow_ip = true;
    if (!valid(address, policy) ||
        !valid(Identifier{kind: IP, value: view.view("::1", 3)}, policy) ||
        valid(Identifier{kind: IP, value: view.view("192.0.2.256", 11)},
            policy)) { ret 4; }
    # only a leftmost "*." label is a wildcard, and it is never an ip
    policy = policy_default();
    if (valid(dns("a.*.example.com", 15), policy) ||
        valid(dns("*", 1), policy) || valid(dns("*.", 2), policy) ||
        valid(dns("-bad.example.com", 16), policy) ||
        valid(dns("bad-.example.com", 16), policy) ||
        valid(dns("example.com.", 12), policy) ||
        valid(dns("a..example.com", 14), policy) ||
        valid(Identifier{kind: 7, value: view.view("example.com", 11)},
            policy)) { ret 5; }
    if (!is_wildcard(dns("*.example.com", 13)) ||
        is_wildcard(dns("example.com", 11)) ||
        base_name(dns("*.example.com", 13)).len != 11) { ret 6; }
    if (!same(dns("Example.COM", 11), dns("example.com", 11)) ||
        same(dns("example.org", 11), dns("example.com", 11))) { ret 7; }
    if (kind_from_name(type_name(DNS)) != DNS ||
        kind_from_name(type_name(IP)) != IP ||
        kind_from_name(view.view("dnsx", 4)) != 0) { ret 8; }
    ret 0;
}
