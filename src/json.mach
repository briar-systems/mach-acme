# strict bounded json tree over caller-owned scratch

use A: std.allocator;
use F: std.allocator.fixed;
use J: std.data.json;
use std.types.option.opt;
use std.types.result.res;
use std.types.error.err;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view;
use std.text.utf8;
use acme.memory_range;
use acme.problem;



# an element by index, nil when absent, as std 1.x returned it
fun element(value: *J.Value, index: usize) *J.Value {
    val got: opt[*J.Value] = J.value_get(value, index);
    if (sel got.some) { ret got.some; }
    ret nil;
}

# a key by index, nil when absent, as std 1.x returned it
fun key_at(value: *J.Value, index: usize) str {
    val got: opt[str] = J.value_key(value, index);
    if (sel got.some) { ret got.some; }
    ret nil;
}
pub rec Limits {
    max_bytes:           usize;
    max_depth:           usize;
    max_values:          usize;
    max_key_bytes:       usize;
    max_key_comparisons: usize;
}

pub rec Document {
    root:  J.Value;
    error: problem.Error;
    valid: bool;
}

fun invalid(code: problem.Code, detail: str) Document {
    var document: Document;
    document.error = problem.local_code(problem.PROTOCOL, code, detail);
    document.valid = false;
    ret document;
}

fun hex(byte: u8) bool {
    ret (byte >= '0' && byte <= '9') || (byte >= 'a' && byte <= 'f') ||
        (byte >= 'A' && byte <= 'F');
}

fun digit(byte: u8) bool {
    ret byte >= '0' && byte <= '9';
}

fun scan_number(input: view.View, start: usize, finish: *usize) problem.Error {
    var i: usize = start;
    if (input.data[i] == '-') {
        i = i + 1;
        if (i == input.len) {
            ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                "json number is truncated");
        }
    }
    if (!digit(input.data[i])) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "json number has no integer digits");
    }
    var magnitude: u64 = 0;
    if (input.data[i] == '0') {
        i = i + 1;
        if (i < input.len && digit(input.data[i])) {
            ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                "json number has a leading zero");
        }
    } or {
        for (i < input.len && digit(input.data[i])) {
            val value: u64 = (input.data[i] - '0')::u64;
            if (magnitude > (9223372036854775807 - value) / 10) {
                ret problem.local_code(problem.LIMIT, problem.MALFORMED_JSON,
                    "json integer magnitude exceeds the parser range");
            }
            magnitude = magnitude * 10 + value;
            i = i + 1;
        }
    }
    if (i < input.len && input.data[i] == '.') {
        i = i + 1;
        if (i == input.len || !digit(input.data[i])) {
            ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                "json number has no fraction digits");
        }
        for (i < input.len && digit(input.data[i])) { i = i + 1; }
    }
    if (i < input.len && (input.data[i] == 'e' || input.data[i] == 'E')) {
        i = i + 1;
        if (i < input.len && (input.data[i] == '+' || input.data[i] == '-')) {
            i = i + 1;
        }
        if (i == input.len || !digit(input.data[i])) {
            ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                "json number has no exponent digits");
        }
        for (i < input.len && digit(input.data[i])) { i = i + 1; }
    }
    @finish = i;
    ret problem.none();
}

fun prescan(input: view.View, configured: Limits) problem.Error {
    if (input.data == nil || input.len == 0 || input.len > configured.max_bytes ||
        configured.max_depth == 0 || configured.max_values == 0 ||
        configured.max_key_bytes == 0 || configured.max_key_bytes > 128 ||
        configured.max_key_comparisons == 0) {
        ret problem.local_code(problem.LIMIT, problem.INVALID_INPUT,
            "invalid json limits or input");
    }
    if (!utf8.validate(input.data, input.len)) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "json input is not valid utf-8");
    }
    var depth: usize = 0;
    var in_string: bool = false;
    var i: usize = 0;
    for (i < input.len) {
        val byte: u8 = input.data[i];
        if (in_string) {
            if (byte < ' ') {
                ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                    "json string contains a control byte");
            }
            if (byte == '\\') {
                if (i + 1 >= input.len) {
                    ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                        "json escape is truncated");
                }
                val escaped: u8 = input.data[i + 1];
                if (escaped == 'u') {
                    if (i + 5 >= input.len || !hex(input.data[i + 2]) ||
                        !hex(input.data[i + 3]) || !hex(input.data[i + 4]) ||
                        !hex(input.data[i + 5])) {
                        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                            "json unicode escape is invalid");
                    }
                    i = i + 5;
                } or {
                    if (escaped != '"' && escaped != '\\' && escaped != '/' &&
                        escaped != 'b' && escaped != 'f' && escaped != 'n' &&
                        escaped != 'r' && escaped != 't') {
                        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                            "json escape is invalid");
                    }
                    i = i + 1;
                }
            } or (byte == '"') {
                in_string = false;
            }
        } or {
            if (byte == '"') { in_string = true; }
            or (byte == '{' || byte == '[') {
                depth = depth + 1;
                if (depth > configured.max_depth) {
                    ret problem.local_code(problem.LIMIT, problem.MALFORMED_JSON,
                        "json nesting limit exceeded");
                }
            } or (byte == '}' || byte == ']') {
                if (depth == 0) {
                    ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
                        "json delimiter is unmatched");
                }
                depth = depth - 1;
            } or (byte == '-' || digit(byte)) {
                var finish: usize = 0;
                val numeric: problem.Error = scan_number(input, i, ?finish);
                if (problem.failed(numeric)) { ret numeric; }
                i = finish - 1;
            }
        }
        i = i + 1;
    }
    if (in_string || depth != 0) {
        ret problem.local_code(problem.PROTOCOL, problem.MALFORMED_JSON,
            "json input is truncated");
    }
    ret problem.none();
}

fun decoded_string_valid(value: *J.Value, maximum: usize) bool {
    val decoded: res[usize, J.JsonError] = J.value_string_decode(value, nil, 0);
    ret (sel decoded.ok) && decoded.ok <= maximum;
}

fun key_value(object: *J.Value, index: usize) J.Value {
    var value: J.Value;
    value.kind = J.STRING;
    value.str_val = key_at(object, index);
    value.str_len = J.value_key_len(object, index);
    ret value;
}

fun decoded_key_equal(first: *J.Value, second: *J.Value) bool {
    var first_bytes: [128]u8;
    var second_bytes: [128]u8;
    val first_result: res[usize, J.JsonError] = J.value_string_decode(first,
        ?first_bytes[0], 128);
    val second_result: res[usize, J.JsonError] = J.value_string_decode(second,
        ?second_bytes[0], 128);
    if (sel first_result.err) { ret false; }
    if (sel second_result.err) { ret false; }
    val len: usize = first_result.ok;
    if (len != second_result.ok) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (first_bytes[i] != second_bytes[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun validate_tree(value: *J.Value, depth: usize, configured: Limits,
    count: *usize, comparisons: *usize, comparison_limit: *bool) bool {
    if (value == nil || depth > configured.max_depth || @count >= configured.max_values) {
        ret false;
    }
    @count = @count + 1;
    if (value.kind == J.STRING) {
        ret decoded_string_valid(value, configured.max_bytes);
    }
    if (value.kind != J.ARRAY && value.kind != J.OBJECT) { ret true; }
    var i: usize = 0;
    if (value.kind == J.OBJECT) {
        for (i < J.value_count(value)) {
            var first: J.Value = key_value(value, i);
            if (!decoded_string_valid(?first, configured.max_key_bytes)) { ret false; }
            var j: usize = i + 1;
            for (j < J.value_count(value)) {
                if (@comparisons >= configured.max_key_comparisons) {
                    @comparison_limit = true;
                    ret false;
                }
                @comparisons = @comparisons + 1;
                var second: J.Value = key_value(value, j);
                if (!decoded_string_valid(?second, configured.max_key_bytes) ||
                    decoded_key_equal(?first, ?second)) { ret false; }
                j = j + 1;
            }
            i = i + 1;
        }
    }
    i = 0;
    for (i < J.value_count(value)) {
        if (!validate_tree(element(value, i), depth + 1, configured, count,
            comparisons, comparison_limit)) {
            ret false;
        }
        i = i + 1;
    }
    ret true;
}

pub fun parse(input: view.View, scratch: *u8, scratch_capacity: usize,
    configured: Limits) Document {
    if (!memory_range.valid(input.data, input.len) || scratch == nil ||
        scratch_capacity == 0 || !memory_range.valid(scratch, scratch_capacity) ||
        memory_range.overlap(input.data, input.len, scratch, scratch_capacity)) {
        ret invalid(problem.INVALID_INPUT, "json input or scratch range is invalid");
    }
    val scan: problem.Error = prescan(input, configured);
    if (problem.failed(scan)) {
        var document: Document = invalid(scan.code, scan.detail);
        document.error.kind = scan.kind;
        ret document;
    }
    var allocator: A.Allocator;
    var state: F.FixedState;
    val made: err[A.Error] = F.make(?allocator, ?state, scratch, scratch_capacity);
    if (sel made.err) {
        ret invalid(problem.INVALID_INPUT, "json scratch allocator is invalid");
    }
    val parsed: res[J.Value, J.JsonError] = J.parse(input.data, input.len, ?allocator);
    if (sel parsed.err) {
        if (sel parsed.err.alloc) {
            ret invalid(problem.OUTPUT_TOO_SMALL, "json scratch is too small");
        }
        if (sel parsed.err.depth) {
            ret invalid(problem.MALFORMED_JSON, "json nesting is too deep");
        }
        ret invalid(problem.MALFORMED_JSON, "json syntax error");
    }
    var root: J.Value = parsed.ok;
    var count: usize = 0;
    var comparisons: usize = 0;
    var comparison_limit: bool = false;
    if (!validate_tree(?root, 1, configured, ?count, ?comparisons,
        ?comparison_limit)) {
        if (comparison_limit) {
            var document: Document = invalid(problem.MALFORMED_JSON,
                "json duplicate-key comparison limit exceeded");
            document.error.kind = problem.LIMIT;
            ret document;
        }
        ret invalid(problem.MALFORMED_JSON,
            "json tree violates depth, value, key, or uniqueness limits");
    }
    ret Document{root: root, error: problem.none(), valid: true};
}

fun key_equals(object: *J.Value, index: usize, expected: str) bool {
    if (object == nil ||
        !memory_range.valid(object::*u8, $size_of(J.Value)) ||
        object.kind != J.OBJECT ||
        index >= J.value_count(object) || expected == nil) { ret false; }
    var key: J.Value = key_value(object, index);
    var bytes: [128]u8;
    val decoded: res[usize, J.JsonError] = J.value_string_decode(?key, ?bytes[0], 128);
    if (sel decoded.err) { ret false; }
    val len: usize = decoded.ok;
    var i: usize = 0;
    for (i < len) {
        if (expected[i] == 0 || expected[i] != bytes[i]) { ret false; }
        i = i + 1;
    }
    ret expected[len] == 0;
}

pub fun find(object: *J.Value, expected: str) *J.Value {
    if (object == nil ||
        !memory_range.valid(object::*u8, $size_of(J.Value)) ||
        object.kind != J.OBJECT || expected == nil) { ret nil; }
    var i: usize = 0;
    for (i < J.value_count(object)) {
        if (key_equals(object, i, expected)) { ret element(object, i); }
        i = i + 1;
    }
    ret nil;
}

test "acme.json: find rejects wrapping object records" {
    if (find(0xffffffffffffffff::*J.Value, "key") != nil) { ret 1; }
    ret 0;
}
