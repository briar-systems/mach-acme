# challenge presentation and cleanup boundary

use crypto.contracts;
use crypto.hash;
use J: std.data.json;
use R: std.types.result;
use std.encoding.base64;
use std.sync.atomic;
use std.system.os;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.client;
use acme.identifier;
use acme.jose;
use acme.memory_range;
use acme.poll;
use acme.problem;

pub val HTTP_01:     u8 = 1;
pub val DNS_01:      u8 = 2;
pub val TLS_ALPN_01: u8 = 3;

pub val PENDING:    u8 = 1;
pub val PROCESSING: u8 = 2;
pub val VALID:      u8 = 3;
pub val INVALID:    u8 = 4;

# rfc 8555 tokens are base64url with at least 128 bits of entropy. the ceiling
# bounds every derived key authorization, dns record, and file name.
pub val MAX_TOKEN_BYTES: usize = 128;

pub rec Challenge {
    typ:       u8;
    url:       view.View;
    token:     view.View;
    status:    u8;
    validated: view.View;
    failure:   problem.Problem;
}

pub rec Presentation {
    ctx: ptr;
}

pub def SupportsFun: fun(ptr, identifier.Identifier, u8) bool;
pub def PresentFun: fun(ptr, identifier.Identifier, Challenge, view.View) R.Result[Presentation, problem.Error];
pub def CleanupFun: fun(ptr, Presentation) R.Result[bool, problem.Error];

pub rec Provider {
    ctx:      ptr;
    supports: SupportsFun;
    present:  PresentFun;
    cleanup:  CleanupFun;
}

pub rec Providers {
    items: *Provider;
    len:   usize;
}

pub fun type_name(kind: u8) view.View {
    if (kind == HTTP_01) { ret view.view("http-01", 7); }
    if (kind == DNS_01) { ret view.view("dns-01", 6); }
    if (kind == TLS_ALPN_01) { ret view.view("tls-alpn-01", 11); }
    ret view.view(nil, 0);
}

fun name_is(value: view.View, expected: str, len: usize) bool {
    if (value.len != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (value.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an unknown type maps to zero rather than failing, so an authorization that
# offers a challenge this build does not implement is still usable
pub fun kind_from_name(value: view.View) u8 {
    if (!memory_range.valid(value.data, value.len) || value.len == 0) {
        ret 0;
    }
    if (name_is(value, "http-01", 7)) { ret HTTP_01; }
    if (name_is(value, "dns-01", 6)) { ret DNS_01; }
    if (name_is(value, "tls-alpn-01", 11)) { ret TLS_ALPN_01; }
    ret 0;
}

fun value_equals(value: *J.Value, expected: *u8) bool {
    if (value == nil || value.kind != J.STRING) { ret false; }
    var decoded: [32]u8;
    val measured: R.Result[usize, str] = J.value_string_decode(value, nil, 0);
    if (R.is_err[usize, str](measured)) { ret false; }
    val len: usize = R.unwrap_ok[usize, str](measured);
    if (len > 31) { ret false; }
    val result: R.Result[usize, str] = J.value_string_decode(value,
        ?decoded[0], 32);
    if (R.is_err[usize, str](result)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (expected[i] == 0 || decoded[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret expected[len] == 0;
}

pub fun status_from(value: *J.Value) u8 {
    if (value_equals(value, "pending")) { ret PENDING; }
    if (value_equals(value, "processing")) { ret PROCESSING; }
    if (value_equals(value, "valid")) { ret VALID; }
    if (value_equals(value, "invalid")) { ret INVALID; }
    ret 0;
}

pub fun token_valid(value: view.View) bool {
    if (!memory_range.valid(value.data, value.len) || value.len == 0 ||
        value.len > MAX_TOKEN_BYTES) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val current: u8 = value.data[i];
        if (!((current >= 'A' && current <= 'Z') ||
            (current >= 'a' && current <= 'z') ||
            (current >= '0' && current <= '9') || current == '-' ||
            current == '_')) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "acme.challenge: type names and tokens round trip under strict syntax" {
    if (kind_from_name(type_name(HTTP_01)) != HTTP_01 ||
        kind_from_name(type_name(DNS_01)) != DNS_01 ||
        kind_from_name(type_name(TLS_ALPN_01)) != TLS_ALPN_01) { ret 1; }
    if (kind_from_name(view.view("http-02", 7)) != 0 ||
        kind_from_name(view.view("", 0)) != 0 ||
        kind_from_name(view.view("dns-01x", 7)) != 0) { ret 2; }
    if (!token_valid(view.view("Z-Ab_09", 7)) ||
        token_valid(view.view("has padding=", 12)) ||
        token_valid(view.view("", 0))) { ret 3; }
    ret 0;
}

# rfc 8555 section 8.1: token "." base64url(sha-256 jwk thumbprint)
pub val MAX_KEY_AUTHORIZATION_BYTES: usize = MAX_TOKEN_BYTES + 1 +
    jose.THUMBPRINT_BYTES;
pub val DIGEST_BYTES: usize = 32;
# base64url of a 32-byte digest, unpadded
pub val MAX_DNS_VALUE_BYTES: usize = 43;
# "/.well-known/acme-challenge/" is 28 bytes
pub val MAX_HTTP_PATH_BYTES: usize = 28 + MAX_TOKEN_BYTES;
# "_acme-challenge." is 16 bytes
pub val MAX_DNS_NAME_BYTES: usize = 16 + identifier.MAX_DNS_BYTES;
# rfc 8737 section 3: an octet string wrapping the digest
pub val TLS_ALPN_EXTENSION_BYTES: usize = 2 + DIGEST_BYTES;

pub rec Operation {
    error:   problem.Error;
    written: usize;
    value:   view.View;
}

fun failed(kind: problem.Kind, code: problem.Code, detail: str) Operation {
    ret Operation{error: problem.local_code(kind, code, detail), written: 0,
        value: view.view(nil, 0)};
}

fun produced(output: contracts.Buffer, written: usize) Operation {
    ret Operation{error: problem.none(), written: written,
        value: view.view(output.data, written)};
}

fun output_valid(output: contracts.Buffer) bool {
    ret output.data != nil &&
        memory_range.valid(output.data, output.capacity);
}

fun write_bytes(output: contracts.Buffer, at: usize, data: *u8,
    len: usize) bool {
    if (!memory_range.valid(data, len) || len > output.capacity - at) {
        ret false;
    }
    var i: usize = 0;
    for (i < len) {
        output.data[at + i] = data[i];
        i = i + 1;
    }
    ret true;
}

fun sha256(data: *u8, len: usize, digest: *u8) bool {
    if (!memory_range.valid(data, len) ||
        !memory_range.valid(digest, DIGEST_BYTES)) { ret false; }
    var context: hash.Sha256 = hash.empty_sha256();
    if (hash.init_sha256(?context) != contracts.OK ||
        hash.update_sha256(?context,
            contracts.Bytes{data: data, len: len}) != contracts.OK) {
        hash.destroy_sha256(?context);
        ret false;
    }
    val result: contracts.Operation = hash.final_sha256(?context,
        contracts.Buffer{data: digest, capacity: DIGEST_BYTES});
    ret result.error == contracts.OK && result.written == DIGEST_BYTES;
}

# rfc 8555 section 8.1. the thumbprint is derived from the account key here
# rather than accepted from a caller, so a challenge can never be answered
# with a key the account does not hold.
pub fun key_authorization(value: Challenge, signer: jose.Signer,
    output: contracts.Buffer) Operation {
    if (!output_valid(output) || !jose.valid(signer) ||
        !token_valid(value.token) ||
        jose.public_key_overlaps(signer.public_key, output.data,
            output.capacity) ||
        memory_range.overlap(output.data, output.capacity, value.token.data,
            value.token.len)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid key authorization inputs");
    }
    var thumbprint: [43]u8;
    val computed: jose.Operation = jose.key_thumbprint(signer.public_key,
        contracts.Buffer{data: ?thumbprint[0],
            capacity: jose.THUMBPRINT_BYTES});
    if (problem.failed(computed.error)) {
        ret Operation{error: computed.error, written: 0,
            value: view.view(nil, 0)};
    }
    val total: usize = value.token.len + 1 + computed.written;
    if (output.capacity < total) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "key authorization output is too small");
    }
    if (!write_bytes(output, 0, value.token.data, value.token.len) ||
        !write_bytes(output, value.token.len, ".", 1) ||
        !write_bytes(output, value.token.len + 1, ?thumbprint[0],
            computed.written)) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "measured key authorization changed during encoding");
    }
    ret produced(output, total);
}

pub fun key_authorization_valid(value: view.View) bool {
    if (!memory_range.valid(value.data, value.len) ||
        value.len < 3 || value.len > MAX_KEY_AUTHORIZATION_BYTES) {
        ret false;
    }
    var dot: usize = 0;
    var i: usize = 0;
    for (i < value.len) {
        if (value.data[i] == '.') {
            if (dot != 0) { ret false; }
            dot = i;
        }
        i = i + 1;
    }
    if (dot == 0 || dot + 1 == value.len) { ret false; }
    ret token_valid(view.view(value.data, dot)) &&
        token_valid(view.view(?value.data[dot + 1], value.len - dot - 1));
}

# rfc 8555 section 8.3
pub fun http_path(value: Challenge, output: contracts.Buffer) Operation {
    if (!output_valid(output) || !token_valid(value.token) ||
        memory_range.overlap(output.data, output.capacity, value.token.data,
            value.token.len)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid http-01 path inputs");
    }
    val prefix: str = "/.well-known/acme-challenge/";
    val total: usize = 28 + value.token.len;
    if (output.capacity < total) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "http-01 path output is too small");
    }
    if (!write_bytes(output, 0, prefix, 28) ||
        !write_bytes(output, 28, value.token.data, value.token.len)) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "measured http-01 path changed during encoding");
    }
    ret produced(output, total);
}

# rfc 8555 section 8.4. a wildcard order is validated against the base domain,
# so the record name never carries the wildcard label.
pub fun dns_name(subject: identifier.Identifier,
    output: contracts.Buffer) Operation {
    val base: view.View = identifier.base_name(subject);
    if (!output_valid(output) || subject.kind != identifier.DNS ||
        !memory_range.valid(base.data, base.len) || base.len == 0 ||
        base.len > identifier.MAX_DNS_BYTES ||
        memory_range.overlap(output.data, output.capacity, base.data,
            base.len)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid dns-01 record name inputs");
    }
    val prefix: str = "_acme-challenge.";
    val total: usize = 16 + base.len;
    if (output.capacity < total) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "dns-01 record name output is too small");
    }
    if (!write_bytes(output, 0, prefix, 16) ||
        !write_bytes(output, 16, base.data, base.len)) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "measured dns-01 record name changed during encoding");
    }
    ret produced(output, total);
}

# rfc 8555 section 8.4: base64url(sha-256(key authorization))
pub fun dns_value(key_authorization_value: view.View,
    output: contracts.Buffer) Operation {
    if (!output_valid(output) ||
        !key_authorization_valid(key_authorization_value) ||
        memory_range.overlap(output.data, output.capacity,
            key_authorization_value.data, key_authorization_value.len)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid dns-01 value inputs");
    }
    if (output.capacity < MAX_DNS_VALUE_BYTES) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "dns-01 value output is too small");
    }
    var digest: [32]u8;
    if (!sha256(key_authorization_value.data, key_authorization_value.len,
            ?digest[0])) {
        ret failed(problem.CHALLENGE, problem.INVALID_STATE,
            "dns-01 digest failed");
    }
    val written: usize = base64.encode_url(?digest[0], DIGEST_BYTES,
        output.data, output.capacity);
    if (written != MAX_DNS_VALUE_BYTES) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "dns-01 value encoding disagreed with its preflight");
    }
    ret produced(output, written);
}

# rfc 8737 section 3: the raw sha-256 of the key authorization, which the
# caller places in a self-signed certificate for the identifier
pub fun tls_alpn_digest(key_authorization_value: view.View,
    output: contracts.Buffer) Operation {
    if (!output_valid(output) ||
        !key_authorization_valid(key_authorization_value) ||
        memory_range.overlap(output.data, output.capacity,
            key_authorization_value.data, key_authorization_value.len)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid tls-alpn-01 digest inputs");
    }
    if (output.capacity < DIGEST_BYTES) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "tls-alpn-01 digest output is too small");
    }
    if (!sha256(key_authorization_value.data, key_authorization_value.len,
            output.data)) {
        ret failed(problem.CHALLENGE, problem.INVALID_STATE,
            "tls-alpn-01 digest failed");
    }
    ret produced(output, DIGEST_BYTES);
}

# rfc 8737 section 3: the acmeIdentifier extension value is the der octet
# string wrapping that digest. the oid is 1.3.6.1.5.5.7.1.31 and the
# extension must be marked critical by the caller building the certificate.
pub fun tls_alpn_extension(key_authorization_value: view.View,
    output: contracts.Buffer) Operation {
    if (!output_valid(output)) {
        ret failed(problem.CHALLENGE, problem.INVALID_INPUT,
            "invalid tls-alpn-01 extension output");
    }
    if (output.capacity < TLS_ALPN_EXTENSION_BYTES) {
        ret failed(problem.LIMIT, problem.OUTPUT_TOO_SMALL,
            "tls-alpn-01 extension output is too small");
    }
    var digest: [32]u8;
    val computed: Operation = tls_alpn_digest(key_authorization_value,
        contracts.Buffer{data: ?digest[0], capacity: DIGEST_BYTES});
    if (problem.failed(computed.error)) { ret computed; }
    output.data[0] = 0x04;
    output.data[1] = 0x20;
    if (!write_bytes(output, 2, ?digest[0], DIGEST_BYTES)) {
        ret failed(problem.STATE, problem.INVALID_STATE,
            "tls-alpn-01 extension encoding failed");
    }
    ret produced(output, TLS_ALPN_EXTENSION_BYTES);
}

pub def AttemptState: u8;

pub val ATTEMPT_IDLE:      AttemptState = 0;
pub val ATTEMPT_PRESENTED: AttemptState = 1;
pub val ATTEMPT_CLEANED:   AttemptState = 2;
pub val ATTEMPT_FAILED:    AttemptState = 3;

# one presentation of one challenge through one provider.
#
# cleanup is owed exactly when presentation succeeded. `finish` is the single
# exit for success, failure, timeout, and cancellation, so every path retires
# the provider's state once and only once. The call counters are public so
# exactly-once is observed rather than inferred.
pub rec Attempt {
    provider:       Provider;
    presentation:   Presentation;
    subject:        identifier.Identifier;
    kind:           u8;
    state:          AttemptState;
    present_calls:  usize;
    cleanup_calls:  usize;
    owner:          ptr;
    callback_owner: i64;
}

pub fun provider_valid(value: Provider) bool {
    ret value.supports != nil && value.present != nil && value.cleanup != nil;
}

fun challenge_error(code: problem.Code, detail: str) problem.Error {
    ret problem.local_code(problem.CHALLENGE, code, detail);
}

fun attempt_ready(attempt: *Attempt) bool {
    ret attempt != nil &&
        memory_range.valid(attempt::*u8, $size_of(Attempt)) &&
        attempt.owner == attempt::ptr && provider_valid(attempt.provider);
}

# rejects same-thread reentry before a nested callback can move the attempt
fun enter(attempt: *Attempt) bool {
    val owner: i64 = os.thread_current_id();
    if (owner <= 0) { ret false; }
    for (true) {
        var expected: i64 = atomic.load(?attempt.callback_owner);
        if (expected == owner) { ret false; }
        if (expected == 0 &&
            atomic.cas(?attempt.callback_owner, ?expected, owner)) {
            ret true;
        }
        if (expected != 0) {
            os.thread_wait(?attempt.callback_owner, expected);
        }
    }
    ret false;
}

fun leave(attempt: *Attempt) {
    atomic.store(?attempt.callback_owner, 0);
    os.thread_wake(?attempt.callback_owner);
}

pub fun attempt_init(attempt: *Attempt, provider: Provider) problem.Error {
    if (attempt == nil ||
        !memory_range.valid(attempt::*u8, $size_of(Attempt)) ||
        !provider_valid(provider)) {
        ret challenge_error(problem.INVALID_INPUT,
            "invalid challenge attempt or provider");
    }
    attempt.provider = provider;
    attempt.presentation = Presentation{ctx: nil};
    attempt.subject = identifier.Identifier{kind: 0, value: view.view(nil, 0)};
    attempt.kind = 0;
    attempt.state = ATTEMPT_IDLE;
    attempt.present_calls = 0;
    attempt.cleanup_calls = 0;
    attempt.owner = attempt::ptr;
    atomic.store(?attempt.callback_owner, 0);
    ret problem.none();
}

pub fun supports(attempt: *Attempt, subject: identifier.Identifier,
    kind: u8) bool {
    if (!attempt_ready(attempt) || kind == 0) { ret false; }
    if (!enter(attempt)) { ret false; }
    val answer: bool = attempt.provider.supports(attempt.provider.ctx, subject,
        kind);
    leave(attempt);
    ret answer;
}

# presents the challenge exactly once. a provider that declines the challenge
# is never asked to present, and a presentation that failed owes no cleanup.
pub fun begin(attempt: *Attempt, subject: identifier.Identifier,
    value: Challenge, key_authorization_value: view.View) problem.Error {
    if (!attempt_ready(attempt) || value.typ == 0 ||
        !token_valid(value.token) ||
        !key_authorization_valid(key_authorization_value)) {
        ret challenge_error(problem.INVALID_INPUT,
            "invalid challenge presentation inputs");
    }
    if (attempt.state != ATTEMPT_IDLE) {
        ret challenge_error(problem.INVALID_STATE,
            "challenge attempt has already been presented");
    }
    if (!enter(attempt)) {
        ret challenge_error(problem.INVALID_STATE,
            "challenge attempt is already inside a provider callback");
    }
    if (!attempt.provider.supports(attempt.provider.ctx, subject, value.typ)) {
        leave(attempt);
        ret problem.local_code(problem.POLICY, problem.INVALID_INPUT,
            "provider does not support this challenge and identifier");
    }
    # counted before the call, so a provider that fails or traps still shows
    # exactly one presentation attempt
    attempt.present_calls = attempt.present_calls + 1;
    attempt.subject = subject;
    attempt.kind = value.typ;
    val result: R.Result[Presentation, problem.Error] =
        attempt.provider.present(attempt.provider.ctx, subject, value,
            key_authorization_value);
    if (R.is_err[Presentation, problem.Error](result)) {
        attempt.state = ATTEMPT_FAILED;
        leave(attempt);
        ret R.unwrap_err[Presentation, problem.Error](result);
    }
    attempt.presentation = R.unwrap_ok[Presentation, problem.Error](result);
    attempt.state = ATTEMPT_PRESENTED;
    leave(attempt);
    ret problem.none();
}

pub fun presented(attempt: *Attempt) bool {
    ret attempt_ready(attempt) && attempt.state == ATTEMPT_PRESENTED;
}

# the single exit for success, failure, timeout, and cancellation. calling it
# again is accepted and does not reach the provider a second time.
pub fun finish(attempt: *Attempt) problem.Error {
    if (!attempt_ready(attempt)) {
        ret challenge_error(problem.INVALID_INPUT,
            "invalid challenge attempt");
    }
    if (attempt.state == ATTEMPT_CLEANED) { ret problem.none(); }
    if (!enter(attempt)) {
        ret challenge_error(problem.INVALID_STATE,
            "challenge attempt is already inside a provider callback");
    }
    if (attempt.state != ATTEMPT_PRESENTED) {
        # nothing was ever published, so nothing is owed
        attempt.state = ATTEMPT_CLEANED;
        leave(attempt);
        ret problem.none();
    }
    attempt.cleanup_calls = attempt.cleanup_calls + 1;
    val result: R.Result[bool, problem.Error] = attempt.provider.cleanup(
        attempt.provider.ctx, attempt.presentation);
    # the attempt is retired either way. a provider that could not withdraw
    # its own state reports that, but is never asked twice.
    attempt.state = ATTEMPT_CLEANED;
    attempt.presentation = Presentation{ctx: nil};
    leave(attempt);
    if (R.is_err[bool, problem.Error](result)) {
        ret R.unwrap_err[bool, problem.Error](result);
    }
    ret problem.none();
}

# waiting for a presented record to become observable is a caller policy. the
# probe is injectable so a deployment supplies a resolver and a test supplies
# a deterministic observation.
pub def ObserveFun: fun(ptr, view.View, view.View) bool;

pub rec Probe {
    ctx:     ptr;
    observe: ObserveFun;
}

pub rec PropagationPolicy {
    poll:            poll.Policy;
    required_checks: usize;
}

pub rec Propagation {
    policy:    PropagationPolicy;
    state:     poll.State;
    confirmed: usize;
    checks:    usize;
}

pub fun propagation_policy_default() PropagationPolicy {
    var policy: poll.Policy = poll.policy_default();
    policy.min_delay_ns = 2000000000;
    policy.max_delay_ns = 30000000000;
    policy.max_attempts = 30;
    ret PropagationPolicy{poll: policy, required_checks: 2};
}

pub fun propagation_policy_valid(value: PropagationPolicy) bool {
    ret poll.policy_valid(value.poll) && value.required_checks != 0 &&
        value.required_checks <= 64;
}

pub fun propagation_begin(state: *Propagation, policy: PropagationPolicy,
    deadline_ns: i64) problem.Error {
    if (state == nil ||
        !memory_range.valid(state::*u8, $size_of(Propagation)) ||
        !propagation_policy_valid(policy)) {
        ret problem.local_code(problem.POLICY, problem.INVALID_INPUT,
            "invalid propagation policy");
    }
    state.policy = policy;
    state.confirmed = 0;
    state.checks = 0;
    ret poll.begin(?state.state, policy.poll, deadline_ns);
}

pub fun propagation_cancel(state: *Propagation) bool {
    if (state == nil ||
        !memory_range.valid(state::*u8, $size_of(Propagation))) {
        ret false;
    }
    ret poll.cancel(?state.state);
}

# one observation per call. confirmations must be consecutive, so a record
# that appears and then disappears restarts the count rather than proceeding.
pub fun propagation_next(state: *Propagation, probe: Probe, name: view.View,
    expected: view.View, now_ns: i64) poll.Decision {
    if (state == nil ||
        !memory_range.valid(state::*u8, $size_of(Propagation)) ||
        !propagation_policy_valid(state.policy) || probe.observe == nil ||
        !memory_range.valid(name.data, name.len) || name.len == 0 ||
        !memory_range.valid(expected.data, expected.len) ||
        expected.len == 0) {
        ret poll.Decision{action: poll.TERMINAL, delay_ns: 0,
            cause: challenge_error(problem.INVALID_INPUT,
                "invalid propagation probe or record")};
    }
    if (poll.cancelled(?state.state)) {
        ret poll.next(?state.state, false, false, 0, now_ns);
    }
    if (state.checks == 0xffffffffffffffff) {
        ret poll.Decision{action: poll.LIMIT, delay_ns: 0,
            cause: problem.local_code(problem.POLICY, problem.RETRY_LIMIT,
                "propagation check counter exhausted")};
    }
    state.checks = state.checks + 1;
    if (probe.observe(probe.ctx, name, expected)) {
        state.confirmed = state.confirmed + 1;
    } or {
        state.confirmed = 0;
    }
    ret poll.next(?state.state,
        state.confirmed >= state.policy.required_checks, false, 0, now_ns);
}

fun same_bytes(first: *u8, second: *u8, len: usize) bool {
    var i: usize = 0;
    for (i < len) {
        if (first[i] != second[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "acme.challenge: rfc 8555 and rfc 8737 challenge data are exact" {
    # rfc 8555 section 8.3 worked example
    val token: str = "LoqXcYV8q5ONbJQxbmR7SCTNo3tiAXDfowyjxAjEuX0";
    val thumbprint: str = "9jg46WB3rR_AHD-EBXdN7cBkH1WOu0tA3M9fm21mqTI";
    val expected: str = "LoqXcYV8q5ONbJQxbmR7SCTNo3tiAXDfowyjxAjEuX0.9jg46WB3rR_AHD-EBXdN7cBkH1WOu0tA3M9fm21mqTI";
    var authorization: [256]u8;
    var i: usize = 0;
    for (i < 43) {
        authorization[i] = token[i];
        authorization[44 + i] = thumbprint[i];
        i = i + 1;
    }
    authorization[43] = '.';
    val key_auth: view.View = view.view(?authorization[0], 87);
    if (!key_authorization_valid(key_auth) ||
        !same_bytes(?authorization[0], expected, 87)) { ret 1; }

    # rfc 8555 section 8.3: the path the authority fetches
    var path: [256]u8;
    val http: Operation = http_path(Challenge{typ: HTTP_01,
        url: view.view(nil, 0), token: view.view(token, 43), status: PENDING,
        validated: view.view(nil, 0)},
        contracts.Buffer{data: ?path[0], capacity: 256});
    val expected_path: str = "/.well-known/acme-challenge/LoqXcYV8q5ONbJQxbmR7SCTNo3tiAXDfowyjxAjEuX0";
    if (problem.failed(http.error) || http.written != 71 ||
        !same_bytes(?path[0], expected_path, 71)) { ret 2; }

    # rfc 8555 section 8.4: base64url(sha-256(key authorization))
    var record: [64]u8;
    val dns: Operation = dns_value(key_auth,
        contracts.Buffer{data: ?record[0], capacity: 64});
    val expected_record: str = "LPsIwTo7o8BoG0-vjCyGQGBWSVIPxI-i_X336eUOQZo";
    if (problem.failed(dns.error) || dns.written != 43 ||
        !same_bytes(?record[0], expected_record, 43)) { ret 3; }

    # rfc 8737 section 3: the raw digest, and the der octet string that
    # carries it in the acmeIdentifier extension
    val expected_digest: [32]u8 = [32]u8{
        0x2c, 0xfb, 0x08, 0xc1, 0x3a, 0x3b, 0xa3, 0xc0,
        0x68, 0x1b, 0x4f, 0xaf, 0x8c, 0x2c, 0x86, 0x40,
        0x60, 0x56, 0x49, 0x52, 0x0f, 0xc4, 0x8f, 0xa2,
        0xfd, 0x7d, 0xf7, 0xe9, 0xe5, 0x0e, 0x41, 0x9a};
    var digest: [32]u8;
    val raw: Operation = tls_alpn_digest(key_auth,
        contracts.Buffer{data: ?digest[0], capacity: 32});
    if (problem.failed(raw.error) || raw.written != 32 ||
        !same_bytes(?digest[0], ?expected_digest[0], 32)) { ret 4; }
    var extension: [64]u8;
    val wrapped: Operation = tls_alpn_extension(key_auth,
        contracts.Buffer{data: ?extension[0], capacity: 64});
    if (problem.failed(wrapped.error) ||
        wrapped.written != TLS_ALPN_EXTENSION_BYTES ||
        extension[0] != 0x04 || extension[1] != 0x20 ||
        !same_bytes(?extension[2], ?expected_digest[0], 32)) { ret 5; }

    # rfc 8555 section 8.4: a wildcard order is validated against the base
    # domain, so the record name carries no wildcard label
    var name: [320]u8;
    val wildcard: Operation = dns_name(identifier.Identifier{
        kind: identifier.DNS, value: view.view("*.example.org", 13)},
        contracts.Buffer{data: ?name[0], capacity: 320});
    val plain: Operation = dns_name(identifier.Identifier{
        kind: identifier.DNS, value: view.view("example.org", 11)},
        contracts.Buffer{data: ?name[0], capacity: 320});
    if (problem.failed(wildcard.error) || wildcard.written != 27 ||
        problem.failed(plain.error) || plain.written != 27 ||
        !same_bytes(?name[0], "_acme-challenge.example.org", 27)) { ret 6; }

    # capacity failures publish nothing
    var small: [8]u8;
    if (dns_value(key_auth,
            contracts.Buffer{data: ?small[0], capacity: 8}).error.code !=
            problem.OUTPUT_TOO_SMALL ||
        tls_alpn_extension(key_auth,
            contracts.Buffer{data: ?small[0], capacity: 8}).error.code !=
            problem.OUTPUT_TOO_SMALL ||
        http_path(Challenge{typ: HTTP_01, url: view.view(nil, 0),
            token: view.view(token, 43), status: PENDING,
            validated: view.view(nil, 0)},
            contracts.Buffer{data: ?small[0], capacity: 8}).error.code !=
            problem.OUTPUT_TOO_SMALL) { ret 7; }

    # a malformed key authorization never reaches a digest
    if (!problem.failed(dns_value(view.view("no-dot-here", 11),
            contracts.Buffer{data: ?record[0], capacity: 64}).error) ||
        !problem.failed(dns_value(view.view(".leading", 8),
            contracts.Buffer{data: ?record[0], capacity: 64}).error) ||
        key_authorization_valid(view.view("a.b.c", 5)) ||
        !problem.failed(dns_name(identifier.Identifier{kind: identifier.IP,
            value: view.view("192.0.2.1", 9)},
            contracts.Buffer{data: ?name[0], capacity: 320}).error)) {
        ret 8;
    }
    ret 0;
}

# rfc 8555 section 7.5.1: the client tells the authority a challenge is ready
# by posting an empty json object to the challenge url under its account kid
pub val RESPOND_PAYLOAD: str = "{}";

pub fun begin_respond(protocol: *client.Client,
    state: *client.SignedRequest, challenge_url: view.View,
    account_url: view.View, payload: view.View,
    signer: jose.Signer) problem.Error {
    if (!memory_range.valid(payload.data, payload.len) || payload.len != 2 ||
        payload.data[0] != '{' || payload.data[1] != '}' ||
        account_url.len == 0) {
        ret challenge_error(problem.INVALID_INPUT,
            "challenge response payload must be an empty json object");
    }
    ret client.begin_signed_bound(protocol, state, client.SignedSpec{
        url: challenge_url, payload: payload, kid: account_url,
        use_jwk: false}, signer);
}
