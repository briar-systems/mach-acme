# challenge presentation and cleanup boundary

use J: std.data.json;
use R: std.types.result;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.identifier;
use acme.memory_range;
use acme.problem;

pub val HTTP_01:     u8 = 1;
pub val DNS_01:      u8 = 2;
pub val TLS_ALPN_01: u8 = 3;

pub val PENDING:    u8 = 1;
pub val PROCESSING: u8 = 2;
pub val VALID:      u8 = 3;
pub val INVALID:    u8 = 4;

# rfc 8555 tokens are base64url with at least 128 bits of entropy. the ceiling
# bounds every derived key authorization, dns record, and file name.
pub val MAX_TOKEN_BYTES: usize = 128;

pub rec Challenge {
    typ:       u8;
    url:       view.View;
    token:     view.View;
    status:    u8;
    validated: view.View;
    failure:   problem.Problem;
}

pub rec Presentation {
    ctx: ptr;
}

pub def SupportsFun: fun(ptr, identifier.Identifier, u8) bool;
pub def PresentFun: fun(ptr, identifier.Identifier, Challenge, view.View) R.Result[Presentation, problem.Error];
pub def CleanupFun: fun(ptr, Presentation) R.Result[bool, problem.Error];

pub rec Provider {
    ctx:      ptr;
    supports: SupportsFun;
    present:  PresentFun;
    cleanup:  CleanupFun;
}

pub rec Providers {
    items: *Provider;
    len:   usize;
}

pub fun type_name(kind: u8) view.View {
    if (kind == HTTP_01) { ret view.view("http-01", 7); }
    if (kind == DNS_01) { ret view.view("dns-01", 6); }
    if (kind == TLS_ALPN_01) { ret view.view("tls-alpn-01", 11); }
    ret view.view(nil, 0);
}

fun name_is(value: view.View, expected: str, len: usize) bool {
    if (value.len != len) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (value.data[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# an unknown type maps to zero rather than failing, so an authorization that
# offers a challenge this build does not implement is still usable
pub fun kind_from_name(value: view.View) u8 {
    if (!memory_range.valid(value.data, value.len) || value.len == 0) {
        ret 0;
    }
    if (name_is(value, "http-01", 7)) { ret HTTP_01; }
    if (name_is(value, "dns-01", 6)) { ret DNS_01; }
    if (name_is(value, "tls-alpn-01", 11)) { ret TLS_ALPN_01; }
    ret 0;
}

fun value_equals(value: *J.Value, expected: *u8) bool {
    if (value == nil || value.kind != J.STRING) { ret false; }
    var decoded: [32]u8;
    val measured: R.Result[usize, str] = J.value_string_decode(value, nil, 0);
    if (R.is_err[usize, str](measured)) { ret false; }
    val len: usize = R.unwrap_ok[usize, str](measured);
    if (len > 31) { ret false; }
    val result: R.Result[usize, str] = J.value_string_decode(value,
        ?decoded[0], 32);
    if (R.is_err[usize, str](result)) { ret false; }
    var i: usize = 0;
    for (i < len) {
        if (expected[i] == 0 || decoded[i] != expected[i]) { ret false; }
        i = i + 1;
    }
    ret expected[len] == 0;
}

pub fun status_from(value: *J.Value) u8 {
    if (value_equals(value, "pending")) { ret PENDING; }
    if (value_equals(value, "processing")) { ret PROCESSING; }
    if (value_equals(value, "valid")) { ret VALID; }
    if (value_equals(value, "invalid")) { ret INVALID; }
    ret 0;
}

pub fun token_valid(value: view.View) bool {
    if (!memory_range.valid(value.data, value.len) || value.len == 0 ||
        value.len > MAX_TOKEN_BYTES) { ret false; }
    var i: usize = 0;
    for (i < value.len) {
        val current: u8 = value.data[i];
        if (!((current >= 'A' && current <= 'Z') ||
            (current >= 'a' && current <= 'z') ||
            (current >= '0' && current <= '9') || current == '-' ||
            current == '_')) { ret false; }
        i = i + 1;
    }
    ret true;
}

test "acme.challenge: type names and tokens round trip under strict syntax" {
    if (kind_from_name(type_name(HTTP_01)) != HTTP_01 ||
        kind_from_name(type_name(DNS_01)) != DNS_01 ||
        kind_from_name(type_name(TLS_ALPN_01)) != TLS_ALPN_01) { ret 1; }
    if (kind_from_name(view.view("http-02", 7)) != 0 ||
        kind_from_name(view.view("", 0)) != 0 ||
        kind_from_name(view.view("dns-01x", 7)) != 0) { ret 2; }
    if (!token_valid(view.view("Z-Ab_09", 7)) ||
        token_valid(view.view("has padding=", 12)) ||
        token_valid(view.view("", 0))) { ret 3; }
    ret 0;
}
