# csr and issued certificate boundary

use R: std.types.result;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use tls.cert;
use acme.identifier;

pub def GenerateCsrFun: fun(ptr, *identifier.Identifier, usize, *u8, usize, *cert.PrivateKey) R.Result[usize, str];

pub rec CsrProvider {
    ctx:                ptr;
    generate:           GenerateCsrFun;
    max_csr_der_bytes:  usize;
}

pub rec Issued {
    storage_key:    view.View;
    certificate_url: view.View;
    chain:          cert.Chain;
    private_key:    cert.PrivateKey;
    identifiers:    *identifier.Identifier;
    identifier_len: usize;
    not_before_unix: u64;
    not_after_unix:  u64;
}
