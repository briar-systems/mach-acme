# csr and issued certificate boundary

use R: std.types.result;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;
use acme.identifier;

pub rec Certificate {
    der: view.View;
}

pub rec Chain {
    certificates: *Certificate;
    len:          usize;
}

# the provider owns the key material behind this opaque reference
pub rec PrivateKey {
    ctx:       ptr;
    algorithm: u16;
}

pub def GenerateCsrFun: fun(ptr, *identifier.Identifier, usize, *u8, usize, *PrivateKey) R.Result[usize, str];

pub rec CsrProvider {
    ctx:                ptr;
    generate:           GenerateCsrFun;
    max_csr_der_bytes:  usize;
}

pub rec Issued {
    storage_key:    view.View;
    certificate_url: view.View;
    chain:          Chain;
    private_key:    PrivateKey;
    identifiers:    *identifier.Identifier;
    identifier_len: usize;
    not_before_unix: u64;
    not_after_unix:  u64;
}
