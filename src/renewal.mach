# renewal scheduling
#
# the scheduler owns no clock, no timer, and no randomness. every decision is a
# pure function of the caller's supplied wall-clock reading, the certificate's
# own lifetime, the authority's renewal advice, and an injected random source,
# so a deployment and a test see identical behaviour.

use acme.certificate;
use acme.memory_range;
use acme.problem;
use acme.renewal_info;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view;

pub def State: u8;

pub val IDLE:      State = 0;
pub val SCHEDULED: State = 1;
pub val DUE:       State = 2;
pub val RUNNING:   State = 3;
pub val RETRYING:  State = 4;
pub val RENEWED:   State = 5;
pub val EXHAUSTED: State = 6;
pub val CANCELLED: State = 7;

pub fun terminal(value: State) bool {
    ret value == RENEWED || value == EXHAUSTED || value == CANCELLED;
}

pub rec Policy {
    renew_before_seconds:   u64;
    min_retry_seconds:      u64;
    max_retry_seconds:      u64;
    jitter_seconds:         u64;
    max_attempts:           usize;
    max_clock_skew_seconds: u64;
}

# ninety-day certificates are the common case, so a thirty-day lead and a
# spread of a day keep a fleet from renewing in lockstep
pub fun policy_default() Policy {
    ret Policy{renew_before_seconds: 2592000, min_retry_seconds: 300,
        max_retry_seconds:      86400, jitter_seconds: 86400, max_attempts: 12,
        max_clock_skew_seconds: 300};
}

pub fun policy_valid(value: Policy) bool {
    ret value.renew_before_seconds != 0 &&
        value.renew_before_seconds <= 31536000 &&
        value.min_retry_seconds != 0 &&
        value.max_retry_seconds >= value.min_retry_seconds &&
        value.max_retry_seconds <= 2592000 &&
        value.jitter_seconds <= 2592000 && value.max_attempts != 0 &&
        value.max_attempts <= 1024 &&
        value.max_clock_skew_seconds <= 86400;
}

# randomness is injected so a fleet spreads its renewals while a test stays
# deterministic
pub def RandomFun: fun(ptr) u64;

pub rec Random {
    ctx:  ptr;
    next: RandomFun;
}

pub fun no_random() Random {
    ret Random{ctx: nil, next: nil};
}

pub rec Event {
    storage_key:   view.View;
    previous:      State;
    current:       State;
    attempt:       usize;
    next_run_unix: u64;
    cause:         problem.Error;
}

pub def EventFun: fun(ptr, Event);

pub rec Observer {
    ctx:           ptr;
    on_transition: EventFun;
}

pub fun no_observer() Observer {
    ret Observer{ctx: nil, on_transition: nil};
}

# one certificate's renewal state. it is derived entirely from the durable
# certificate record plus the policy, so a restart reconstructs it rather than
# needing its own durable copy.
pub rec Schedule {
    policy:          Policy;
    storage_key:     view.View;
    not_before_unix: u64;
    not_after_unix:  u64;
    next_run_unix:   u64;
    last_seen_unix:  u64;
    attempts:        usize;
    state:           State;
    started:         bool;
}

fun renewal_error(code: problem.Code, detail: str) problem.Error {
    ret problem.local_code(problem.POLICY, code, detail);
}

fun schedule_ready(value: *Schedule) bool {
    ret value != nil &&
        memory_range.valid(value::*u8, $size_of(Schedule)) && value.started &&
        policy_valid(value.policy);
}

fun emit(observer: Observer, value: *Schedule, previous: State,
    cause: problem.Error) {
    if (observer.on_transition == nil) { ret; }
    observer.on_transition(observer.ctx, Event{storage_key: value.storage_key,
        previous:      previous, current: value.state, attempt: value.attempts,
        next_run_unix: value.next_run_unix, cause: cause});
}

fun transition(observer: Observer, value: *Schedule, next: State,
    cause: problem.Error) {
    val previous: State = value.state;
    value.state = next;
    if (previous != next) { emit(observer, value, previous, cause); }
}

fun bounded_random(source: Random, span: u64) u64 {
    if (span == 0 || source.next == nil) { ret 0; }
    ret source.next(source.ctx) % span;
}

pub fun due(now_unix: u64, not_after_unix: u64,
    renew_before_seconds: u64) bool {
    if (not_after_unix <= now_unix) { ret true; }
    ret not_after_unix - now_unix <= renew_before_seconds;
}

fun add_saturating(value: u64, delta: u64) u64 {
    if (delta > 0xffffffffffffffff - value) { ret 0xffffffffffffffff; }
    ret value + delta;
}

# the authority's window wins when it is usable, because it is the only party
# that knows about a mass revocation. it is still clamped to the certificate's
# own lifetime, so a wild suggestion cannot schedule a renewal after expiry or
# before the certificate exists.
fun target_time(value: *Schedule, advice: renewal_info.Window,
    source: Random) u64 {
    if (renewal_info.window_valid(advice)) {
        var start:  u64 = advice.start_unix;
        var finish: u64 = advice.end_unix;
        if (start < value.not_before_unix) { start = value.not_before_unix; }
        if (finish > value.not_after_unix) { finish = value.not_after_unix; }
        if (finish > start) {
            # draft-ietf-acme-ari section 4.2: pick uniformly within the window
            ret start + bounded_random(source, finish - start);
        }
    }
    # without usable advice, renew a policy-defined lead before expiry and
    # spread the fleet with jitter
    var target: u64 = value.not_before_unix;
    if (value.not_after_unix > value.policy.renew_before_seconds) {
        target = value.not_after_unix - value.policy.renew_before_seconds;
    }
    if (target < value.not_before_unix) { target = value.not_before_unix; }
    val spread: u64 = bounded_random(source, value.policy.jitter_seconds);
    var chosen: u64 = add_saturating(target, spread);
    if (chosen >= value.not_after_unix) {
        chosen = value.not_after_unix - 1;
        if (value.not_after_unix == 0) { chosen = 0; }
    }
    ret chosen;
}

pub fun begin(value: *Schedule, policy: Policy, storage_key: view.View,
    not_before_unix: u64, not_after_unix: u64) problem.Error {
    if (value == nil || !memory_range.valid(value::*u8, $size_of(Schedule)) ||
        !policy_valid(policy) ||
        !memory_range.valid(storage_key.data, storage_key.len) ||
        storage_key.len == 0 || not_after_unix <= not_before_unix) {
        ret renewal_error(problem.INVALID_INPUT, "invalid renewal schedule");
    }
    value.policy          = policy;
    value.storage_key     = storage_key;
    value.not_before_unix = not_before_unix;
    value.not_after_unix  = not_after_unix;
    value.next_run_unix   = 0;
    value.last_seen_unix  = 0;
    value.attempts        = 0;
    value.state           = IDLE;
    value.started         = true;
    ret problem.none();
}

# recomputes the next run from the certificate's lifetime and the authority's
# advice. planning again after a restart yields a schedule of the same shape,
# so no scheduling state needs to be durable.
pub fun plan(value: *Schedule, advice: renewal_info.Window, source: Random,
    now_unix: u64, observer: Observer) problem.Error {
    if (!schedule_ready(value)) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule is not initialized");
    }
    if (terminal(value.state)) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule has already finished");
    }
    value.last_seen_unix = now_unix;
    value.next_run_unix  = target_time(value, advice, source);
    if (value.next_run_unix <= now_unix ||
        due(now_unix, value.not_after_unix,
        value.policy.renew_before_seconds)) {
        value.next_run_unix = now_unix;
        transition(observer, value, DUE, problem.none());
        ret problem.none();
    }
    transition(observer, value, SCHEDULED, problem.none());
    ret problem.none();
}

# a clock that moved backwards further than the tolerated skew is not evidence
# that a renewal is due. the schedule is replanned from the new reading rather
# than firing, so a corrected clock cannot cause a renewal storm.
pub fun clock_moved_back(value: *Schedule, now_unix: u64) bool {
    if (!schedule_ready(value) || value.last_seen_unix == 0) { ret false; }
    if (now_unix >= value.last_seen_unix)                    { ret false; }
    ret value.last_seen_unix - now_unix > value.policy.max_clock_skew_seconds;
}

pub fun ready(value: *Schedule, now_unix: u64) bool {
    if (!schedule_ready(value) || terminal(value.state) ||
        value.state == RUNNING) { ret false; }
    if (clock_moved_back(value, now_unix)) { ret false; }
    # urgency comes from the certificate's own lifetime, not only from the
    # instant that was planned, so a certificate inside its renewal lead is
    # due even if the clock drifted back a little. a schedule that is backing
    # off is excluded, because otherwise an expiring certificate that keeps
    # failing would retry without pause.
    if (value.state != RETRYING &&
        due(now_unix, value.not_after_unix,
        value.policy.renew_before_seconds)) { ret true; }
    ret now_unix >= value.next_run_unix;
}

pub fun start(value: *Schedule, now_unix: u64,
    observer: Observer) problem.Error {
    if (!schedule_ready(value) || terminal(value.state) ||
        value.state == RUNNING) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule cannot start");
    }
    if (!ready(value, now_unix)) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule is not due");
    }
    value.last_seen_unix = now_unix;
    value.attempts       = value.attempts + 1;
    transition(observer, value, RUNNING, problem.none());
    ret problem.none();
}

pub fun succeeded(value: *Schedule, now_unix: u64,
    observer: Observer) problem.Error {
    if (!schedule_ready(value) || value.state != RUNNING) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule is not running");
    }
    value.last_seen_unix = now_unix;
    value.next_run_unix  = 0;
    transition(observer, value, RENEWED, problem.none());
    ret problem.none();
}

fun backoff(policy: Policy, attempts: usize) u64 {
    var delay: u64   = policy.min_retry_seconds;
    var i:     usize = 1;
    for (i < attempts) {
        if (delay >= policy.max_retry_seconds ||
            delay > 0x7fffffffffffffff) { ret policy.max_retry_seconds; }
        delay = delay * 2;
        i     = i + 1;
    }
    if (delay > policy.max_retry_seconds) { ret policy.max_retry_seconds; }
    ret delay;
}

# a failed attempt backs off within a ceiling and counts against a fixed
# budget, so a prolonged outage produces a bounded number of widely spaced
# attempts rather than an unbounded retry loop
pub fun failed(value: *Schedule, cause: problem.Error, source: Random,
    now_unix: u64, observer: Observer) problem.Error {
    if (!schedule_ready(value) || value.state != RUNNING) {
        ret renewal_error(problem.INVALID_STATE,
            "renewal schedule is not running");
    }
    value.last_seen_unix = now_unix;
    if (value.attempts >= value.policy.max_attempts) {
        value.next_run_unix = 0;
        transition(observer, value, EXHAUSTED, cause);
        ret problem.none();
    }
    var delay:  u64 = backoff(value.policy, value.attempts);
    val spread: u64 = bounded_random(source, value.policy.jitter_seconds);
    if (spread > value.policy.max_retry_seconds - delay) {
        delay = value.policy.max_retry_seconds;
    }
    or { delay = delay + spread; }
    value.next_run_unix = add_saturating(now_unix, delay);
    transition(observer, value, RETRYING, cause);
    ret problem.none();
}

pub fun cancel(value: *Schedule, observer: Observer) bool {
    if (!schedule_ready(value) || terminal(value.state)) { ret false; }
    value.next_run_unix = 0;
    transition(observer, value, CANCELLED,
        renewal_error(problem.INVALID_STATE, "renewal was cancelled"));
    ret true;
}

# the certificate closest to expiry goes first. a schedule that is retrying is
# not selected before its backoff elapses, so urgency cannot turn into a spin.
pub fun select_next(schedules: *Schedule, len: usize,
    now_unix: u64) *Schedule {
    if (len == 0) { ret nil; }
    var item_bytes: usize = 0;
    if (!memory_range.size(len, $size_of(Schedule), ?item_bytes) ||
        !memory_range.valid(schedules::*u8, item_bytes)) { ret nil; }
    var chosen: *Schedule = nil;
    var i:      usize     = 0;
    for (i < len) {
        val candidate: *Schedule = ?schedules[i];
        if (ready(candidate, now_unix) &&
            (chosen == nil ||
            candidate.not_after_unix < chosen.not_after_unix)) {
            chosen = candidate;
        }
        i = i + 1;
    }
    ret chosen;
}

test regression__due_expiry_underflow {
    if (!due(200, 100, 30)) { ret 1; }
    if (!due(80, 100, 20))  { ret 1; }
    if (due(79, 100, 20))   { ret 1; }
    ret 0;
}

#[testing]
rec FixedRandom {
    value: u64;
}

#[testing]
fun fixed_random(ctx: ptr) u64 {
    ret (ctx::*FixedRandom).value;
}

#[testing]
rec Recorder {
    count:    usize;
    previous: [16]State;
    current:  [16]State;
}

#[testing]
fun record(ctx: ptr, value: Event) {
    val state: *Recorder = ctx::*Recorder;
    if (state.count >= 16) { ret; }
    state.previous[state.count] = value.previous;
    state.current[state.count]  = value.current;
    state.count                 = state.count + 1;
}

test schedule__advice_lifetime_skew_budgets {
    val day:     u64    = 86400;
    val issued:  u64    = 1700000000;
    val expires: u64    = issued + 90 * day;
    var policy:  Policy = policy_default();
    policy.renew_before_seconds   = 30 * day;
    policy.jitter_seconds         = 0;
    policy.min_retry_seconds      = 300;
    policy.max_retry_seconds      = 3600;
    policy.max_attempts           = 3;
    policy.max_clock_skew_seconds = 300;
    var source: FixedRandom;
    source.value = 0;
    val random:   Random = Random{ctx: (?source)::ptr, next: fixed_random};
    var recorder: Recorder;
    recorder.count = 0;
    val observer: Observer = Observer{ctx: (?recorder)::ptr,
        on_transition: record};
    val key: view.View = view.view("issue.example.com", 17);

    # without advice, renewal lands a policy lead before expiry
    var schedule: Schedule;
    if (problem.failed(begin(?schedule, policy, key, issued, expires))) {
        ret 1;
    }
    if (problem.failed(plan(?schedule, renewal_info.empty_window(), random,
        issued, observer))) { ret 2; }
    if (schedule.state != SCHEDULED ||
        schedule.next_run_unix != expires - 30 * day) { ret 3; }

    # jitter spreads a fleet without ever passing expiry
    var spread_policy: Policy = policy;
    spread_policy.jitter_seconds = day;
    source.value                 = day - 1;
    var spread: Schedule;
    if (problem.failed(begin(?spread, spread_policy, key, issued, expires)) ||
        problem.failed(plan(?spread, renewal_info.empty_window(), random,
        issued, no_observer()))) { ret 4; }
    if (spread.next_run_unix != expires - 30 * day + day - 1 ||
        spread.next_run_unix >= expires) { ret 5; }
    source.value = 0;

    # the authority's window wins and is sampled uniformly inside it
    var advised: Schedule;
    var window:  renewal_info.Window = renewal_info.empty_window();
    window.present    = true;
    window.start_unix = issued + 10 * day;
    window.end_unix   = issued + 20 * day;
    source.value      = 5 * day;
    if (problem.failed(begin(?advised, policy, key, issued, expires)) ||
        problem.failed(plan(?advised, window, random, issued,
        no_observer()))) { ret 6; }
    if (advised.next_run_unix != issued + 15 * day) { ret 7; }

    # a window outside the certificate's own lifetime is clamped, never obeyed
    var wild: Schedule;
    window.start_unix = 1;
    window.end_unix   = expires + 100 * day;
    source.value      = 0;
    if (problem.failed(begin(?wild, policy, key, issued, expires)) ||
        problem.failed(plan(?wild, window, random, issued,
        no_observer()))) { ret 8; }
    if (wild.next_run_unix < issued || wild.next_run_unix > expires) { ret 9; }

    # an inverted window is ignored and the local policy stands
    var inverted: renewal_info.Window = window;
    inverted.start_unix = issued + 20 * day;
    inverted.end_unix   = issued + 10 * day;
    var ignored: Schedule;
    if (problem.failed(begin(?ignored, policy, key, issued, expires)) ||
        problem.failed(plan(?ignored, inverted, random, issued,
        no_observer()))) { ret 10; }
    if (ignored.next_run_unix != expires - 30 * day) { ret 11; }

    # an expiring certificate is due immediately
    var expiring: Schedule;
    if (problem.failed(begin(?expiring, policy, key, issued, expires)) ||
        problem.failed(plan(?expiring, renewal_info.empty_window(), random,
        expires - day, no_observer()))) { ret 12; }
    if (expiring.state != DUE ||
        !ready(?expiring, expires - day)) { ret 13; }

    # a prolonged outage retries within a ceiling and stops at the budget
    var outage: Schedule;
    var now:    u64 = expires - day;
    if (problem.failed(begin(?outage, policy, key, issued, expires)) ||
        problem.failed(plan(?outage, renewal_info.empty_window(), random, now,
        no_observer()))) { ret 14; }
    val cause: problem.Error = problem.local_code(problem.TRANSPORT,
        problem.INVALID_STATE, "authority unreachable");
    if (problem.failed(start(?outage, now, observer)) ||
        problem.failed(failed(?outage, cause, random, now, observer))) {
        ret 15;
    }
    if (outage.state != RETRYING || outage.next_run_unix != now + 300) {
        ret 16;
    }
    now = outage.next_run_unix;
    if (problem.failed(start(?outage, now, observer)) ||
        problem.failed(failed(?outage, cause, random, now, observer))) {
        ret 17;
    }
    if (outage.next_run_unix != now + 600) { ret 18; }
    now = outage.next_run_unix;
    if (problem.failed(start(?outage, now, observer)) ||
        problem.failed(failed(?outage, cause, random, now, observer))) {
        ret 19;
    }
    # the third failure exhausts the budget rather than scheduling a fourth
    if (outage.state != EXHAUSTED || outage.attempts != 3 ||
        outage.next_run_unix != 0 || ready(?outage, now + 1000000)) {
        ret 20;
    }
    if (!problem.failed(start(?outage, now, no_observer()))) { ret 21; }

    # every transition was observable, in order
    if (recorder.count != 7 || recorder.current[0] != SCHEDULED ||
        recorder.current[1] != RUNNING || recorder.current[2] != RETRYING ||
        recorder.current[5] != RUNNING ||
        recorder.current[6] != EXHAUSTED ||
        recorder.previous[6] != RUNNING) { ret 22; }

    # a clock that jumped backwards past the tolerated skew does not fire
    var skewed: Schedule;
    if (problem.failed(begin(?skewed, policy, key, issued, expires)) ||
        problem.failed(plan(?skewed, renewal_info.empty_window(), random,
        expires - day, no_observer()))) { ret 23; }
    if (!ready(?skewed, expires - day)) { ret 24; }
    if (!clock_moved_back(?skewed, expires - day - 400) ||
        ready(?skewed, expires - day - 400)) { ret 25; }
    # a jump inside the tolerance is not treated as a clock change
    if (clock_moved_back(?skewed, expires - day - 100) ||
        !ready(?skewed, expires - day - 100)) { ret 26; }

    # cancellation is observable and terminal
    var cancelled_schedule: Schedule;
    recorder.count = 0;
    if (problem.failed(begin(?cancelled_schedule, policy, key, issued,
        expires)) ||
        problem.failed(plan(?cancelled_schedule,
        renewal_info.empty_window(), random, issued, observer))) {
        ret 27;
    }
    if (!cancel(?cancelled_schedule, observer) ||
        cancelled_schedule.state != CANCELLED ||
        cancel(?cancelled_schedule, observer) ||
        ready(?cancelled_schedule, expires)) { ret 28; }
    if (recorder.count != 2 || recorder.current[1] != CANCELLED) { ret 29; }
    if (!problem.failed(plan(?cancelled_schedule,
        renewal_info.empty_window(), random, issued, no_observer()))) {
        ret 30;
    }

    # the certificate closest to expiry is selected first, and one that is
    # backing off is not selected before its delay elapses
    var fleet: [3]Schedule;
    if (problem.failed(begin(?fleet[0], policy, key, issued,
        issued + 60 * day)) ||
        problem.failed(begin(?fleet[1], policy, key, issued,
        issued + 40 * day)) ||
        problem.failed(begin(?fleet[2], policy, key, issued,
        issued + 80 * day))) { ret 31; }
    val fleet_now: u64   = issued + 30 * day;
    var i:         usize = 0;
    for (i < 3) {
        if (problem.failed(plan(?fleet[i], renewal_info.empty_window(),
            random, fleet_now, no_observer()))) { ret 32; }
        i = i + 1;
    }
    val urgent: *Schedule = select_next(?fleet[0], 3, fleet_now);
    if (urgent == nil || urgent.not_after_unix != issued + 40 * day) {
        ret 33;
    }
    if (problem.failed(start(urgent, fleet_now, no_observer())) ||
        problem.failed(failed(urgent, cause, random, fleet_now,
        no_observer()))) { ret 34; }
    # the urgent one is now backing off, so the next most urgent runs instead
    val second: *Schedule = select_next(?fleet[0], 3, fleet_now);
    if (second == nil || second.not_after_unix != issued + 60 * day) {
        ret 35;
    }
    # once its backoff elapses the urgent certificate regains priority
    val later: u64       = fleet_now + 301;
    val again: *Schedule = select_next(?fleet[0], 3, later);
    if (again == nil || again.not_after_unix != issued + 40 * day) { ret 36; }

    # a schedule replanned after a restart lands in the same place
    var restarted: Schedule;
    if (problem.failed(begin(?restarted, policy, key, issued, expires)) ||
        problem.failed(plan(?restarted, renewal_info.empty_window(), random,
        issued, no_observer()))) { ret 37; }
    if (restarted.next_run_unix != schedule.next_run_unix ||
        restarted.state != schedule.state) { ret 38; }

    var invalid: Policy = policy;
    invalid.min_retry_seconds = 0;
    if (!problem.failed(begin(?restarted, invalid, key, issued, expires)) ||
        !problem.failed(begin(?restarted, policy, key, expires, issued))) {
        ret 39;
    }
    ret 0;
}
